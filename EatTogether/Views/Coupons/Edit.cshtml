@model EatTogether.Models.ViewModels.CouponEditViewModel
@{
    ViewData["Title"] = "編輯優惠券";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">編輯優惠券</h1>

    <div class="row g-4" style="max-width: 800px;">

        <!-- 左：可編輯欄位 -->
        <div class="col-md-7">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-edit me-1"></i>修改優惠券資訊
                </div>
                <div class="card-body">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                活動名稱 <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="AddLimitCount" class="form-label">增加限量張數</label>
                            <div class="input-group">
                                <span class="input-group-text text-muted small">
                                    目前：@(Model.LimitCount.HasValue ? $"{Model.LimitCount} 張" : "無限量")
                                </span>
                                <input asp-for="AddLimitCount" type="number" min="1"
                                       class="form-control" placeholder="輸入要增加的數量" />
                            </div>
                            <span asp-validation-for="AddLimitCount" class="text-danger small"></span>
                            <div class="form-text">
                                留空不異動。已領取 <strong>@Model.ReceivedCount</strong> 張。
                                @if (Model.LimitCount.HasValue)
                                {
                                    <span>剩餘 <strong>@(Model.LimitCount - Model.ReceivedCount)</strong> 張可領。</span>
                                }
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="NewEndDate" class="form-label">修改結束日期</label>
                            <input asp-for="NewEndDate" type="date" class="form-control"
                                   value="@(Model.EndDate.HasValue? Model.EndDate.Value.ToString("yyyy-MM-dd") : "")" />
                            <div class="form-text">
                                目前：
                                @if (!Model.EndDate.HasValue)
                                {
                                    <span class="text-success">永久有效</span>
                                }
                                else
                                {
                                    <span>@Model.EndDate?.ToString("yyyy/M/d")</span>
                                }
                                。留空不異動。
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>儲存
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>返回列表
                            </a>
                        </div>
                    </form>

                    @* 停用 / 啟用（獨立 form，不與 Edit form 混用）*@
                    @if (Model.IsDisabled)
                    {
                        <form asp-action="Enable" asp-route-id="@Model.Id" method="post" class="mt-3"
                              onsubmit="return confirm('確定要重新啟用此優惠券？')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success w-100">
                                <i class="fas fa-toggle-on me-1"></i>重新啟用
                            </button>
                        </form>
                    }
                    else if (!Model.IsExpired && !Model.IsLimitHit)
                    {
                        <form asp-action="Disable" asp-route-id="@Model.Id" method="post" class="mt-3"
                              onsubmit="return confirm('確定要停用「@Model.Name」？停用後此券將無法使用。')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="fas fa-ban me-1"></i>停用此優惠券
                            </button>
                        </form>
                    }

                </div>
            </div>
        </div>

        <!-- 右：唯讀資訊 -->
        <div class="col-md-5">
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-info-circle me-1"></i>優惠券資訊
                </div>
                <div class="card-body">
                    <dl class="row mb-0 small">
                        <dt class="col-5 text-muted">折扣碼</dt>
                        <dd class="col-7"><code>@Model.Code</code></dd>

                        <dt class="col-5 text-muted">折扣內容</dt>
                        <dd class="col-7">@Model.DiscountDescription</dd>

                        <dt class="col-5 text-muted">有效期間</dt>
                        <dd class="col-7">
                            @if (!Model.EndDate.HasValue)
                            {
                                <span class="text-success">永久有效</span>
                            }
                            else
                            {
                                <span>@Model.StartDate.ToString("yyyy/M/d") ~<br />@Model.EndDate?.ToString("yyyy/M/d")</span>
                            }
                        </dd>

                        <dt class="col-5 text-muted">狀態</dt>
                        <dd class="col-7">
                            <span class="badge @Model.StatusBadgeClass">@Model.StatusText</span>
                            @if (Model.IsDisabled)
                            {
                                <div class="text-danger small mt-1">
                                    <i class="fas fa-ban me-1"></i>此券已被停用
                                </div>
                            }
                        </dd>

                        <dt class="col-5 text-muted">已領 / 限量</dt>
                        <dd class="col-7">
                            @Model.ReceivedCount /
                            @(Model.LimitCount.HasValue? Model.LimitCount.ToString() : "無限量")
                        </dd>
                    </dl>
                    <hr class="my-2" />
                    <div class="text-muted small">
                        <i class="fas fa-lock me-1"></i>
                        折扣碼、折扣內容不可修改。結束日期可往後延長。
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
