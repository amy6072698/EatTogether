@model EatTogether.Models.ViewModels.PaymentIndexViewModel

@{
    ViewData["Title"] = "結帳";
    var takeOrders = Model.TakeoutOrders;
    // TODO: 登入系統完成後，改成從 Session 或 ClaimsPrincipal 讀取
    // 有「訂單管理（含結帳）FunctionId=4」權限：店長、副店長、收銀員
    bool canCancelOrder = true; // 暫時以店長身份模擬
}

<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet" />

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Noto Sans TC', sans-serif;
        background: #f0f2f5;
    }

    .layout {
        display: grid;
        grid-template-columns: 800px 1fr;
        height: 100vh;
        overflow: hidden;
    }

    /* ── 左側 ── */
    .left-panel {
        background: #fff;
        border-right: 1px solid #e8e8e8;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .left-header {
        padding: 20px;
        border-bottom: 1px solid #f0f0f0;
    }

    .left-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 12px;
    }

    .tab-wrap {
        display: flex;
        gap: 8px;
    }

    .tab-btn {
        flex: 1;
        padding: 8px;
        border: 2px solid #ddd;
        border-radius: 10px;
        background: #fff;
        font-family: inherit;
        font-size: 0.88rem;
        font-weight: 500;
        color: #888;
        cursor: pointer;
        transition: all 0.15s;
        text-align: center;
    }

        .tab-btn.active {
            border-color: #c0392b;
            background: #fff5f5;
            color: #c0392b;
            font-weight: 700;
        }

    /* 桌號格子 */
    .table-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        padding: 16px;
        overflow: hidden; /* ← 改成 hidden */
        flex: 1;
        align-content: start; /* ← 格子靠上對齊，不會被撐開 */
    }

    .table-btn {
        /* aspect-ratio: 1; */
        height: 90px; /* ← 改成固定高度 */
        border-radius: 12px;
        border: 2px solid #e8e8e8;
        background: #fafafa;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 700;
        color: #aaa;
        transition: all 0.15s;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        cursor: default;
    }

        .table-btn.has-order {
            border-color: #2c3e50;
            background: #fff;
            color: #1a1a1a;
            cursor: pointer;
        }

            .table-btn.has-order:hover {
                border-color: #c0392b;
                background: #fff5f5;
            }

            .table-btn.has-order.unserved {
                border-color: #e67e22;
                background: #fef9f0;
            }

        .table-btn.active-selected {
            border-color: #c0392b !important;
            background: #fff5f5 !important;
            box-shadow: 0 0 0 3px rgba(192,57,43,0.15);
        }

    .table-icon {
        font-size: 1.4rem;
    }

    .table-name {
        font-size: 0.78rem;
    }

    .table-amount {
        font-size: 0.75rem;
        color: #c0392b;
        font-weight: 700;
    }

    /* 外帶清單 */
    .takeout-list {
        padding: 12px 16px;
        overflow-y: auto;
        flex: 1;
        display: none;
    }

    .takeout-item {
        padding: 12px 14px;
        border-radius: 12px;
        border: 2px solid #e8e8e8;
        background: #fff;
        margin-bottom: 10px;
        cursor: pointer;
        transition: all 0.15s;
    }

        .takeout-item:hover {
            border-color: #c0392b;
        }

        .takeout-item.active-selected {
            border-color: #c0392b;
            background: #fff5f5;
            box-shadow: 0 0 0 3px rgba(192,57,43,0.15);
        }

        .takeout-item.unserved {
            border-color: #e67e22;
            background: #fef9f0;
        }

    .takeout-number {
        font-weight: 700;
        font-size: 0.95rem;
        color: #1a1a1a;
    }

    .takeout-meta {
        font-size: 0.8rem;
        color: #888;
        margin-top: 3px;
    }

    .takeout-amount {
        font-size: 0.88rem;
        color: #c0392b;
        font-weight: 700;
        margin-top: 4px;
    }

    /* ── 右側 ── */
    .right-panel {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: #f8f9fa;
    }

    .right-header {
        padding: 20px 24px;
        background: #fff;
        border-bottom: 1px solid #e8e8e8;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .right-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #1a1a1a;
    }

    .right-subtitle {
        font-size: 0.85rem;
        color: #888;
        margin-top: 2px;
    }

    .unserved-warning {
        margin: 16px 24px 0;
        padding: 14px 18px;
        background: #fff8e1;
        border-left: 4px solid #f39c12;
        border-radius: 0 10px 10px 0;
        display: none;
    }

        .unserved-warning p {
            font-size: 0.92rem;
            color: #7d6608;
            font-weight: 500;
            margin-bottom: 10px;
        }

    .warning-btns {
        display: flex;
        gap: 10px;
    }

    .btn-yes {
        padding: 7px 20px;
        background: #e67e22;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-yes:hover {
            background: #d35400;
        }

    .btn-no {
        padding: 7px 20px;
        background: #fff;
        color: #555;
        border: 2px solid #ddd;
        border-radius: 8px;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-no:hover {
            border-color: #aaa;
        }

    .detail-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 16px 24px;
    }

    .detail-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

        .detail-table th {
            padding: 12px 16px;
            background: #f8f9fa;
            font-size: 0.82rem;
            color: #888;
            text-align: left;
            font-weight: 700;
            letter-spacing: 0.05em;
            border-bottom: 1px solid #f0f0f0;
        }

            .detail-table th:last-child {
                text-align: right;
            }

        .detail-table td {
            padding: 12px 16px;
            font-size: 0.92rem;
            color: #333;
            border-bottom: 1px solid #f8f8f8;
        }

            .detail-table td:last-child {
                text-align: right;
                font-weight: 700;
            }

        .detail-table tr:last-child td {
            border-bottom: none;
        }

        .detail-table tr.status-cancel td {
            background: #fdf2f2;
            color: #c0392b;
            opacity: 0.65;
            text-decoration: line-through;
        }

    .status-badge {
        font-size: 0.75rem;
        padding: 2px 8px;
        border-radius: 10px;
        font-weight: 700;
        display: inline-block;
        margin-left: 6px;
    }

    .badge-unserved {
        background: #fff3cd;
        color: #856404;
    }

    .badge-cancel {
        background: #f8d7da;
        color: #842029;
    }

    .amount-section {
        padding: 16px 24px;
        background: #fff;
        border-top: 1px solid #e8e8e8;
    }

    .amount-row {
        display: flex;
        justify-content: space-between;
        padding: 6px 0;
        font-size: 0.92rem;
        color: #555;
    }

        .amount-row.discount {
            color: #27ae60;
        }

        .amount-row.total {
            font-size: 1.3rem;
            font-weight: 700;
            color: #1a1a1a;
            border-top: 2px solid #eee;
            margin-top: 8px;
            padding-top: 12px;
        }

            .amount-row.total span:last-child {
                color: #c0392b;
            }

    .cash-section {
        display: none;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #f0f0f0;
    }

    .cash-label {
        font-size: 0.85rem;
        color: #888;
        margin-bottom: 6px;
    }

    .cash-input-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .cash-input {
        width: 140px;
        padding: 10px 14px;
        border: 2px solid #ddd;
        border-radius: 10px;
        font-size: 1rem;
        font-family: inherit;
        font-weight: 700;
        outline: none;
        transition: border-color 0.2s;
        text-align: right;
    }

        .cash-input:focus {
            border-color: #c0392b;
        }

    .change-display {
        font-size: 1rem;
        font-weight: 700;
        color: #27ae60;
    }

    .pay-method-btn {
        flex: 1;
        padding: 8px 4px;
        border: 2px solid #ddd;
        border-radius: 8px;
        background: #fff;
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 500;
        color: #888;
        cursor: pointer;
        transition: all 0.15s;
        text-align: center;
    }

        .pay-method-btn.active {
            border-color: #c0392b;
            background: #fff5f5;
            color: #c0392b;
            font-weight: 700;
        }

    .checkout-btn-wrap {
        margin-top: 14px;
    }

    .btn-checkout {
        width: 100%;
        padding: 16px;
        background: #c0392b;
        color: #fff;
        border: none;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        transition: background 0.2s;
        display: none;
    }

        .btn-checkout.show {
            display: block;
        }

        .btn-checkout:hover {
            background: #a93226;
        }

    .empty-right {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #ccc;
    }

        .empty-right .icon {
            font-size: 3rem;
            margin-bottom: 12px;
        }

        .empty-right p {
            font-size: 0.95rem;
        }

    .detail-table tr.status-billed td {
        opacity: 0.45;
        color: #27ae60;
    }

    .badge-billed {
        background: #d1f5e0;
        color: #1a6b3a;
    }

    /* ── 套餐 / 子項目行 ── */
    .detail-table tr.is-setmeal-row td {
        background: #fff4e6;
        font-weight: 700;
    }

    .detail-table tr.is-setmeal-row td:first-child {
        border-left: 4px solid #e67e22;
    }

    .detail-table tr.child-item-row td {
        background: #fffbf5;
        color: #999;
        font-size: 0.88rem;
        border-bottom: 1px solid #fdebd0;
    }

    .detail-table tr.child-item-row td:first-child {
        border-left: 4px solid #f0c080;
    }

    .detail-table tr.child-item-row.status-cancel td {
        background: #fdf5f5;
        color: #bbb;
        text-decoration: line-through;
        border-left-color: #f5c6cb;
    }

    .badge-setmeal {
        background: #e67e22;
        color: #fff;
    }

    /* ── Custom Confirm Modal ── */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: 20px;
        padding: 36px 32px 28px;
        width: 320px;
        max-width: 90vw;
        box-shadow: 0 16px 48px rgba(0,0,0,0.25);
        font-family: 'Noto Sans TC', sans-serif;
        text-align: center;
        animation: modalIn 0.2s cubic-bezier(0.34,1.56,0.64,1);
    }

    @@keyframes modalIn {
        from {
            transform: scale(0.85);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .modal-warning-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto 18px;
    }

    .modal-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 8px;
        line-height: 1.5;
    }

    .modal-body {
        font-size: 0.88rem;
        color: #777;
        margin-bottom: 24px;
        line-height: 1.6;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .modal-btn-cancel {
        flex: 1;
        padding: 11px 0;
        border: 2px solid #ddd;
        border-radius: 10px;
        background: #fff;
        color: #555;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.92rem;
        cursor: pointer;
        transition: all 0.15s;
    }

        .modal-btn-cancel:hover {
            border-color: #aaa;
            background: #f8f8f8;
        }

    .modal-btn-confirm {
        flex: 1;
        padding: 11px 0;
        border: none;
        border-radius: 10px;
        background: #c0392b;
        color: #fff;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.92rem;
        cursor: pointer;
        transition: background 0.2s;
    }

        .modal-btn-confirm:hover {
            background: #a93226;
        }
</style>

<!-- Edit Order Modal (換桌／內外帶) -->
<div class="modal-overlay" id="editOrderModal">
    <div class="modal-box" style="width:380px;">
        <div class="modal-title">✏️ 修改訂單資訊</div>
        <div style="margin-bottom:20px;">
            <div style="font-size:0.8rem;font-weight:700;color:#bbb;letter-spacing:0.06em;margin-bottom:8px;">用餐方式</div>
            <div style="display:flex;gap:8px;">
                <button id="editBtnDine" onclick="setEditMode(true)"
                        style="flex:1;padding:9px;border:2px solid #2c3e50;border-radius:8px;
                               background:#eaf0fb;color:#2c3e50;font-family:inherit;
                               font-weight:700;font-size:0.88rem;cursor:pointer;">
                    🪑 內用
                </button>
                <button id="editBtnTakeout" onclick="setEditMode(false)"
                        style="flex:1;padding:9px;border:2px solid #ddd;border-radius:8px;
                               background:#fff;color:#888;font-family:inherit;
                               font-weight:700;font-size:0.88rem;cursor:pointer;">
                    🥡 外帶
                </button>
            </div>
        </div>
        <div id="editTableSection" style="margin-bottom:20px;">
            <div style="font-size:0.8rem;font-weight:700;color:#bbb;letter-spacing:0.06em;margin-bottom:8px;">桌位</div>
            <select id="editTableSelect"
                    style="width:100%;padding:10px 12px;border:2px solid #ddd;border-radius:8px;
                           font-family:inherit;font-size:0.92rem;outline:none;
                           background:#fff;cursor:pointer;">
                <option value="">載入中...</option>
            </select>
        </div>
        <div class="modal-actions">
            <button class="modal-btn-cancel" onclick="document.getElementById('editOrderModal').classList.remove('show')">取消</button>
            <button class="modal-btn-confirm" onclick="submitEditOrder()">確認修改</button>
        </div>
    </div>
</div>
<div class="modal-overlay" id="customConfirmModal">
    <div class="modal-box">
        <svg class="modal-warning-icon" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M28 4L52 48H4L28 4Z" fill="#f39c12" stroke="#e67e22" stroke-width="2" stroke-linejoin="round" />
            <rect x="26" y="20" width="4" height="14" rx="2" fill="#fff" />
            <rect x="26" y="37" width="4" height="4" rx="2" fill="#fff" />
        </svg>
        <div class="modal-title" id="modalTitle">確認操作</div>
        <div class="modal-body" id="modalBody"></div>
        <div class="modal-actions">
            <button class="modal-btn-cancel" id="modalCancelBtn">返回</button>
            <button class="modal-btn-confirm" id="modalConfirmBtn">確認</button>
        </div>
    </div>
</div>

<!-- Alert Modal (單一確定) -->
<div class="modal-overlay" id="customAlertModal">
    <div class="modal-box">
        <svg class="modal-warning-icon" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M28 4L52 48H4L28 4Z" fill="#f39c12" stroke="#e67e22" stroke-width="2" stroke-linejoin="round" />
            <rect x="26" y="20" width="4" height="14" rx="2" fill="#fff" />
            <rect x="26" y="37" width="4" height="4" rx="2" fill="#fff" />
        </svg>
        <div class="modal-title" id="alertTitle">提示</div>
        <div class="modal-body" id="alertBody"></div>
        <div class="modal-actions">
            <button class="modal-btn-confirm" style="flex:unset; padding:11px 40px;"
                    onclick="document.getElementById('customAlertModal').classList.remove('show')">
                確定
            </button>
        </div>
    </div>
</div>

<div class="layout">

    <!-- ── 左側 ── -->
    <div class="left-panel">
        <div class="left-header">
            <div class="left-title">💳 結帳</div>
            <div class="tab-wrap">
                <button class="tab-btn active" onclick="switchTab('dine')">🪑 內用</button>
                <button class="tab-btn" onclick="switchTab('take')">🥡 外帶</button>
            </div>
        </div>

        <!-- 內用：桌號格子 -->
        <div class="table-grid" id="dineGrid">
            @foreach (var table in Model.Tables)
            {
                if (table.HasOrder)
                {
                    <button class="table-btn has-order @(table.HasUnserved ? "unserved" : "")"
                            id="tbtn-@table.PreOrderId"
                            data-table-id="@table.TableId"
                            onclick="loadDetail(@table.PreOrderId, this)">
                        <span class="table-icon">🪑</span>
                        <span class="table-name">@table.TableName</span>
                        <span class="table-amount">$@table.TotalAmount</span>
                    </button>
                }
                else
                {
                    <div class="table-btn @(table.IsOccupied ? "occupied" : "")" data-tableid="@table.TableId" onclick="selectTable(@table.TableId)">
                        <span class="table-icon" style="opacity:@(table.IsOccupied ? "1" : "0.3")">🪑</span>
                        <span class="table-name" style="color:@(table.IsOccupied ? "#e67e22" : "#ccc")">@table.TableName</span>
                        @if (table.IsOccupied)
                        {
                            <span class="table-amount" style="color:#e67e22">點餐中</span>
                        }
                    </div>
                }
            }
        </div>

        <!-- 外帶：清單 -->
        <div class="takeout-list" id="takeList">
            @foreach (var order in takeOrders)
            {
                <div class="takeout-item @(order.HasUnserved ? "unserved" : "")"
                     id="tbtn-@order.PreOrderId"
                     onclick="loadDetail(@order.PreOrderId, this)">
                    <div class="takeout-number">@order.OrderNumber</div>
                    <div class="takeout-meta">@order.OrderAt.ToString("HH:mm")</div>
                    <div class="takeout-amount">NT$ @order.TotalAmount</div>
                </div>
            }
            @if (!takeOrders.Any())
            {
                <div style="text-align:center;color:#ccc;padding:40px 0;font-size:0.9rem">
                    目前沒有外帶訂單
                </div>
            }
        </div>
    </div>

    <!-- ── 右側 ── -->
    <div class="right-panel">

        <div class="empty-right" id="emptyRight">
            <div class="icon" id="emptyRightIcon">👈</div>
            <p id="emptyRightText">請選擇訂單</p>
        </div>

        <div id="checkoutContent" style="display:none;flex-direction:column;height:100%;">

            <div class="right-header">
                <div>
                    <div class="right-title" id="rightTitle">-</div>
                    <div style="display:flex;align-items:center;gap:8px;">
                        <div class="right-subtitle" id="rightSubtitle">-</div>
                        <button type="button" id="editTableBtn" onclick="openEditOrderModal()"
                                style="padding:3px 10px;border:1px solid #1a77c9;border-radius:6px;
                                       background:#fff;color:#1a77c9;font-family:inherit;
                                       font-weight:600;font-size:0.75rem;cursor:pointer;
                                       transition:all 0.15s;"
                                onmouseover="this.style.background='#eaf0fb'"
                                onmouseout="this.style.background='#fff'">
                            ✏️ 更換桌位
                        </button>
                    </div>
                </div>
                <div style="display:flex;gap:8px;align-items:center;">
                    @if (canCancelOrder)
                    {
                        <button type="button" id="cancelOrderBtn"
                                style="padding:7px 16px;border:2px solid #c0392b;border-radius:8px;
                                           background:#fff;color:#c0392b;font-family:inherit;
                                           font-weight:700;font-size:0.85rem;cursor:pointer;display:none;"
                                onclick="cancelEntireOrder()">
                            ✕ 整單取消
                        </button>
                    }
                    <button type="button" id="splitModeBtn"
                            style="padding:7px 16px;border:2px solid #1a77c9;border-radius:8px;
                       background:#fff;color:#1a77c9;font-family:inherit;
                       font-weight:700;font-size:0.85rem;cursor:pointer;"
                            onclick="toggleSplitMode()">
                        拆單結帳
                    </button>
                </div>
            </div>

            <div class="unserved-warning" id="unservedWarning">
                <p>⚠️ 有餐點尚未出餐完成，確定要結帳嗎？</p>
                <div class="warning-btns">
                    <button class="btn-yes" id="confirmCancelBtn" onclick="confirmCancelUnserved()">是，取消未出餐並結帳</button>
                    <button class="btn-no" onclick="closeDetail()">否，關閉</button>
                </div>
            </div>

            <div class="detail-scroll">
                <table class="detail-table">
                    <thead>
                        <tr>
                            <th id="splitCheckCol" style="display:none;width:36px;">
                                <input type="checkbox" id="checkAll" onchange="toggleAll(this)">
                            </th>
                            <th>餐點名稱</th>
                            <th>結帳份數</th>
                            <th>單價</th>
                            <th>金額</th>
                        </tr>
                    </thead>
                    <tbody id="detailBody"></tbody>
                </table>
            </div>

            <div class="amount-section">
                <div id="splitBillSection" style="display:none; margin-bottom:12px;
                        padding:12px 14px; background:#f0f7ff; border:1px solid #b3d4f5;
                        border-radius:10px;">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                        <span style="font-size:0.85rem;color:#1a5c99;font-weight:700;">
                            已選小計：NT$ <span id="splitSubtotal">0</span>
                        </span>
                        <button type="button"
                                style="padding:6px 16px;background:#1a77c9;color:#fff;border:none;
                       border-radius:8px;font-family:inherit;font-weight:700;
                       font-size:0.85rem;cursor:pointer;"
                                onclick="doSplitCheckout()">
                            結這張 ✓
                        </button>
                    </div>
                </div>
                <div id="couponTag" style="display:none; margin-bottom:14px; padding:10px 14px;
                                background:#fff8e1; border:1px solid #f0c040;
                                border-radius:10px;">
                    <div style="font-size:0.75rem;color:#b7770d;font-weight:700;margin-bottom:4px;">優惠券</div>
                    <div style="display:flex;align-items:center;gap:6px;font-size:0.9rem;font-weight:600;color:#b7770d;">
                        🎫 <span id="couponTagName"></span>
                    </div>
                </div>
                <div class="amount-row">
                    <span>總計</span>
                    <span>NT$ <span id="amtOriginal">-</span></span>
                </div>
                <div class="amount-row discount">
                    <span>折扣</span>
                    <span>− NT$ <span id="amtDiscount">-</span></span>
                </div>
                <div class="amount-row total">
                    <span>應付</span>
                    <span>NT$ <span id="amtTotal">-</span></span>
                </div>
                <div style="margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid #f0f0f0;">
                    <div style="font-size:0.82rem;color:#888;margin-bottom:8px;">付款方式</div>
                    <div style="display:flex;gap:8px;">
                        <button type="button" class="pay-method-btn" id="pmBtn-Cash" onclick="selectPayMethod('Cash')">💵 現金</button>
                        <button type="button" class="pay-method-btn" id="pmBtn-Card" onclick="selectPayMethod('Card')">💳 刷卡</button>
                        <button type="button" class="pay-method-btn" id="pmBtn-Other" onclick="selectPayMethod('Other')">📱 行動支付</button>
                    </div>
                </div>

                <div class="cash-section" id="cashSection">
                    <div class="cash-label">實收金額</div>
                    <div class="cash-input-wrap">
                        <input type="number" class="cash-input" id="cashInput"
                               placeholder="0" oninput="calcChange()" />
                        <span style="color:#888;font-size:0.9rem">找零：</span>
                        <span class="change-display" id="changeDisplay">-</span>
                    </div>
                </div>

                <div class="checkout-btn-wrap">
                    <form id="checkoutForm" method="post" action="/Payments/CheckoutByTable">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="tableId" id="checkoutTableId" value="" />
                        <button type="submit" class="btn-checkout" id="checkoutBtn">
                            結帳 ✓
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.ShowSuccess == true) @* TempData["Success"] != null *@
{
    <div id="toast" style="
                            position:fixed; inset:0;
                            background:rgba(0,0,0,0.35);
                            display:flex; align-items:center; justify-content:center;
                            z-index:9999;">
        <div style="
                                background:#fff; border-radius:20px;
                                padding:40px 60px; text-align:center;
                                box-shadow:0 8px 32px rgba(0,0,0,0.2);">
            <div style="font-size:3rem; margin-bottom:12px;">✅</div>
            <div style="font-size:1.4rem; font-weight:700; color:#1a1a1a;">結帳成功！</div>
        </div>
    </div>
    <script>
        setTimeout(() => {
            const t = document.getElementById('toast');
            t.style.transition = 'opacity 0.4s';
            t.style.opacity = '0';
            setTimeout(() => t.remove(), 300);
        }, 600);
        history.replaceState({}, '', '/Payments/Create');
    </script>
}

<script>
        let currentPreOrderId = null;
    let currentPayMethod  = null;
    let currentTotal      = 0;
    let currentTableId    = null;

    function switchTab(tab) {
        const isDine = tab === 'dine';
        document.querySelectorAll('.tab-btn').forEach((b, i) =>
            b.classList.toggle('active', isDine ? i === 0 : i === 1));
        document.getElementById('dineGrid').style.display = isDine ? 'grid' : 'none';
        document.getElementById('takeList').style.display = isDine ? 'none' : 'block';
    }

    async function loadDetail(preOrderId, el) {
        const tableId = el?.dataset?.tableId;
        const url = tableId
            ? `/Payments/GetDetailByTable?tableId=${tableId}`
            : `/Payments/GetDetail?preOrderId=${preOrderId}`;

        const res  = await fetch(url);
        const data = await res.json();

        // 記錄當前 tableId 或 preOrderId
        currentPreOrderId = preOrderId;
        currentTableId    = tableId ? parseInt(tableId) : null;

        // 高亮選中
        document.querySelectorAll('.table-btn, .takeout-item')
                .forEach(b => b.classList.remove('active-selected'));
        el?.classList.add('active-selected');

        renderDetail(data);
    }

        function renderDetail(data) {
        // 1. 基礎防錯檢查：確保後端回傳的是有效物件
        if (!data || typeof data !== 'object') {
            console.error("後端未回傳有效的訂單資料", data);
            showAlert("資料讀取異常，請重新整理頁面。", '❌ 錯誤');
            return;
        }

        // 2. 切換右側顯示狀態（隱藏空狀態，顯示結帳內容）
        document.getElementById('emptyRight').style.display = 'none';
        document.getElementById('checkoutContent').style.display = 'flex';

        // 3. 設定標題與副標題 (桌號/外帶、訂單編號)
        document.getElementById('rightTitle').textContent =
            data.inOrOut ? `🪑 ${data.tableName || ''}` : `🥡 外帶`;
        document.getElementById('rightSubtitle').textContent = data.orderNumber || '-';

        // 4. 判斷是否「整單都沒有已出餐餐點」（排除子項目，以父項目/套餐標題為單位）
        const hasServedItems = data.items && data.items
            .filter(i => !i.parentDetailId)
            .some(item => item.status !== 0 && item.status !== 2 && item.isBilled !== true);

        const warningArea = document.getElementById('unservedWarning');
        const warningText = warningArea.querySelector('p');
        const confirmBtn = warningArea.querySelector('.btn-yes');
        const checkoutBtn = document.getElementById('checkoutBtn');
        const cancelOrderBtn = document.getElementById('cancelOrderBtn');

        // 5. 處理「未出餐警告區塊」與「結帳按鈕」的顯示邏輯
        if (data.hasUnserved) {
            warningArea.style.display = 'block';
            checkoutBtn.classList.remove('show'); // 有未出餐時，隱藏正式結帳鈕

            if (!hasServedItems) {
                // 情況 A：整單都沒有已出餐的餐點 → 隱藏 header 整單取消（unservedWarning 已有）
                warningText.textContent = "⚠️ 此訂單所有餐點皆尚未出餐，確定要整單取消嗎？";
                confirmBtn.textContent = "是，整單取消";
                if (cancelOrderBtn) cancelOrderBtn.style.display = 'none';
            } else {
                // 情況 B：部分已出餐，部分未出餐 → 顯示 header 整單取消
                warningText.textContent = "⚠️ 有餐點尚未出餐完成，確定要結帳嗎？";
                confirmBtn.textContent = "是，取消未出餐並結帳";
                if (cancelOrderBtn) cancelOrderBtn.style.display = '';
            }
        } else {
            warningArea.style.display = 'none';
            checkoutBtn.classList.add('show'); // 全部出餐完畢，顯示正式結帳鈕
            // 全部出餐完畢仍可整單取消（例如客人反悔）
            if (cancelOrderBtn) cancelOrderBtn.style.display = '';
        }

        // 5b. 依據餐點完成狀態控制 整單取消/更換桌位/拆單結帳 的顯示
        const topLevelItems = data.items ? data.items.filter(i => !i.parentDetailId) : [];
        const allCompleted = topLevelItems.length > 0 &&
            topLevelItems.every(item => item.status === 1 || item.status === 2);

        const editTableBtn = document.getElementById('editTableBtn');
        if (allCompleted) {
            // 全部完成(完成或取消) → 隱藏整單取消和更換桌位
            if (cancelOrderBtn) cancelOrderBtn.style.display = 'none';
            if (editTableBtn) editTableBtn.style.display = 'none';
        } else {
            // 尚有未完成餐點 → 整單取消和更換桌位都要顯示
            if (cancelOrderBtn) cancelOrderBtn.style.display = '';
            if (editTableBtn) editTableBtn.style.display = '';
        }

        const splitModeBtn = document.getElementById('splitModeBtn');
        if (splitModeBtn) {
            // 有待處理餐點時隱藏拆單結帳
            splitModeBtn.style.display = data.hasUnserved ? 'none' : '';
        }

        // 6. 渲染餐點明細表格
        const tbody = document.getElementById('detailBody');
        tbody.innerHTML = '';

        // 排序邏輯（只對父項目排序）：未出餐(0) -> 已出餐(1) -> 已結帳(2) -> 已取消(3)
        const sortOrder = item => {
            if (item.status === 2) return 3;
            if (item.isBilled === true) return 2;
            if (item.status === 0) return 0;
            return 1;
        };

        // 分離父項目（一般餐點 + 套餐標題）與子項目
        const parentItems = data.items.filter(i => !i.parentDetailId);
        const sortedParents = [...parentItems].sort((a, b) => sortOrder(a) - sortOrder(b));

        sortedParents.forEach(item => {
            const isCancelled = item.status === 2;
            const isUnserved  = item.status === 0;
            const isBilled    = item.isBilled === true;
            const isSetMeal   = item.isSetMeal === true;

            const tr = document.createElement('tr');
            if (isCancelled) tr.classList.add('status-cancel');
            if (isBilled)    tr.classList.add('status-billed');
            if (isSetMeal)   tr.classList.add('is-setmeal-row');

            let badge = '';
            if (isSetMeal)   badge += `<span class="status-badge badge-setmeal">套餐</span>`;
            if (isUnserved)  badge += `<span class="status-badge badge-unserved">未出餐</span>`;
            if (isCancelled) badge += `<span class="status-badge badge-cancel">已取消</span>`;

            // 拆單 checkbox：套餐標題可勾選（代表整份套餐），子項目不顯示
            const showCheck = !isCancelled && !isUnserved && !isBilled;
            tr.innerHTML = `
                <td class="split-check-col" style="display:none;">
                    ${showCheck ? `<input type="checkbox" class="detail-check"
                        data-detail-id="${item.detailId}"
                        data-subtotal="${item.subTotal}"
                        data-is-setmeal="${isSetMeal}"
                        onchange="updateSplitTotal()">` : ''}
                </td>
                <td>${item.productName}${badge}</td>
                <td>${item.qty}</td>
                <td>NT$ ${item.unitPrice.toLocaleString()}</td>
                <td>NT$ ${item.subTotal.toLocaleString()}</td>
            `;
            tbody.appendChild(tr);

            // 若為套餐，在其下方顯示子項目（縮排）
            if (isSetMeal) {
                const children = data.items.filter(c => c.parentDetailId === item.detailId);
                children.forEach(child => {
                    const childCancelled = child.status === 2;
                    const childTr = document.createElement('tr');
                    childTr.classList.add('child-item-row');
                    if (childCancelled) childTr.classList.add('status-cancel');
                    // 儲存 parentDetailId 供拆單使用
                    childTr.dataset.parentId = item.detailId;
                    childTr.dataset.detailId = child.detailId;
                    childTr.innerHTML = `
                        <td class="split-check-col" style="display:none;"></td>
                        <td style="padding-left:28px;">
                            <span style="color:#e67e22;margin-right:4px;">└</span>${child.productName}
                        </td>
                        <td>${child.qty}</td>
                        <td style="color:#ccc;">—</td>
                        <td style="color:#ccc;">—</td>
                    `;
                    tbody.appendChild(childTr);
                });
            }
        });

        // 7. 更新金額資訊
        document.getElementById('amtOriginal').textContent = data.originalAmount.toLocaleString();
        document.getElementById('amtDiscount').textContent = data.discountAmount.toLocaleString();
        document.getElementById('amtTotal').textContent    = data.totalAmount.toLocaleString();

        // 8. 優惠券標籤顯示
        const couponTag  = document.getElementById('couponTag');
        const couponName = document.getElementById('couponTagName');
        if (data.couponName) {
            couponName.textContent  = data.couponName;
            couponTag.style.display = 'block';
        } else {
            couponTag.style.display = 'none';
        }

        // 9. 更新全域變數與付款狀態
        currentTotal     = data.totalAmount;
        currentPayMethod = data.payMethod;

        selectPayMethod(data.payMethod);
        document.getElementById('cashInput').value = '';
        document.getElementById('changeDisplay').textContent = '-';

        // 10. 設定 Hidden Input 給 Form 使用
        const checkoutTableIdInput = document.getElementById('checkoutTableId');
        if (currentTableId) {
            document.getElementById('checkoutForm').action = '/Payments/CheckoutByTable';
            checkoutTableIdInput.name = 'tableId';
            checkoutTableIdInput.value = currentTableId;
        } else {
            document.getElementById('checkoutForm').action = '/Payments/Checkout';
            checkoutTableIdInput.name = 'preOrderId';
            checkoutTableIdInput.value = data.preOrderId;
        }
    }

    // ── 修改訂單桌位／內外帶 ──
    let editIsInOrOut = true;
    let editOriginalTableId = null;

    async function openEditOrderModal() {
        // 初始化目前狀態
        editIsInOrOut      = !!currentTableId; // 有 tableId 就是內用
        editOriginalTableId = currentTableId;
        setEditMode(editIsInOrOut);

        // 載入空桌清單
        const select = document.getElementById('editTableSelect');
        select.innerHTML = '<option value="">載入中...</option>';
        try {
            const res  = await fetch('/Payments/AvailableTables');
            const data = await res.json();

            select.innerHTML = '';
            // 若目前是內用，先加回目前桌位（保持不換）
            if (currentTableId) {
                const currentTableName = document.getElementById('rightTitle').textContent.replace('🪑 ', '');
                select.innerHTML += `<option value="${currentTableId}">${currentTableName}（目前）</option>`;
            }
            if (data.length === 0 && !currentTableId) {
                select.innerHTML = '<option value="">目前沒有空桌</option>';
            } else {
                data.forEach(t => {
                    select.innerHTML += `<option value="${t.tableId}">${t.tableName}</option>`;
                });
            }
        } catch {
            select.innerHTML = '<option value="">載入失敗，請重試</option>';
        }

        document.getElementById('editOrderModal').classList.add('show');
    }

    function setEditMode(isDine) {
        editIsInOrOut = isDine;
        const dineBtn    = document.getElementById('editBtnDine');
        const takeoutBtn = document.getElementById('editBtnTakeout');
        const tableSection = document.getElementById('editTableSection');

        dineBtn.style.border    = isDine ? '2px solid #2c3e50' : '2px solid #ddd';
        dineBtn.style.background = isDine ? '#eaf0fb' : '#fff';
        dineBtn.style.color      = isDine ? '#2c3e50' : '#888';
        takeoutBtn.style.border    = !isDine ? '2px solid #7f8c8d' : '2px solid #ddd';
        takeoutBtn.style.background = !isDine ? '#f0f0f0' : '#fff';
        takeoutBtn.style.color      = !isDine ? '#555' : '#888';
        tableSection.style.display  = isDine ? '' : 'none';
    }

    async function submitEditOrder() {
        const tableId = editIsInOrOut
            ? parseInt(document.getElementById('editTableSelect').value) || null
            : null;

        if (editIsInOrOut && !tableId) {
            showAlert('請選擇桌位', '⚠️ 提示');
            return;
        }

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const res = await fetch('/Payments/UpdateOrderTable', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `preOrderId=${currentPreOrderId}&tableId=${tableId ?? ''}&inOrOut=${editIsInOrOut}`
            });
            if (!res.ok) throw new Error();
            const data = await res.json();

            document.getElementById('editOrderModal').classList.remove('show');

            // 先取舊桌資訊（renderDetail 之前讀取）
            const orderBtn = document.getElementById('tbtn-' + currentPreOrderId);
            const oldTableId = editOriginalTableId;
            const oldTableName = orderBtn?.querySelector('.table-name')?.textContent || '';

            // 更新右側 header 顯示
            currentTableId = tableId;
            renderDetail(data);

            // 更新左側桌位格子
            const wasDineIn = !!oldTableId;
            const nowDineIn = !!tableId;

            if (wasDineIn && nowDineIn && tableId !== oldTableId) {
                // 內用換桌：將訂單按鈕移到新桌位，舊桌位還原為空桌
                orderBtn.dataset.tableId = tableId;
                const nameSpan = orderBtn.querySelector('.table-name');
                if (nameSpan) nameSpan.textContent = data.tableName || '';

                const newTableDiv = document.querySelector(`[data-tableid="${tableId}"]`);
                if (newTableDiv) {
                    const orderBtnNext  = orderBtn.nextSibling;
                    const newTableDivNext = newTableDiv.nextSibling;
                    const grid = orderBtn.parentNode;

                    if (newTableDivNext) grid.insertBefore(orderBtn, newTableDivNext);
                    else grid.appendChild(orderBtn);

                    newTableDiv.dataset.tableid = oldTableId;
                    newTableDiv.setAttribute('onclick', `selectTable(${oldTableId})`);
                    const oldNameSpan = newTableDiv.querySelector('.table-name');
                    if (oldNameSpan) oldNameSpan.textContent = oldTableName;

                    if (orderBtnNext) grid.insertBefore(newTableDiv, orderBtnNext);
                    else grid.appendChild(newTableDiv);
                }
            } else if (wasDineIn !== nowDineIn) {
                // 內用↔外帶切換：DOM 結構差異大，整頁重載
                window.location.href = '/Payments/Create';
            }
            // 同桌位不換：不需更新左側
        } catch {
            showAlert('修改失敗，請重試。', '❌ 錯誤');
        }
    }

    // ── 自訂 alert 對話框 ──
    function showAlert(message, title = '提示') {
        document.getElementById('alertTitle').textContent = title;
        document.getElementById('alertBody').textContent  = message;
        const overlay = document.getElementById('customAlertModal');
        overlay.classList.add('show');
        overlay.addEventListener('click', e => {
            if (e.target === overlay) overlay.classList.remove('show');
        }, { once: true });
    }

    // ── 自訂 confirm 對話框 ──
    function showConfirm(message, onConfirm, title = '確認操作', confirmLabel = '確認', cancelLabel = '返回') {
        document.getElementById('modalTitle').textContent = title;
        const bodyEl = document.getElementById('modalBody');
        bodyEl.textContent  = message;
        bodyEl.style.display = message ? '' : 'none';
        const overlay     = document.getElementById('customConfirmModal');
        const confirmBtn  = document.getElementById('modalConfirmBtn');
        const cancelBtn   = document.getElementById('modalCancelBtn');
        overlay.classList.add('show');
        // 移除舊的 listener
        const newConfirm = confirmBtn.cloneNode(true);
        const newCancel  = cancelBtn.cloneNode(true);
        newConfirm.textContent = confirmLabel;
        newCancel.textContent  = cancelLabel;
        confirmBtn.replaceWith(newConfirm);
        cancelBtn.replaceWith(newCancel);
        newConfirm.addEventListener('click', () => {
            overlay.classList.remove('show');
            onConfirm();
        });
        newCancel.addEventListener('click', () => overlay.classList.remove('show'));
        overlay.addEventListener('click', e => {
            if (e.target === overlay) overlay.classList.remove('show');
        }, { once: true });
    }

    async function confirmCancelUnserved() {
        const confirmBtn = document.querySelector('.btn-yes');
        const actionText = confirmBtn.textContent;

        const isFullCancel = actionText === '是，整單取消';
        const title   = isFullCancel ? '確定要整單取消嗎？' : '確定要取消未出餐並結帳嗎？';
        const message = isFullCancel ? '所有餐點都會取消，此操作無法復原。' : '未出餐的餐點將會取消，已完成的餐點會正常結帳。';
        const label   = isFullCancel ? '整單取消' : '確認';

        showConfirm(message, () => _doCancelUnserved(actionText), title, label, '返回');
    }

    async function _doCancelUnserved(actionText) {
        const isFullCancel = actionText === "是，整單取消";

        // 整單取消：內用 → CancelAllByTable（取消整桌所有訂單）；外帶 → CancelOrder（取消單筆）
        // 取消未出餐並結帳 → /Payments/CancelUnservedByTable 或 /Payments/CancelUnserved
        const url  = isFullCancel
            ? (currentTableId ? '/PreOrders/CancelAllByTable' : '/PreOrders/CancelOrder')
            : (currentTableId ? '/Payments/CancelUnservedByTable' : '/Payments/CancelUnserved');
        const body = isFullCancel
            ? (currentTableId ? `tableId=${currentTableId}` : `preOrderId=${currentPreOrderId}`)
            : (currentTableId ? `tableId=${currentTableId}` : `preOrderId=${currentPreOrderId}`);

        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body
            });

            if (!res.ok) throw new Error("伺服器回應錯誤");

            const data = await res.json();

            if (isFullCancel) {
                const tbody = document.getElementById('detailBody');
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" style="text-align:center; padding:40px; color:#27ae60; font-size:1.1rem; font-weight:700; background-color:#f4fdf7;">
                            ✅ 訂單已整單取消成功
                        </td>
                    </tr>`;
                document.getElementById('amtOriginal').textContent = '-';
                document.getElementById('amtDiscount').textContent = '-';
                document.getElementById('amtTotal').textContent = '-';
                document.getElementById('unservedWarning').style.display = 'none';
                document.getElementById('checkoutBtn').classList.remove('show');
                document.getElementById('couponTag').style.display = 'none';
                setTimeout(() => window.location.href = "/Payments/Create", 1500);
            } else {
                // 取消未出餐並結帳，正常重新渲染明細
                renderDetail(data);
            }
        } catch (err) {
            console.error(err);
            showAlert("執行失敗，請檢查網路連線。", '❌ 錯誤');
        }
    }

    function cancelEntireOrder() {
        showConfirm(
            '所有餐點（包含已完成）都會取消，此操作無法復原。',
            async () => {
                try {
                    // 內用：取消整桌所有訂單；外帶：取消單筆
                    const url  = currentTableId ? '/PreOrders/CancelAllByTable' : '/PreOrders/CancelOrder';
                    const body = currentTableId ? `tableId=${currentTableId}` : `preOrderId=${currentPreOrderId}`;
                    const res = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body
                    });
                    if (!res.ok) throw new Error();
                    const data = await res.json();
                    if (!data.success) throw new Error();

                    const tbody = document.getElementById('detailBody');
                    tbody.innerHTML = `
                        <tr><td colspan="5" style="text-align:center;padding:40px;color:#27ae60;
                            font-size:1.1rem;font-weight:700;background:#f4fdf7;">
                            ✅ 訂單已整單取消成功
                        </td></tr>`;
                    document.getElementById('amtOriginal').textContent = '-';
                    document.getElementById('amtDiscount').textContent = '-';
                    document.getElementById('amtTotal').textContent    = '-';
                    document.getElementById('unservedWarning').style.display = 'none';
                    document.getElementById('checkoutBtn').classList.remove('show');
                    document.getElementById('couponTag').style.display = 'none';
                    const cancelOrderBtn = document.getElementById('cancelOrderBtn');
                    if (cancelOrderBtn) cancelOrderBtn.style.display = 'none';
                    setTimeout(() => window.location.href = "/Payments/Create", 1500);
                } catch {
                    showAlert('執行失敗，請檢查網路連線。', '❌ 錯誤');
                }
            },
            '確定要整單取消嗎？',
            '整單取消',
            '返回'
        );
    }

    function closeDetail() {
        document.getElementById('checkoutContent').style.display = 'none';
        document.getElementById('emptyRight').style.display      = 'flex';
        document.getElementById('emptyRightIcon').textContent    = '👈';
        document.getElementById('emptyRightText').textContent    = '請選擇訂單';
        const cancelOrderBtn = document.getElementById('cancelOrderBtn');
        if (cancelOrderBtn) cancelOrderBtn.style.display = 'none';
        document.querySelectorAll('.table-btn, .takeout-item').forEach(b =>
            b.classList.remove('active-selected'));
        currentPreOrderId = null;
        currentTableId    = null;
    }

    function selectPayMethod(method) {
        currentPayMethod = method;
        ['Cash', 'Card', 'Other'].forEach(m => {
            const btn = document.getElementById('pmBtn-' + m);
            if (btn) btn.classList.toggle('active', m === method);
        });
        document.getElementById('cashSection').style.display = method === 'Cash' ? 'block' : 'none';
        // 把選擇的付款方式帶入 form
        let input = document.getElementById('checkoutPayMethod');
        if (!input) {
            input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'payMethod';
            input.id   = 'checkoutPayMethod';
            document.getElementById('checkoutForm').appendChild(input);
        }
        input.value = method;
    }

    function calcChange() {
        const paid   = parseInt(document.getElementById('cashInput').value || 0);
        const change = paid - currentTotal;
        document.getElementById('changeDisplay').textContent =
            paid >= currentTotal ? `NT$ ${change}` : '金額不足';
    }

    document.addEventListener('DOMContentLoaded', () => {
        const defaultTableId = @(ViewBag.DefaultTableId ?? 0);

            if (defaultTableId > 0) {
        const tables = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                                                                                                                                                                                                                                                                                                                                                Model.Tables.Select(t => new { t.TableId, t.TableName, t.PreOrderId, t.HasOrder })
                                                                                                                                                                                                                                                                ));
            const target = tables.find(t => t.TableId === defaultTableId);
    if (target) {
        const anyEl = document.getElementById('tbtn-' + target.PreOrderId)
                   || document.querySelector(`[data-tableid="${defaultTableId}"]`);
        if (anyEl) {
            anyEl.classList.add('active-selected');
            anyEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        if (target.HasOrder && target.PreOrderId) {
            const el = document.getElementById('tbtn-' + target.PreOrderId);
            if (el) loadDetail(target.PreOrderId, el);
        } else {
            document.getElementById('emptyRight').style.display = 'flex';
            document.getElementById('checkoutContent').style.display = 'none';
            document.getElementById('emptyRightIcon').textContent = '🛎️';
            document.getElementById('emptyRightText').textContent = '點餐中...';
        }
    }
    } else {
        switchTab('take');
    }
    });
        let splitMode = false;

    function toggleSplitMode() {
        splitMode = !splitMode;
        const btn       = document.getElementById('splitModeBtn');
        const checkCol  = document.querySelectorAll('#splitCheckCol, .split-check-col');
        const splitSec  = document.getElementById('splitBillSection');
        const normalSec = document.getElementById('checkoutBtn').parentElement.parentElement;

        btn.textContent = splitMode ? '取消拆單' : '拆單結帳';
        btn.style.background = splitMode ? '#fff5f5' : '#fff';
        btn.style.color      = splitMode ? '#c0392b' : '#1a77c9';
        btn.style.borderColor= splitMode ? '#c0392b' : '#1a77c9';

        checkCol.forEach(el => el.style.display = splitMode ? '' : 'none');
        splitSec.style.display  = splitMode ? 'block' : 'none';

        // 取消拆單時清除所有勾選
        if (!splitMode) {
            document.querySelectorAll('.detail-check').forEach(c => c.checked = false);
            document.getElementById('splitSubtotal').textContent = '0';
        }
    }

    function toggleAll(master) {
        document.querySelectorAll('.detail-check')
                .forEach(c => c.checked = master.checked);
        updateSplitTotal();
    }

    function updateSplitTotal() {
        let total = 0;
        document.querySelectorAll('.detail-check:checked').forEach(c => {
            total += parseInt(c.dataset.subtotal || 0);
        });
        document.getElementById('splitSubtotal').textContent = total;

        // 全選時同步 master checkbox
        const all     = document.querySelectorAll('.detail-check');
        const checked = document.querySelectorAll('.detail-check:checked');
        const master  = document.getElementById('checkAll');
        if (master) master.indeterminate = checked.length > 0 && checked.length < all.length;
        if (master) master.checked = checked.length === all.length;
    }

        async function doSplitCheckout() {
        const checked = [...document.querySelectorAll('.detail-check:checked')];
        const detailIds = [...checked.map(c => parseInt(c.dataset.detailId))];

        // 若勾選了套餐標題，自動把其子項目的 detailId 一併帶入
        checked.filter(c => c.dataset.isSetMeal === 'true').forEach(c => {
            const parentId = parseInt(c.dataset.detailId);
            document.querySelectorAll(`#detailBody tr.child-item-row[data-parent-id="${parentId}"]`)
                    .forEach(row => detailIds.push(parseInt(row.dataset.detailId)));
        });

        if (!detailIds.length) {
            showAlert('請先勾選要結帳的餐點');
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const res = await fetch('/Payments/SplitCheckout', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({
                tableId: currentTableId,
                detailIds: detailIds,
                payMethod: currentPayMethod || 'Cash'
            })
        });

    const result = await res.json();
    if (result.success) {
        splitMode = true;
        toggleSplitMode();

        if (!result.isFullyPaid && result.remaining) {
            // 還有剩餘，直接更新右側明細
            renderDetail(result.remaining);
            // 更新左側金額顯示
            const targetBtn = document.querySelector(`[data-table-id="${currentTableId}"]`);
            if (targetBtn) {
                const amtSpan = targetBtn.querySelector('.table-amount');
                if (amtSpan) amtSpan.textContent = `$${result.remaining.totalAmount}`;
            }
        } else {
            // 全部結完，顯示完成訊息後 reload
            const tbody = document.getElementById('detailBody');
            tbody.innerHTML = `
                <tr><td colspan="5" style="text-align:center;padding:40px;color:#27ae60;font-size:1.1rem;font-weight:700;">
                    ✅ 此桌已全部結帳完成
                </td></tr>`;
            document.getElementById('amtOriginal').textContent = '-';
            document.getElementById('amtDiscount').textContent = '-';
            document.getElementById('amtTotal').textContent = '-';
            document.getElementById('checkoutBtn').classList.remove('show');
            document.getElementById('unservedWarning').style.display = 'none';
            document.getElementById('couponTag').style.display = 'none';
            // 1.5 秒後 reload 更新左側桌子狀態
            setTimeout(() => window.location.href = "/Payments/Create", 1500);
        }
    } else {
        showAlert('拆單失敗：' + (result.message || '未知錯誤'), '❌ 錯誤');
    }

    }
</script>
