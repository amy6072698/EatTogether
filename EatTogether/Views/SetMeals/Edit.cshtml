@model EatTogether.Models.ViewModels.SetMealViewModel
@{
    ViewData["Title"] = "編輯套餐";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">編輯套餐</h1>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <span class="fw-bold"><i class="fas fa-edit me-1 text-warning"></i>套餐基本資料</span>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary border-0">
                <i class="fas fa-arrow-left me-1"></i>返回列表
            </a>
        </div>
        <div class="card-body p-4">
            <form method="post" enctype="multipart/form-data" asp-action="Edit" asp-route-id="@Model.Id" id="editForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />
                <input type="hidden" id="croppedImageData" name="CroppedImageData" />
                <input type="hidden" id="itemsJson" name="ItemsJson" />

                <div class="row">
                    <!-- 左側資料區 -->
                    <div class="col-lg-8">
                        <div class="row g-4">
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-secondary">套餐名稱 <span class="text-danger">*</span></label>
                                <input asp-for="SetMealName" class="form-control form-control-lg border-light-subtle shadow-sm" />
                                <span asp-validation-for="SetMealName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary">套餐定價</label>
                                <div class="input-group input-group-lg shadow-sm">
                                    <span class="input-group-text bg-light border-light-subtle">$</span>
                                    <input asp-for="SetPrice" class="form-control border-light-subtle" min="0" step="1" value="@Model.SetPrice?.ToString("0")" />
                                </div>
                                <span asp-validation-for="SetPrice" class="text-danger small"></span>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold text-secondary">折扣類型 <span class="text-danger">*</span></label>
                                <select asp-for="DiscountType" asp-items="Model.DiscountTypeOptions"
                                        class="form-select form-select-lg border-light-subtle shadow-sm" onchange="updateDiscountLabel()"></select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold text-secondary" id="discountLabel">
                                    @(Model.DiscountType == "percent" ? "折扣值（%）" : "折扣值（元）")
                                    <span class="text-danger">*</span>
                                </label>
                                <input asp-for="DiscountValue" class="form-control form-control-lg border-light-subtle shadow-sm" min="0" step="0.01" />
                                <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-bold text-secondary"></label>
                                <input asp-for="StartDate" type="date" class="form-control form-control-lg border-light-subtle shadow-sm" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-bold text-secondary"></label>
                                <input asp-for="EndDate" type="date" class="form-control form-control-lg border-light-subtle shadow-sm" />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StartTime" class="form-label fw-bold text-secondary"></label>
                                <input asp-for="StartTime" type="time" class="form-control form-control-lg border-light-subtle shadow-sm" />
                                <span asp-validation-for="StartTime" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EndTime" class="form-label fw-bold text-secondary"></label>
                                <input asp-for="EndTime" type="time" class="form-control form-control-lg border-light-subtle shadow-sm" />
                                <span asp-validation-for="EndTime" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold text-secondary">套餐描述</label>
                                <textarea asp-for="Description" class="form-control border-light-subtle shadow-sm" rows="4"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12 d-flex gap-4">
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                                    <label asp-for="IsActive" class="form-check-label fw-bold text-muted"></label>
                                </div>
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsPopular" class="form-check-input" type="checkbox" role="switch">
                                    <label asp-for="IsPopular" class="form-check-label fw-bold text-muted"></label>
                                </div>
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsRecommended" class="form-check-input" type="checkbox" role="switch">
                                    <label asp-for="IsRecommended" class="form-check-label fw-bold text-muted"></label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 右側圖片區 -->
                    <div class="col-lg-4 border-start border-light-subtle">
                        <div class="ps-lg-4 text-center">
                            <label class="form-label fw-bold text-secondary d-block text-start mb-3">套餐圖片</label>

                            <div id="imageArea" class="position-relative border rounded-4 bg-light overflow-hidden shadow-sm d-flex align-items-center justify-content-center"
                                 style="aspect-ratio: 4/3; cursor: pointer; border: 2px dashed #cbd5e0 !important;" onclick="editOrUploadImage()">

                                <div id="placeholderContent" class="text-center" style="@(string.IsNullOrEmpty(Model.ImageUrl) ? "" : "display:none")">
                                    <i class="fas fa-cloud-upload-alt fa-3x text-primary mb-3"></i>
                                    <p class="text-secondary mb-1">點擊變更圖片</p>
                                    <small class="text-muted">建議比例 4:3</small>
                                </div>

                                <img id="previewImg" src="@(Model.ImageUrl ?? "")" class="img-fluid @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")" style="width:100%; height:100%; object-fit: cover;" />

                                <div id="editBadge" class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-50 text-white text-center py-2 @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")">
                                    <i class="fas fa-camera me-1"></i> 點擊更換或重新裁切
                                </div>

                                <div id="cropperArea" class="w-100 h-100 d-none" style="background-color: #eee;">
                                    <img id="cropperImg" src="" style="display: block; max-width: 100%;">
                                </div>
                            </div>

                            <div class="mt-2 text-end">
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('imageInput').click()">
                                    <i class="fas fa-upload me-1"></i> 更換圖片
                                </button>
                            </div>

                            <div id="cropControls" class="mt-3 d-none text-start">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <button type="button" class="btn btn-primary w-100 fw-bold shadow-sm" onclick="saveCrop()">
                                            <i class="fas fa-check-circle me-1"></i> 確定位置
                                        </button>
                                    </div>
                                    <div class="col-6">
                                        <button type="button" class="btn btn-outline-danger w-100 fw-bold shadow-sm" onclick="cancelCrop()">
                                            取消
                                        </button>
                                    </div>
                                </div>
                                <div class="text-center mt-2">
                                    <small class="text-primary fw-bold"><i class="fas fa-arrows-alt me-1"></i> 請拖曳圖片對準框架</small>
                                </div>
                            </div>

                            <input type="file" id="imageInput" class="form-control d-none" accept="image/*"
                                   onchange="onFileChange(this)" />

                            <div class="mt-4 p-3 bg-light rounded-3 border-0 small text-start text-muted">
                                <div class="mb-1">建立時間：@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                                @if (Model.UpdatedAt.HasValue)
                                {
                                    <div>最後更新：@Model.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm rounded-pill">
                        儲存基本資料
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 套餐餐點明細 -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <span class="fw-bold"><i class="fas fa-list me-1 text-primary"></i>套餐包含餐點</span>
        </div>
        <div class="card-body p-4">
            <div id="itemAlertBox"></div>
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div id="category-slots-container">
                        @foreach (var categoryVm in Model.CategoriesWithDishes)
                        {
                            <div class="card mb-3 shadow-sm category-slot" data-category-id="@categoryVm.CategoryId">
                                <div class="card-header d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #f0f7ff 0%, #ffffff 100%); border-bottom: 1px solid #e0e0e0;">
                                    <h5 class="mb-0 fw-bold text-dark">@categoryVm.CategoryName</h5>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input is-optional-toggle" type="checkbox" role="switch"
                                               id="isOptional-@categoryVm.CategoryId" @(categoryVm.IsCategoryOptional ? "checked" : "")
                                               onchange="toggleCategoryOptionalFields(@categoryVm.CategoryId)">
                                        <label class="form-check-label" for="isOptional-@categoryVm.CategoryId">是否為選擇性分類</label>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3 optional-settings mb-3" style="display: @(categoryVm.IsCategoryOptional ? "" : "none");">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold text-secondary">群組編號</label>
                                            <input type="number" class="form-control category-group-no" value="@(categoryVm.OptionGroupNoForCategory ?? 1)" min="1" />
                                            <small class="form-text text-muted">將「選擇性」餐點分組，顧客只能從同群組中選擇。</small>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold text-secondary">選取上限</label>
                                            <input type="number" class="form-control category-pick-limit" value="@(categoryVm.PickLimitForCategory ?? 1)" min="1" />
                                            <small class="form-text text-muted">顧客從此群組中，最多能選擇的餐點數量。</small>
                                        </div>
                                    </div>

                                    <div class="dish-selection-rows">
                                        <!-- Dish selection rows will be dynamically added here by JavaScript -->
                                    </div>
                                    <button type="button" class="btn btn-outline-primary btn-sm add-dish-to-category mt-3"
                                            data-category-id="@categoryVm.CategoryId">
                                        <i class="fas fa-plus me-1"></i>新增餐點
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-5 pt-4 border-top d-flex justify-content-end">
                        <button type="button" class="btn btn-success btn-lg px-5 shadow-sm rounded-pill" onclick="saveItems()">
                            <i class="fas fa-save me-1"></i> 儲存餐點設定
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Save Confirmation Modal -->
<div class="modal fade" id="saveConfirmModal" tabindex="-1" aria-labelledby="saveConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="saveConfirmModalLabel">確認儲存套餐餐點設定</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>您即將儲存以下套餐餐點設定：</p>
                <div id="saveConfirmSummary" class="alert alert-light border small" style="max-height: 300px; overflow-y: auto;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="confirmSaveItemsBtn">確認儲存</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
    <style>
        #imageArea:hover {
            border-color: var(--bs-primary) !important;
            background-color: #f0f7ff !important;
        }

        #imageArea.drag-over {
            border-color: #0d6efd !important;
            background: #f8fbff;
        }

        /* 隱藏裁切框的四個角控制點，讓它看起來不能縮放 */
        .cropper-line, .cropper-point {
            display: none !important;
        }

        .cropper-view-box {
            outline: 2px solid #0d6efd;
            outline-opacity: 0.7;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
    <script>
        const setMealId = @Model.Id;
        let myCropper = null;
        const imageInput = document.getElementById("imageInput");
        const imageArea = document.getElementById("imageArea");
        const placeholderContent = document.getElementById("placeholderContent");
        const cropperArea = document.getElementById("cropperArea");
        const cropperImg = document.getElementById("cropperImg");
        const previewImg = document.getElementById("previewImg");
        const editBadge = document.getElementById("editBadge");
        const cropControls = document.getElementById("cropControls");

        function updateDiscountLabel() {
            const type = document.getElementById("DiscountType").value;
            document.getElementById("discountLabel").innerHTML =
                type === "percent" ? '折扣值（%） <span class="text-danger">*</span>' : '折扣值（元） <span class="text-danger">*</span>';
        }

        function collectItems() {
            const allItems = [];
            const categorySlots = document.querySelectorAll('.category-slot');
            
            categorySlots.forEach(categorySlot => {
                const isCategoryOptional = categorySlot.querySelector('.is-optional-toggle').checked;
                let optionGroupNo = null;
                let pickLimit = null;

                if (isCategoryOptional) {
                    optionGroupNo = parseInt(categorySlot.querySelector('.category-group-no').value);
                    pickLimit = parseInt(categorySlot.querySelector('.category-pick-limit').value);
                }

                const dishRows = categorySlot.querySelectorAll('.dish-selection-row');
                dishRows.forEach(row => {
                    const dishId = parseInt(row.querySelector('.dish-id-select').value);
                    const quantity = parseInt(row.querySelector('.dish-quantity').value);
                    const displayOrder = parseInt(row.querySelector('.dish-display-order').value);

                    if (!isNaN(dishId) && dishId > 0) {
                        allItems.push({
                            SetMealId: setMealId,
                            DishId: dishId,
                            Quantity: quantity,
                            IsOptional: isCategoryOptional,
                            OptionGroupNo: isCategoryOptional ? optionGroupNo : null,
                            PickLimit: isCategoryOptional ? pickLimit : null,
                            DisplayOrder: displayOrder
                        });
                    }
                });
            });
            return allItems;
        }

        // 攔截表單提交，同步餐點資料
        document.getElementById("editForm").addEventListener("submit", function(e) {
            const items = collectItems();
            document.getElementById("itemsJson").value = JSON.stringify(items);
        });

        // --- Main Image Handling Logic (Same as Dishes) ---

        function editOrUploadImage() {
            const hasExistingImage = previewImg.src && !previewImg.src.includes('no-image.png') && !previewImg.classList.contains('d-none');
            if (hasExistingImage) {
                openCropperWithUrl(previewImg.src);
            } else {
                imageInput.click();
            }
        }

        function openCropperWithUrl(url) {
            previewImg.classList.add("d-none");
            placeholderContent.classList.add("d-none");
            editBadge.classList.add("d-none");
            cropperArea.classList.remove("d-none");
            cropControls.classList.remove("d-none");

            cropperImg.src = url;

            cropperImg.onload = function() {
                if (myCropper) myCropper.destroy();
                myCropper = new Cropper(cropperImg, {
                    aspectRatio: 4 / 3,
                    viewMode: 1,
                    dragMode: 'move',
                    autoCropArea: 1,
                    background: false,
                    responsive: true,
                    restore: false,
                    guides: false,
                    center: false,
                    highlight: false,
                    cropBoxMovable: false,
                    cropBoxResizable: false,
                    toggleDragModeOnDblclick: false,
                });
                cropperImg.onload = null;
            };
            if (cropperImg.complete) cropperImg.onload();
        }

        function processFile(file) {
            if (!file || !file.type.startsWith("image/")) return;
            const reader = new FileReader();
            reader.onload = (e) => openCropperWithUrl(e.target.result);
            reader.readAsDataURL(file);
        }

        function onFileChange(input) {
            if (input.files && input.files[0]) {
                processFile(input.files[0]);
            }
        }

        function saveCrop() {
            if (!myCropper) return;
            const canvas = myCropper.getCroppedCanvas({ width: 800, height: 600, imageSmoothingQuality: 'high' });
            const dataUrl = canvas.toDataURL("image/jpeg", 0.9);
            document.getElementById("croppedImageData").value = dataUrl;
            previewImg.src = dataUrl;
            exitCropper();
        }

        function cancelCrop() {
            exitCropper();
        }

        function exitCropper() {
            if (myCropper) {
                myCropper.destroy();
                myCropper = null;
            }
            cropperArea.classList.add("d-none");
            cropControls.classList.add("d-none");

            const hasImage = previewImg.src 
                && !previewImg.src.endsWith("/") 
                && !previewImg.src.includes("no-image.png")
                && previewImg.src !== window.location.href;

            if (hasImage) {
                previewImg.classList.remove("d-none");
                editBadge.classList.remove("d-none");
                placeholderContent.style.display = "none";
            } else {
                placeholderContent.style.display = "";
                previewImg.classList.add("d-none");
                editBadge.classList.add("d-none");
            }
        }

        // --- Drag and Drop ---
        imageArea.addEventListener("dragover", e => { e.preventDefault(); imageArea.classList.add("drag-over"); });
        imageArea.addEventListener("dragleave", () => { imageArea.classList.remove("drag-over"); });
        imageArea.addEventListener("drop", e => {
            e.preventDefault();
            imageArea.classList.remove("drag-over");
            if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                processFile(e.dataTransfer.files[0]);
            }
        });

        // --- Original SetMeal Detail Logic ---
        function formatSelectedOptionText(item) {
            let text = `${item.dishName} ($${item.dishPrice}) x${item.quantity}`;
            if (item.isOptional === true || item.isOptional === 'true') {
                text += ` (選擇性 - 群組${item.optionGroupNo ?? ''}, 限選${item.pickLimit ?? ''})`;
            } else {
                text += ` (固定)`;
            }
            return text;
        }

        function toggleCategoryOptionalFields(categoryId) {
            const categorySlot = document.querySelector(`.category-slot[data-category-id="${categoryId}"]`);
            const isOptionalToggle = categorySlot.querySelector('.is-optional-toggle');
            const optionalSettings = categorySlot.querySelector('.optional-settings');

            if (isOptionalToggle.checked) {
                optionalSettings.style.display = '';
            } else {
                optionalSettings.style.display = 'none';
            }
        }

        function getCategorySelectOptions(categoryId, allDishesInCategories) {
            const category = allDishesInCategories.find(c => c.categoryId == categoryId);
            if (!category || !category.dishesInThisCategory) return '';

            let optionsHtml = '<option value="" data-price="0">請選擇餐點</option>';
            category.dishesInThisCategory.forEach(dish => {
                const priceMatch = dish.text.match(/\$(\d+(\.\d+)?)/);
                const price = priceMatch ? priceMatch[1] : 0;
                optionsHtml += `<option value="${dish.value}" data-price="${price}">${dish.text}</option>`;
            });
            return optionsHtml;
        }

        function renderDishSelectionRow(categoryId, categorySelectOptions, initialItem = null) {
            const dishId = initialItem ? initialItem.dishId : '';
            const quantity = initialItem ? initialItem.quantity : 1;
            const displayOrder = initialItem ? initialItem.displayOrder : 1;

            const rowHtml = `
                <div class="row g-3 mb-2 dish-selection-row align-items-end" data-dish-id="${dishId}">
                    <div class="col-md-5">
                        <label class="form-label small fw-bold text-secondary">餐點</label>
                        <select class="form-select dish-id-select">
                            ${categorySelectOptions}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-secondary">數量</label>
                        <input type="number" class="form-control dish-quantity" value="${quantity}" min="1" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-secondary">順序</label>
                        <input type="number" class="form-control dish-display-order" value="${displayOrder}" min="1" />
                    </div>
                    <div class="col-md-3 text-end">
                        <button type="button" class="btn btn-outline-danger btn-sm remove-dish-from-category">移除</button>
                    </div>
                </div>
            `;
            return rowHtml;
        }

        document.addEventListener('DOMContentLoaded', function () {
            const categoriesWithDishes = @Html.Raw(ViewBag.CategoriesWithDishesJson);

            categoriesWithDishes.forEach(categoryVm => {
                const categorySlot = document.querySelector(`.category-slot[data-category-id="${categoryVm.categoryId}"]`);
                const dishSelectionRowsContainer = categorySlot.querySelector('.dish-selection-rows');
                const categorySelectOptions = getCategorySelectOptions(categoryVm.categoryId, categoriesWithDishes);

                categoryVm.selectedItemsForCategory.forEach(item => {
                    const rowHtml = renderDishSelectionRow(categoryVm.categoryId, categorySelectOptions, item);
                    dishSelectionRowsContainer.insertAdjacentHTML('beforeend', rowHtml);
                    const newRow = dishSelectionRowsContainer.lastElementChild;
                    newRow.querySelector('.dish-id-select').value = item.dishId;
                });
            });

            document.querySelectorAll('.add-dish-to-category').forEach(button => {
                button.addEventListener('click', function() {
                    const categoryId = this.dataset.categoryId;
                    const categorySlot = document.querySelector(`.category-slot[data-category-id="${categoryId}"]`);
                    const dishSelectionRowsContainer = categorySlot.querySelector('.dish-selection-rows');
                    const categorySelectOptions = getCategorySelectOptions(categoryId, categoriesWithDishes);

                    const rowHtml = renderDishSelectionRow(categoryId, categorySelectOptions);
                    dishSelectionRowsContainer.insertAdjacentHTML('beforeend', rowHtml);
                });
            });

            document.getElementById('category-slots-container').addEventListener('click', function(e) {
                if (e.target.classList.contains('remove-dish-from-category')) {
                    e.target.closest('.dish-selection-row').remove();
                }
            });

            document.querySelectorAll('.is-optional-toggle').forEach(toggle => {
                toggleCategoryOptionalFields(toggle.id.split('-')[1]);
            });
        });

        function formatItemForSummary(item, dishName, dishPrice) {
            let text = `${dishName} ($${dishPrice}) x${item.Quantity}`;
            if (item.IsOptional === true || item.IsOptional === 'true') {
                text += ` <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">限選 ${item.PickLimit ?? ''}</span>`;
            } else {
                text += ` <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle ms-1">固定</span>`;
            }
            return text;
        }

        async function saveItems() {
            const allItemsToSave = [];
            let isValid = true;
            const categorySlots = document.querySelectorAll('.category-slot');
            const saveConfirmSummaryDiv = document.getElementById('saveConfirmSummary');
            let summaryHtml = '';

            categorySlots.forEach(categorySlot => {
                const categoryId = parseInt(categorySlot.dataset.categoryId);
                const categoryName = categorySlot.querySelector('h5').textContent;
                const isCategoryOptional = categorySlot.querySelector('.is-optional-toggle').checked;
                let optionGroupNoForCategory = null;
                let pickLimitForCategory = null;

                if (isCategoryOptional) {
                    const groupNoEl = categorySlot.querySelector('.category-group-no');
                    const pickLimitEl = categorySlot.querySelector('.category-pick-limit');
                    optionGroupNoForCategory = parseInt(groupNoEl.value);
                    pickLimitForCategory = parseInt(pickLimitEl.value);
                    
                    if (isNaN(optionGroupNoForCategory) || isNaN(pickLimitForCategory) || optionGroupNoForCategory < 1 || pickLimitForCategory < 1) {
                        showAlert('itemAlertBox', 'danger', `分類 ${categoryName} 的「群組編號」或「選取上限」無效。`);
                        isValid = false;
                        return;
                    }
                }

                const dishRows = categorySlot.querySelectorAll('.dish-selection-row');
                if (dishRows.length > 0) {
                    summaryHtml += `<h6 class="fw-bold mt-3 text-dark-emphasis">${categoryName}</h6><ul class="list-group list-group-flush mb-2 border rounded shadow-sm">`;
                }

                dishRows.forEach(row => {
                    const dishIdSelect = row.querySelector('.dish-id-select');
                    const quantityInput = row.querySelector('.dish-quantity');
                    const displayOrderInput = row.querySelector('.dish-display-order');

                    const dishId = parseInt(dishIdSelect.value);
                    const quantity = parseInt(quantityInput.value);
                    const displayOrder = parseInt(displayOrderInput.value);

                    const selectedOption = dishIdSelect.options[dishIdSelect.selectedIndex];
                    const dishName = selectedOption.text.split('(')[0].trim();
                    const dishPrice = selectedOption.dataset.price || 0;

                    if (isNaN(dishId) || dishId === 0) {
                        showAlert('itemAlertBox', 'danger', `分類 ${categoryName} 中有未選擇餐點的列。`);
                        isValid = false;
                        return;
                    }
                    if (isNaN(quantity) || quantity < 1) {
                        showAlert('itemAlertBox', 'danger', `餐點 ${dishName} 的數量無效。`);
                        isValid = false;
                        return;
                    }
                     if (isNaN(displayOrder) || displayOrder < 1) {
                        showAlert('itemAlertBox', 'danger', `餐點 ${dishName} 的顯示順序無效。`);
                        isValid = false;
                        return;
                    }

                    const itemToSave = {
                        SetMealId: setMealId,
                        DishId: dishId,
                        Quantity: quantity,
                        IsOptional: isCategoryOptional,
                        OptionGroupNo: isCategoryOptional ? optionGroupNoForCategory : null,
                        PickLimit: isCategoryOptional ? pickLimitForCategory : null,
                        DisplayOrder: displayOrder
                    };
                    allItemsToSave.push(itemToSave);
                    summaryHtml += `<li class="list-group-item small py-2">- ${formatItemForSummary(itemToSave, dishName, dishPrice)}</li>`;
                });
                if (dishRows.length > 0) {
                    summaryHtml += `</ul>`;
                }
            });

            if (!isValid) return;

            if (allItemsToSave.length === 0) {
                if (!confirm('您沒有選擇任何餐點，確定要清空此套餐的所有餐點嗎？')) {
                    return;
                }
                summaryHtml = '<p class="text-danger fw-bold"><i class="fas fa-exclamation-triangle me-1"></i>您即將清空此套餐的所有餐點內容。</p>';
            }

            saveConfirmSummaryDiv.innerHTML = summaryHtml;
            const saveConfirmModal = new bootstrap.Modal(document.getElementById('saveConfirmModal'));
            saveConfirmModal.show();

            document.getElementById('confirmSaveItemsBtn').onclick = async function() {
                saveConfirmModal.hide();
                const response = await fetch(`/SetMeals/UpdateItems/${setMealId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(allItemsToSave)
                });

                if (response.ok) {
                    const result = await response.json();
                    showAlert('itemAlertBox', 'success', result.message);
                    setTimeout(() => {
                        window.location.href = '@Url.Action("Index", "SetMeals")';
                    }, 1500);
                } else {
                    const error = await response.json();
                    showAlert('itemAlertBox', 'danger', error.message || '儲存失敗，請檢查網路連線或聯絡管理員。');
                }
            };
        }

        function showAlert(boxId, type, message) {
            const alertBox = document.getElementById(boxId);
            alertBox.innerHTML = `<div class="alert alert-${type} alert-dismissible fade show" role="alert">
                                    ${message}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                  </div>`;
        }
    </script>
}
