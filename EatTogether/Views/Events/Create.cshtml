@model EatTogether.Models.ViewModels.EventCreateViewModel

@{
    ViewData["Title"] = "活動新增";
}

@section Styles {
    <style>
        .discount-toggle-wrapper {
            user-select: none;
        }


        .toggle-track {
            width: 64px;
            height: 32px;
            background-color: #3b5bdb;
            border-radius: 16px;
            position: relative;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .toggle-thumb {
            width: 26px;
            height: 26px;
            background: white;
            border-radius: 50%;
            position: absolute;
            top: 3px;
            left: 3px;
            transition: transform 0.3s;
        }

        /* 系統折扣（IsAutoDiscount = 1）：thumb 在右邊 */
        .toggle-track.is-auto .toggle-thumb {
            transform: translateX(32px);
        }

        .toggle-label {
            font-size: 0.95rem;
            color: #555;
            transition: color 0.3s, font-weight 0.3s;
        }

            /* 目前選中的那側標籤加粗 */
            .toggle-label.active {
                color: #3b5bdb;
                font-weight: bold;
            }

    </style>   

}


<div class="container-fluid mt-4 " style="max-width: 90%;">
    <h1>活動新增</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">首頁</a></li>
        <li class="breadcrumb-item">活動管理</li>
        <li class="breadcrumb-item active">活動新增</li>
    </ol>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="m-0 font-weight-bold text-dark">
                <i class="bi bi-table me-2"></i>活動新增
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="Title" class="control-label"></label><span class="text-danger">*</span>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="Summary" class="control-label"></label><span class="text-danger">*</span>
                            <input asp-for="Summary" class="form-control" />
                            <span asp-validation-for="Summary" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="MinSpend" class="control-label"></label><span class="text-danger">*</span>
                            <input asp-for="MinSpend" class="form-control" />
                            <span asp-validation-for="MinSpend" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="RewardDishId" class="control-label"></label>
                            <span class="form-text">※非贈品活動無需填寫</span>
                            <select asp-for="RewardDishId" class="form-control" id="rewardDishSelect">
                                <option value="">-- 無贈品 --</option>

                                @foreach (var dish in Model.DishOptions)
                                {
                                    var price = ((Dictionary<int, decimal>)ViewBag.DishPrices)[int.Parse(dish.Value)];
                                    <option value="@dish.Value"
                                            data-price="@price"
                                            selected="@(Model.RewardDishId?.ToString() == dish.Value ? "selected" : null)">
                                        @dish.Text
                                    </option>
                                }
                            </select>                       
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="DiscountType" class="control-label"></label><span class="text-danger">*</span>
                            <select asp-for="DiscountType" class="form-control" id="DiscountType">
                                <option value=""></option>
                                <option value="FixedAmount">折抵金額</option>
                                <option value="Percent">打折</option>
                                <option value="Gift">贈品</option>
                            </select>
                            <span asp-validation-for="DiscountType" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="DiscountValue" class="control-label"></label><span class="text-danger">*</span>    <span class="form-text">※打折請輸入百分比，例：打85折即填寫0.85</span>
                            <input asp-for="DiscountValue" class="form-control" />
                            <span asp-validation-for="DiscountValue" class="text-danger"></span>
                        </div>
                        
                    </div>

                    @* --!右邊區塊-- *@
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="StartDate" class="control-label"></label><span class="text-danger">*</span>
                            <input type="date" asp-for="StartDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="EndDate" class="control-label"></label><span class="text-danger">*</span>
                            <input type="date" asp-for="EndDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label class="control-label">折扣方式</label><span class="text-danger">*</span>
                            <div class="discount-toggle-wrapper d-flex align-items-center" style="gap:12px;">
                                <span class="toggle-label active" id="label-auto">系統折扣</span>
                                <div class="toggle-track" id="discountToggle">
                                    <div class="toggle-thumb"></div>
                                </div>
                                <span class="toggle-label" id="label-manual">人工折扣</span>
                            </div>
                            <input type="hidden" name="IsAutoDiscount" id="IsAutoDiscountInput" value="1" />
                        </div>
                    </div>


                    <div class="form-group mt-3 d-flex align-items-center">
                        <input type="submit" value="新增" class="btn btn-primary me-2" />

                        <a asp-action="Index" class="btn btn-light">返回列表</a>
                    </div>

                </div>
            </form>
        </div>

    </div>

</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>

        // 展示資料按鈕
        var $demoBtn = $('<button type="button" class="btn btn-outline-secondary btn-sm ms-auto">📋 填入示範資料</button>');
        $('.form-group.mt-3').append($demoBtn);

        $demoBtn.on('click', function () {
            $('input[name="Title"]').val('夏日滿額贈活動');
            $('input[name="Summary"]').val('消費滿500元即贈精選甜點一份');
            $('input[name="MinSpend"]').val('500');
            $('input[name="StartDate"]').val('2026-05-13');
            $('input[name="EndDate"]').val('2026-05-15');
        });

        //監聽贈品選項，如果有選會自動填入類別及價格
        $('#rewardDishSelect').on('change', function () {
            var price = $(this).find(':selected').data('price');
            if (price !== undefined && price !== '') {
                $('#DiscountValue').val(price);  
                $('#DiscountType').val('Gift');  
            } else {
                $('#DiscountValue').val('');     
                $('#DiscountType').val('');  
            }
        });

        //監聽折扣類別選項，如果先前贈品欄位有值會直接清空
        $('#DiscountType').on('change', function () {
            var type = $(this).val();
            if (type == 'FixedAmount' || type == 'Percent' || type == '') {
                $('#rewardDishSelect').val('');
                $('#DiscountValue').val('');
            }
        });

        $(function () {
            var $toggle = $('#discountToggle');
            var $input = $('#IsAutoDiscountInput');
            var $labelManual = $('#label-manual');
            var $labelAuto = $('#label-auto');

            function updateUI(isAuto) {
                if (isAuto) {
                    $toggle.removeClass('is-auto');
                    $labelManual.removeClass('active');
                    $labelAuto.addClass('active');
                    $input.val(1);
                } else {
                    $toggle.addClass('is-auto');
                    $labelManual.addClass('active');
                    $labelAuto.removeClass('active');
                    $input.val(0);
                }
            }

            updateUI(true);

            $toggle.on('click', function () {
                updateUI(parseInt($input.val()) !== 1);
            });


            // 點標籤也可以切換
            $labelManual.on('click', function () { updateUI(false); });
            $labelAuto.on('click', function () { updateUI(true); });
        });

    </script>
}
