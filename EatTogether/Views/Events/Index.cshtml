@model IEnumerable<EatTogether.Models.ViewModels.EventViewModel>


@{
    ViewData["Title"] = "活動管理";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@section Styles {

    <style>       

        /* 讓篩選按鈕不要跟文字擠在一起 */
        #filter-container {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        #eventTable th,
        #eventTable td {
            border: 1px solid #dee2e6 !important;
        }

    </style>
}

<div class="container-fluid mt-4" style="max-width: 90%;">
    <h1>活動管理</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">首頁</a></li>
        <li class="breadcrumb-item active">活動管理</li>
    </ol>
    
    <div class="card shadow-sm">

        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="m-0 font-weight-bold text-dark">
                <i class="bi bi-table me-2"></i>活動列表
            </h5>
            <a asp-action="Create" class="btn btn-success btn-sm">
                <i class="bi bi-plus-lg"></i> 新增活動
            </a>
        </div>
        <div class="card-body">
            <div id="filter-container" class="d-inline-block me-5">
                <strong>篩選：</strong>
                <button type="button" class="btn btn-sm btn-outline-primary filter-btn" data-status="">全部</button> |
                <button type="button" class="btn btn-sm btn-outline-success filter-btn" data-status="進行中">進行中</button> |
                <button type="button" class="btn btn-sm btn-outline-secondary filter-btn" data-status="未開始">未開始</button> |
                <button type="button" class="btn btn-sm btn-outline-danger filter-btn" data-status="已結束">已結束</button>
            </div>
            <table id="eventTable" class="table table-bordered w-100">
                <thead class="bg-light">
                    <tr>
                        <th>標題</th>
                        <th>摘要</th>
                        <th>門檻</th>
                        <th>開始日期</th>
                        <th>結束日期</th>
                        <th>贈品</th>
                        <th>折扣類別</th>
                        <th>折扣金額</th>
                        <th>狀態</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
            
        </div>  
    </div>
</div>



@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            var table = $('#eventTable').DataTable({
                    ajax: {
                        type: "GET",
                        url: `/Events/Index`,
                        dataSrc: ""
                    },
                    dom: '<"d-flex justify-content-between align-items-center mb-3"<"filter-left"><"filter-right"f>>t<"d-flex justify-content-between mt-3"ip>',
                    initComplete: function() {
                        $("#filter-container").appendTo($(".filter-left"));
                    },
                    columns: [
                        { data: "title"},
                        { data: "summary"},
                        { data: "minSpend"},
                        { data: "startDate", render: d => d?.substring(0,10).replace(/-/g,'/') },
                        { data: "endDate", render: d => d?.substring(0,10).replace(/-/g,'/') },
                        { data: "rewardDishName", render: d => d ?? '-' },
                        { 
                            data: "discountType",
                            render: function(data){
                                const map = {FixedAmount:'折抵金額', Percent:'打折', Gift: '贈品' };
                                return map[data] ?? data;
                            }
                        },
                        { 
                            data: "discountValue",
                            render: function(data, type, row){
                                if(row.discountType === 'Percent'){
                                    const val = data *100;
                                    return val % 10 === 0 ? (val/10) + '折' : val + '折';
                                }
                                return data;
                            }
                        },
                        { 
                            data: "status",
                            className: "text-center",
                            render: function(data, type){
                                if(type === 'filter' || type === 'sort'){
                                    return['未開始', '進行中', '已結束'][data] ?? data;
                                }
                                const labels = ['未開始', '進行中', '已結束'];
                                const classes = ['bg-secondary', 'bg-success', 'bg-danger'];
                                return `<span class="badge ${classes[data]}">${labels[data]}</span>`;
                            }
                        },
                        {
                            data: "id",
                            orderable: false, //這一欄不需要排序功能
                            className: "text-center",
                            render: function(data, type, row) {
                                if (row.status === 2) {
                                    return `
                                        <button type="button" class="btn-edit btn btn-outline-secondary btn-light btn-sm" data-id="${data}">
                                            <i class="bi bi-eye"></i> 詳情
                                        </button>
                                    `;
                                }
                                return `
                                    <button type="button" class="btn-edit btn btn-primary btn-sm" data-id="${data}">
                                        <i class="bi bi-pencil-square"></i> 編輯
                                    </button>
                                `;
                            }
                        }
                    ],
                    fixedHeader:{
                        header:true
                    },
                    paging: true,
                    pageLength: 10,
                    language: {
                        url: '//cdn.datatables.net/plug-ins/1.13.1/i18n/zh-HANT.json',
                    }
            })






            // 監聽篩選按鈕點擊事件
            $('.filter-btn').on('click', function () {
                var status = $(this).data('status');

                // 「狀態」那一欄.search(status) 進行搜尋，.draw() 重新繪製表格
                table.column(8).search(status).draw();

                //切換按鈕樣式
                $('.filter-btn').removeClass('active btn-dark').addClass('btn-outline-dark');
                $(this).addClass('active btn-dark').removeClass('btn-outline-dark');
            });

            // 查看按鈕（用事件委派，因為是動態產生的）
            $('#eventTable').on('click', '.btn-edit', function() {
                var id = $(this).data('id');
                window.location.href = `/Events/Edit/${id}`;
            });

    });



    </script>
}
