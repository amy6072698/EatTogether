@{
    ViewData["Title"] = "登入";
    ViewData["HideNav"] = true;
    ViewData["BodyClass"] = "auth-page";
}


<div class="auth-wrapper" data-auth-page="login">

    <!-- ========== Demo 帳號選擇區塊（正式版移除）========== -->
    <div class="demo-panel">
        <div class="demo-badge">⚠ Demo Only</div>
        <div class="demo-panel-title">帳號選擇（演示用）</div>
        <div class="demo-panel-subtitle">點擊角色可自動填入帳號密碼</div>

        <button class="demo-role-btn"
                data-account="manager_amy"
                data-password="Aa000000">
            <div class="demo-role-icon">
                <i class="fa-solid fa-crown" style="color:#e8722a;"></i>
            </div>
            <div class="demo-role-info">
                <span class="demo-role-name">店長</span>
                <span class="demo-role-account">manager_amy</span>
            </div>
        </button>

        <button class="demo-role-btn"
                data-account="vicemgr_lin"
                data-password="Aa000000">
            <div class="demo-role-icon">
                <i class="fa-solid fa-user-tie" style="color:#7eb3e0;"></i>
            </div>
            <div class="demo-role-info">
                <span class="demo-role-name">副店長</span>
                <span class="demo-role-account">vicemgr_lin</span>
            </div>
        </button>

        <button class="demo-role-btn"
                data-account="cashier_wang"
                data-password="Aa000000">
            <div class="demo-role-icon">
                <i class="fa-solid fa-cash-register" style="color:#2e9e6b;"></i>
            </div>
            <div class="demo-role-info">
                <span class="demo-role-name">收銀員</span>
                <span class="demo-role-account">cashier_wang</span>
            </div>
        </button>

        <button class="demo-role-btn"
                data-account="waiter_liu"
                data-password="Aa000000">
            <div class="demo-role-icon">
                <i class="fa-solid fa-bell-concierge" style="color:#e8b42a;"></i>
            </div>
            <div class="demo-role-info">
                <span class="demo-role-name">外場服務生</span>
                <span class="demo-role-account">waiter_liu</span>
            </div>
        </button>

        <button class="demo-role-btn"
                data-account="chef_zhang"
                data-password="Aa000000">
            <div class="demo-role-icon">
                <i class="fa-solid fa-hat-chef" style="color:#a0a0e0;"></i>
            </div>
            <div class="demo-role-info">
                <span class="demo-role-name">內場廚師</span>
                <span class="demo-role-account">chef_zhang</span>
            </div>
        </button>

        <button class="demo-role-btn"
                data-account="part_cai"
                data-password="Aa000000">
            <div class="demo-role-icon">
                <i class="fa-solid fa-person" style="color:#e08080;"></i>
            </div>
            <div class="demo-role-info">
                <span class="demo-role-name">工讀生</span>
                <span class="demo-role-account">part_cai</span>
            </div>
        </button>
    </div>
    <!-- ========== END Demo 區塊 ========== -->
    <!-- ========== 登入卡片 ========== -->
    <div class="auth-card">

        <!-- Logo -->
        <div class="auth-logo">
            <img src="~/images/logo-full-light.svg" alt="義起吃 EatTogether" class="auth-logo-img">
            <span class="auth-logo-sub">後台管理系統</span>
        </div>

        <!-- 警示訊息 -->
        <div class="auth-alert danger" id="auth-alert" role="alert">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span class="alert-msg"></span>
        </div>

        <!-- 登入表單 -->
        <form id="login-form" novalidate autocomplete="off">

            <!-- 帳號 -->
            <div class="auth-form-group">
                <label class="auth-label" for="account">帳號</label>
                <input type="text"
                       class="auth-input"
                       id="account"
                       name="account"
                       placeholder="請輸入帳號"
                       autocomplete="username"
                       maxlength="50" />
                <div class="auth-input-error" id="account-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span></span>
                </div>
            </div>

            <!-- 密碼 -->
            <div class="auth-form-group">
                <label class="auth-label" for="password">密碼</label>
                <div class="auth-input-wrap">
                    <input type="password"
                           class="auth-input"
                           id="password"
                           name="password"
                           placeholder="請輸入密碼"
                           autocomplete="current-password"
                           maxlength="100" />
                    <button type="button" class="toggle-password" data-target="password" aria-label="切換密碼顯示">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>
                <div class="auth-input-error" id="password-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span></span>
                </div>
            </div>

            <!-- 登入按鈕 -->
            <button type="submit" class="btn-auth-primary" id="login-btn">
                登入
            </button>

        </form>

        <!-- 忘記密碼 -->
        <button type="button" class="auth-forgot-link" id="forgot-password-link"
                data-bs-toggle="modal" data-bs-target="#forgotPasswordModal">
            <i class="fa-regular fa-circle-question me-1"></i>忘記密碼？
        </button>

    </div>
    <!-- ========== END 登入卡片 ========== -->

</div>

<!-- ========== 忘記密碼 Modal ========== -->
<div class="modal fade" id="forgotPasswordModal" tabindex="-1"
     aria-labelledby="forgotPasswordModalLabel" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="forgotPasswordModalLabel">
                    <i class="fa-solid fa-key me-2 text-warning"></i>忘記密碼
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>

            <div class="modal-body pt-2">
                <p class="text-muted small mb-3">
                    輸入帳號綁定的 Email，系統將寄送密碼重設連結至您的信箱
                </p>

                <!-- 錯誤訊息 -->
                <div class="auth-alert danger mb-3" id="forgot-alert" role="alert">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span class="alert-msg"></span>
                </div>

                <form id="forgot-password-form" novalidate autocomplete="off">
                    <div class="auth-form-group">
                        <label class="auth-label" for="forgot-email">Email</label>
                        <input type="email"
                               class="auth-input"
                               id="forgot-email"
                               name="email"
                               placeholder="請輸入帳號綁定的 Email"
                               autocomplete="email"
                               maxlength="100" />
                        <div class="auth-input-error" id="forgot-email-error">
                            <i class="fa-solid fa-circle-exclamation"></i>
                            <span></span>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer border-0 pt-0 gap-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"
                        id="forgot-cancel-btn">
                    取消
                </button>
                <button type="button" class="btn btn-warning text-dark fw-semibold"
                        id="forgot-submit-btn">
                    送出
                </button>
            </div>

        </div>
    </div>
</div>
<!-- ========== END 忘記密碼 Modal ========== -->

<!-- ========== 強制改密碼 Modal ========== -->
<div class="modal fade" id="forceChangePasswordModal" tabindex="-1"
     aria-labelledby="forceChangePasswordModalLabel" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="forceChangePasswordModalLabel">
                    <i class="fa-solid fa-lock me-2 text-warning"></i>請設定新密碼
                </h5>
            </div>

            <div class="modal-body pt-2">
                <p class="text-muted small mb-3">
                    為保護帳號安全，請重設新密碼，才能繼續使用系統
                </p>

                <!-- 錯誤訊息 -->
                <div class="auth-alert danger mb-3" id="force-change-alert" role="alert">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span class="alert-msg"></span>
                </div>

                <!-- 新密碼 -->
                <div class="auth-form-group">
                    <label class="auth-label" for="force-new-password">新密碼</label>
                    <div class="auth-input-wrap">
                        <input type="password"
                               class="auth-input"
                               id="force-new-password"
                               placeholder="請輸入新密碼"
                               autocomplete="new-password"
                               maxlength="100" />
                        <button type="button" class="toggle-password" data-target="force-new-password" aria-label="切換密碼顯示">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                    <div class="auth-input-error" id="force-new-password-error">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span></span>
                    </div>
                    <!-- 密碼規則提示 -->
                    <p class="text-muted small mt-1 mb-0">密碼須至少 6 個字元，並包含英文字母與數字</p>
                </div>

                <!-- 確認密碼 -->
                <div class="auth-form-group">
                    <label class="auth-label" for="force-confirm-password">確認密碼</label>
                    <div class="auth-input-wrap">
                        <input type="password"
                               class="auth-input"
                               id="force-confirm-password"
                               placeholder="請再次輸入新密碼"
                               autocomplete="new-password"
                               maxlength="100" />
                        <button type="button" class="toggle-password" data-target="force-confirm-password" aria-label="切換密碼顯示">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                    <div class="auth-input-error" id="force-confirm-password-error">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span></span>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-warning text-dark fw-semibold w-100"
                        id="force-change-btn">
                    確定重設
                </button>
            </div>

        </div>
    </div>
</div>
<!-- ========== END 強制改密碼 Modal ========== -->

@section Styles
{
    <style>
        /* ============================================================
            EatTogether（義起吃）後台管理系統 — 登入相關頁面樣式
            auth.css  ·  配色對齊後台主題（深色 #212529 / 金色 #F5D87A）
            ============================================================ */

        /* ---------- CSS 變數 ---------- */
        :root {
            /* 品牌色 */
            --brand-gold: #F5D87A;
            --brand-gold-dim: #d4b84a;
            --brand-gold-light: #faedb0;
            --brand-brown: #1A0D08;
            /* 後台主色（與 styles.css 品牌色對齊） */
            --bg-dark: #1A0D08; /* 品牌深棕黑 */
            --bg-darker: #120905; /* 較深變體 */
            --bg-darkest: #0e0806; /* 最深變體 */
            --surface-dark: #2a1508; /* 暖棕淺層 */
            /* 文字 */
            --text-on-dark: rgba(255, 255, 255, 0.85);
            --text-muted-dark: rgba(255, 255, 255, 0.45);
            --text-primary: #212529;
            --text-secondary: #495057;
            --text-muted: #6c757d;
            /* 輸入框 */
            --border-color: #dee2e6;
            --input-bg: #f8f9fa;
            --input-focus-ring: rgba(245, 216, 122, 0.25);
            /* 狀態色 */
            --success-color: #198754;
            --danger-color: #dc3545;
            /* 元件 */
            --card-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), 0 4px 16px rgba(0, 0, 0, 0.3);
            --card-radius: 16px;
            --input-radius: 8px;
            --btn-radius: 8px;
            --transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
            --font-main: "Noto Sans TC", -apple-system, BlinkMacSystemFont, sans-serif;
        }

        /* ---------- 全域重置 ---------- */
        .auth-page * {
            box-sizing: border-box;
        }

        /* ---------- 頁面背景 ---------- */
        .auth-page {
            min-height: 100vh;
            background: radial-gradient(ellipse at 15% 40%, rgba(245, 216, 122, 0.06) 0%, transparent 55%), radial-gradient(ellipse at 85% 70%, rgba(26, 13, 8, 0.6) 0%, transparent 50%), linear-gradient(160deg, #0e0806 0%, #1A0D08 45%, #2a1508 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            font-family: var(--font-main);
            position: relative;
        }

        /* 裝飾光暈 */
        .auth-page::before {
            content: '';
            position: fixed;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(245, 216, 122, 0.05) 0%, transparent 70%);
            top: -150px;
            right: -100px;
            pointer-events: none;
            z-index: 0;
            animation: floatBg 9s ease-in-out infinite;
        }

        .auth-page::after {
            content: '';
            position: fixed;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(26, 13, 8, 0.5) 0%, transparent 70%);
            bottom: -100px;
            left: -80px;
            pointer-events: none;
            z-index: 0;
            animation: floatBg 12s ease-in-out infinite reverse;
        }

        @@keyframes floatBg {
            0%, 100% {
                transform: translateY(0) scale(1);
            }

            50% {
                transform: translateY(25px) scale(1.04);
            }
        }

        /* ---------- 外層 Wrapper ---------- */
        .auth-wrapper {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 960px;
            display: flex;
            gap: 1.5rem;
            align-items: flex-start;
            justify-content: center;
        }

        /* ============================================================
           Demo 帳號選擇區塊
           ============================================================ */
        .demo-panel {
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(245, 216, 122, 0.12);
            border-radius: var(--card-radius);
            padding: 1.4rem;
            width: 230px;
            flex-shrink: 0;
            animation: slideInLeft 0.45s cubic-bezier(0.4, 0, 0.2, 1) both;
        }

        @@keyframes slideInLeft {
            from {
                opacity: 0;
                transform: translateX(-28px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }

        }

        .demo-panel-title {
            color: rgba(255, 255, 255, 0.45);
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            margin-bottom: 0.15rem;
        }

        .demo-panel-subtitle {
            color: rgba(255, 255, 255, 0.28);
            font-size: 0.67rem;
            margin-bottom: 0.9rem;
        }

        .demo-badge {
            display: inline-block;
            background: rgba(245, 216, 122, 0.12);
            border: 1px solid rgba(245, 216, 122, 0.3);
            color: var(--brand-gold-dim);
            font-size: 0.58rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 2px 8px;
            border-radius: 20px;
            margin-bottom: 0.9rem;
        }

        .demo-role-btn {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            width: 100%;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 7px;
            padding: 0.5rem 0.75rem;
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.78rem;
            font-family: var(--font-main);
            cursor: pointer;
            transition: var(--transition);
            margin-bottom: 0.35rem;
            text-align: left;
        }

        .demo-role-btn:hover {
            background: rgba(245, 216, 122, 0.1);
            border-color: rgba(245, 216, 122, 0.35);
            color: var(--brand-gold-light);
            transform: translateX(3px);
        }

        .demo-role-btn:last-child {
            margin-bottom: 0;
        }

        .demo-role-icon {
            width: 24px;
            height: 24px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.65rem;
            flex-shrink: 0;
            background: rgba(245, 216, 122, 0.15);
            color: var(--brand-gold);
        }

        .demo-role-name {
            display: block;
            font-weight: 600;
            font-size: 0.77rem;
            color: rgba(255, 255, 255, 0.88);
        }

        .demo-role-account {
            display: block;
            font-size: 0.64rem;
            color: rgba(255, 255, 255, 0.35);
            font-family: monospace;
        }

        /* ============================================================
           登入卡片
           ============================================================ */
        .auth-card {
            background: #fff;
            border-radius: var(--card-radius);
            box-shadow: var(--card-shadow);
            padding: 2.4rem 2.2rem;
            width: 100%;
            max-width: 420px;
            animation: slideInUp 0.45s cubic-bezier(0.4, 0, 0.2, 1) both;
            animation-delay: 0.08s;
        }

        @@keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(28px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ---------- Logo 區域 ---------- */
        .auth-logo {
            text-align: center;
            margin-bottom: 1.8rem;
        }

        .auth-logo-img {
            height: 64px;
            width: auto;
            margin-bottom: 0.6rem;
            display: block;
            margin-left: auto;
            margin-right: auto;
        }

        .auth-logo-sub {
            font-size: 0.75rem;
            color: var(--text-muted);
            font-weight: 400;
            letter-spacing: 0.04em;
            display: block;
            margin-top: 2px;
        }

        /* ---------- 卡片標題（非 Logo 版） ---------- */
        .auth-card-header {
            text-align: center;
            margin-bottom: 1.8rem;
        }

        .auth-card-icon {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.7rem;
            font-size: 1.3rem;
        }

        .auth-card-icon.gold {
            background: rgba(245, 216, 122, 0.15);
            color: var(--brand-gold-dim);
            border: 2px solid rgba(245, 216, 122, 0.3);
        }

        .auth-card-icon.green {
            background: rgba(25, 135, 84, 0.1);
            color: var(--success-color);
            border: 2px solid rgba(25, 135, 84, 0.25);
        }

        .auth-card-icon.red {
            background: rgba(220, 53, 69, 0.1);
            color: var(--danger-color);
            border: 2px solid rgba(220, 53, 69, 0.2);
        }

        .auth-card-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.3rem;
            line-height: 1.3;
        }

        .auth-card-desc {
            font-size: 0.82rem;
            color: var(--text-secondary);
            line-height: 1.65;
            margin-bottom: 0;
        }

        /* ---------- 分隔線 ---------- */
        .auth-divider {
            height: 1px;
            background: var(--border-color);
            margin: 1.2rem 0;
        }

        /* ============================================================
           表單元素
           ============================================================ */
        .auth-form-group {
            margin-bottom: 1rem;
        }

        .auth-label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.38rem;
        }

        .auth-input-wrap {
            position: relative;
        }

        .auth-input {
            width: 100%;
            padding: 0.65rem 1rem;
            border: 1.5px solid var(--border-color);
            border-radius: var(--input-radius);
            font-size: 0.88rem;
            font-family: var(--font-main);
            color: var(--text-primary);
            background: var(--input-bg);
            transition: var(--transition);
            outline: none;
        }

        .auth-input:focus {
            border-color: var(--brand-gold-dim);
            background: #fff;
            box-shadow: 0 0 0 3px var(--input-focus-ring);
        }

        .auth-input.is-invalid {
            border-color: var(--danger-color);
        }

        .auth-input.is-invalid:focus {
            box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.15);
        }

        .auth-input-wrap .auth-input {
            padding-right: 2.8rem;
        }

        .toggle-password {
            position: absolute;
            right: 0.85rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            padding: 0.2rem;
            line-height: 1;
            transition: var(--transition);
            font-size: 0.83rem;
        }

        .toggle-password:hover {
            color: var(--brand-gold-dim);
        }

        .auth-input-error {
            font-size: 0.74rem;
            color: var(--danger-color);
            margin-top: 0.28rem;
            display: none;
            align-items: center;
            gap: 0.3rem;
        }

        .auth-input-error.show {
            display: flex;
        }

        /* ============================================================
           按鈕
           ============================================================ */

        /* 主要：金色 */
        .btn-auth-primary {
            width: 100%;
            padding: 0.72rem 1.5rem;
            background: linear-gradient(135deg, var(--brand-gold) 0%, var(--brand-gold-dim) 100%);
            border: none;
            border-radius: var(--btn-radius);
            color: var(--brand-brown);
            font-size: 0.88rem;
            font-weight: 700;
            font-family: var(--font-main);
            letter-spacing: 0.03em;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 3px 12px rgba(245, 216, 122, 0.3);
            margin-top: 0.4rem;
        }

        .btn-auth-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 18px rgba(245, 216, 122, 0.4);
            background: linear-gradient(135deg, var(--brand-gold-light) 0%, var(--brand-gold) 100%);
        }

        .btn-auth-primary:active {
            transform: translateY(0);
            box-shadow: 0 2px 6px rgba(245, 216, 122, 0.25);
        }

        .btn-auth-primary:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            transform: none;
        }

        /* 次要：外框 */
        .btn-auth-secondary {
            width: 100%;
            padding: 0.68rem 1.5rem;
            background: transparent;
            border: 1.5px solid var(--border-color);
            border-radius: var(--btn-radius);
            color: var(--text-secondary);
            font-size: 0.86rem;
            font-weight: 600;
            font-family: var(--font-main);
            cursor: pointer;
            transition: var(--transition);
            margin-top: 0.4rem;
        }

        .btn-auth-secondary:hover {
            border-color: #adb5bd;
            color: var(--text-primary);
            background: rgba(0, 0, 0, 0.03);
        }

        /* 成功：綠色 */
        .btn-auth-success {
            width: 100%;
            padding: 0.72rem 1.5rem;
            background: linear-gradient(135deg, #198754 0%, #146c43 100%);
            border: none;
            border-radius: var(--btn-radius);
            color: #fff;
            font-size: 0.88rem;
            font-weight: 700;
            font-family: var(--font-main);
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 3px 12px rgba(25, 135, 84, 0.3);
            margin-top: 0.4rem;
        }

        .btn-auth-success:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 18px rgba(25, 135, 84, 0.4);
        }

        /* ============================================================
           忘記密碼連結
           ============================================================ */
        .auth-forgot-link {
            display: block;
            text-align: center;
            margin-top: 1rem;
            font-size: 0.79rem;
            color: var(--text-muted);
            text-decoration: none;
            transition: var(--transition);
            cursor: pointer;
            /* 新增：重置 button 預設樣式 */
            background: none;
            border: none;
            padding: 0;
            width: 100%;
            font-family: var(--font-main);
        }

        .auth-forgot-link:hover {
            color: var(--brand-gold-dim);
        }

        /* ============================================================
           警示訊息
           ============================================================ */
        .auth-alert {
            padding: 0.65rem 0.9rem;
            border-radius: 7px;
            font-size: 0.79rem;
            margin-bottom: 1rem;
            align-items: center;
            gap: 0.45rem;
            display: none;
        }

        .auth-alert.show {
            display: flex;
        }

        .auth-alert.danger {
            background: rgba(220, 53, 69, 0.08);
            border: 1px solid rgba(220, 53, 69, 0.22);
            color: #b02a37;
        }

        .auth-alert.success {
            background: rgba(25, 135, 84, 0.08);
            border: 1px solid rgba(25, 135, 84, 0.22);
            color: #146c43;
        }

        .auth-alert.info {
            background: rgba(245, 216, 122, 0.1);
            border: 1px solid rgba(245, 216, 122, 0.3);
            color: #8a6d1a;
        }

        /* ============================================================
           成功大圖示
           ============================================================ */
        .success-icon-large {
            width: 76px;
            height: 76px;
            background: linear-gradient(135deg, var(--brand-gold) 0%, var(--brand-gold-dim) 100%);
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: var(--brand-brown);
            margin-bottom: 1rem;
            box-shadow: 0 6px 20px rgba(245, 216, 122, 0.35);
            animation: popIn 0.38s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        }

        @@keyframes popIn {
            from {
                opacity: 0;
                transform: scale(0.5);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* ============================================================
           步驟進度條
           ============================================================ */
        .auth-progress {
            display: flex;
            align-items: center;
            margin-bottom: 1.8rem;
        }

        .auth-step {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 1;
            position: relative;
        }

        .auth-step-circle {
            width: 27px;
            height: 27px;
            border-radius: 50%;
            border: 2px solid var(--border-color);
            background: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.68rem;
            font-weight: 700;
            color: var(--text-muted);
            z-index: 1;
            transition: var(--transition);
        }

        .auth-step.active .auth-step-circle {
            border-color: var(--brand-gold-dim);
            background: var(--brand-gold);
            color: var(--brand-brown);
            box-shadow: 0 0 0 3px rgba(245, 216, 122, 0.2);
        }

        .auth-step.done .auth-step-circle {
            border-color: var(--success-color);
            background: var(--success-color);
            color: #fff;
        }

        .auth-step-label {
            font-size: 0.63rem;
            color: var(--text-muted);
            margin-top: 0.28rem;
            text-align: center;
            white-space: nowrap;
        }

        .auth-step.active .auth-step-label {
            color: var(--brand-gold-dim);
            font-weight: 600;
        }

        .auth-step-line {
            flex: 1;
            height: 2px;
            background: var(--border-color);
            margin-top: -14px;
            z-index: 0;
        }

        .auth-step-line.done {
            background: var(--success-color);
        }

        /* ============================================================
           密碼規則
           ============================================================ */
        .password-rules {
            background: #f8f9fa;
            border: 1px solid var(--border-color);
            border-radius: 7px;
            padding: 0.65rem 0.9rem;
            margin-top: 0.45rem;
            margin-bottom: 0.45rem;
            list-style: none;
        }

        .password-rules-title {
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--text-muted);
            margin-bottom: 0.3rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .password-rule {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.74rem;
            color: var(--text-muted);
            margin-bottom: 0.12rem;
            transition: var(--transition);
        }

        .password-rule.met {
            color: var(--success-color);
        }

        .password-rule i {
            font-size: 0.68rem;
            width: 12px;
        }

        /* ============================================================
           Email / 時間 Badge
           ============================================================ */
        .email-highlight {
            display: inline-block;
            background: rgba(245, 216, 122, 0.1);
            border: 1px solid rgba(245, 216, 122, 0.3);
            border-radius: 5px;
            padding: 2px 8px;
            color: #8a6d1a;
            font-weight: 600;
            font-size: 0.84rem;
        }

        .auth-time-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            background: rgba(25, 135, 84, 0.08);
            border: 1px solid rgba(25, 135, 84, 0.2);
            border-radius: 5px;
            padding: 3px 10px;
            color: var(--success-color);
            font-size: 0.74rem;
            font-weight: 600;
        }

        /* ============================================================
           載入動畫
           ============================================================ */
        .btn-loading {
            pointer-events: none;
            opacity: 0.75;
        }

        .spinner-sm {
            width: 13px;
            height: 13px;
            border: 2px solid rgba(26, 13, 8, 0.3);
            border-top-color: var(--brand-brown);
            border-radius: 50%;
            display: inline-block;
            animation: spin 0.55s linear infinite;
            margin-right: 0.4rem;
            vertical-align: middle;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ============================================================
           響應式
           ============================================================ */
        @@media (max-width: 768px) {
            .auth-wrapper {
                flex-direction: column;
                align-items: center;
            }

            .demo-panel {
                width: 100%;
                max-width: 420px;
                order: 2;
            }

            .auth-card {
                order: 1;
            }
        }

        @@media (max-width: 480px) {
            .auth-card {
                padding: 2rem 1.4rem;
            }
        }
    </style>
}

@section Scripts
{
    <script src="~/js/views/auth.js"></script>
