@model IEnumerable<EatTogether.Models.ViewModels.ArticleViewModel>
@{
    ViewData["Title"] = "文章列表";
}
@if (TempData["SuccessMessage"] != null)
{

    <!-- 成功 Modal -->
    <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-3"></i>
                    <p class="fs-5 mb-0">@TempData["SuccessMessage"]</p>
                </div>
                <div class="modal-footer border-0 justify-content-center pt-0">
                    <button type="button" class="btn btn-success px-4" data-bs-dismiss="modal">確定</button>
                </div>
            </div>
        </div>
    </div>
    }

}
<div class="container-fluid mt-4" style="max-width: 90%;">
    <h1>文章列表</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">首頁</a></li>
        <li class="breadcrumb-item active">文章列表</li>
    </ol>
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="m-0 font-weight-bold text-dark">
                <i class="bi bi-table me-2"></i>文章列表
            </h5>
            <button type="button" id="btnCreate" class="btn btn-success btn-sm">
                <i class="bi bi-plus-lg"></i> 撰寫新文章
            </button>
        </div>
        <div class="card-body w-100">
            <table id="ArticleTable" class="table w-100">
                <thead>
                    <tr>
                        <th>標題</th>
                        <th>文章分類</th>
                        <th>相關活動</th>
                        <th>置頂</th>
                        <th>上架日期</th>
                        <th>狀態</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
            $(document).ready(function() {
                        var el = document.getElementById('successModal');
                        if (el) {
                            new bootstrap.Modal(el).show();
                        }


                    $('#ArticleTable').DataTable({
                        ajax: {
                            type: "GET",
                            url: `/Articles/Index`,
                            dataSrc: ""
                        },
                        dom: '<"d-flex justify-content-between"f>t<"d-flex justify-content-between mt-3"ip>',
                        columns: [
                            { data: "title", width: "35%" },
                            { data: "categoryName", width: "10%"},
                            { data: "eventName", width: "20%" },
                            {
                                data: "isPinned",
                                width: "8%",
                                className: "text-center", // 讓圖示居中
                                render: function(data, type) {

                                    if (type === 'sort' || type === 'filter') {
                                        return data ? 1 : 0;
                                    }
                                    if (data) {
                                     return '<span class="p-1 px-2 rounded text-dark fs-4" title="啟用">' +'<i class="fa-solid fa-square-check"></i></span>';
                                    } else {
                                     return '<span class="p-1 px-2 rounded text-secondary fs-4" title="停用">' +'<i class="fa-solid fa-square"></i></span>';
                                    }

                                }
                            },
                            { data: "publishDate", width: "12%",
                                 render: function(data) {
                                 if (!data) return '';
                                 return data.substring(0, 10).replace(/-/g, '/');  // "2026/05/01"
                             }
                            },
                            {
                                data: "status",
                                width: "8%",
                                render: function(data) {
                                    if (data === 1) return '<span class="badge bg-success">已發佈</span>';
                                    if (data === 2) return '<span class="badge bg-dark">已下架</span>';
                                    return '<span class="badge bg-secondary">草稿</span>';
                                }
                            },
                            {
                                data: "id",
                                width: "7%",
                                className: "text-center",
                                orderable: false, //這一欄不需要排序功能
                                render: function(data) {
                                    return `
                                  <button type="button" class="btn-edit btn btn-outline-dark btn-sm px-3" data-id="${data}">
                                            <i class="bi bi-pencil-square me-1"></i> 編輯
                                        </button>
                                    `;
                                }
                            }
                        ],
                        fixedHeader:{
                            header:true
                        },
                        paging: true,
                        pageLength: 10,
                        language: {
                            url: '//cdn.datatables.net/plug-ins/1.13.1/i18n/zh-HANT.json',
                        }
                    })


                    // 撰寫新文章按鈕
                    $('#btnCreate').on('click', function() {
                        window.location.href = '/Articles/Create';
                    });

                    // 查看按鈕（用事件委派，因為是動態產生的）
                    $('#ArticleTable').on('click', '.btn-edit', function() {
                        var id = $(this).data('id');
                        window.location.href = `/Articles/Edit/${id}`;
                    });













           })



    </script>
    
}