@model EatTogether.Models.ViewModels.ArticleCreateViewModel

@{
    ViewData["Title"] = "文章新增";
}

@section Styles{
    <style>
        /* 設定預覽容器的固定尺寸 */
        .image-preview-wrapper {
            width: 100%; /* 寬度撐滿父容器 (col-md-6) */
            max-width: 300px; 
            height: 200px;
        }

        /* 設定圖片的縮放方式 */
        #imagePreview {
            width: 100%;
            height: 100%;
            /* 關鍵：圖片會填滿容器，多餘的會被裁切，保持比例不變形 */
            object-fit: cover;
            /* 關鍵：如果是透明底的圖片，確保背景一致 */
            background-color: #fff;
        }
    </style>

}

<div class="container-fluid mt-4" style="max-width: 90%;">
    <h1>文章新增</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">首頁</a></li>
        <li class="breadcrumb-item">文章管理</li>
        <li class="breadcrumb-item active">文章新增</li>
    </ol>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="articleForm" >
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="m-0 font-weight-bold text-dark"><i class="bi bi-pencil-square me-2"></i>撰寫文章</h5>
            </div>

            <div class="card-body">
                <div class="row mb-3 align-items-start">
                    <div class="col-md-4">
                        <label asp-for="CategoryId" class="form-label">類別</label>
                        <select asp-for="CategoryId" asp-items="Model.CategorySelectList" class="form-select">
                            <option value="">-- 請選擇類別 --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EventId" class="form-label">活動</label>
                        <select asp-for="EventId" asp-items="Model.EventSelectList" class="form-select">
                            <option value="">-- 不關聯活動 --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="d-none d-md-block">&nbsp;</label>
                        <div class="form-check form-switch pt-2">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="IsPinned">
                            <label class="form-check-label" asp-for="IsPinned">置頂文章</label>
                            <span asp-validation-for="IsPinned" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <input type="hidden" id="Status" name="Status" value="0" />
                    <label asp-for="Title" class="form-label">標題</label>
                    <input asp-for="Title" class="form-control" placeholder="請輸入文章標題" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">內文</label>
                    <input type="hidden" asp-for="Description" id="hiddenDescription" data-val="false" />
                    <div id="editor" style="height: 400px;">
                        @Html.Raw(Model.Description)
                    </div>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="CoverImageFile" class="form-label">上傳封面圖片</label>
                        <input asp-for="CoverImageFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="CoverImageFile" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label d-block">圖片預覽</label>
                        <div class="image-preview-wrapper border rounded bg-light d-flex align-items-center justify-content-center overflow-hidden">
                            <img id="imagePreview" src="#" alt="預覽圖" style="display:none;" />
                            <div id="previewPlaceholder" class="text-muted text-center p-3">
                                <i class="bi bi-image fs-1 d-block mb-2"></i>
                                <span>選取檔案後顯示預覽</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="PublishDate" class="form-label">上架日期</label>
                        <input asp-for="PublishDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="PublishDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="ExpiryDate" class="form-label">下架日期</label>
                        <input asp-for="ExpiryDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
            </div>


            <div class="card-footer bg-light d-flex justify-content-end gap-2 py-3">

                <!-- Split Button -->
                <div class="btn-group">
                    <button type="button" id="btnPublish" class="btn btn-primary px-4">
                        發佈 <i class="bi bi-send-fill ms-1"></i>
                    </button>
                    <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown">
                        <span class="visually-hidden">Toggle Dropdown</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <button type="button" id="btnSaveDraft" class="dropdown-item">
                                <i class="bi bi-file-earmark me-1"></i>存成草稿
                            </button>
                        </li>
                    </ul>
                </div>

                <a asp-action="Index" class="btn btn-secondary px-4">取消</a>
            </div>

        </div>


        <!-- 日期錯誤提示 Modal -->
        <div class="modal fade" id="dateErrorModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header border-0 pb-0">
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center py-4">
                        <i class="bi bi-exclamation-circle-fill text-warning fs-1 d-block mb-3"></i>
                        <p class="fs-5 mb-0">下架日期不能早於上架日期</p>
                    </div>
                    <div class="modal-footer border-0 justify-content-center pt-0">
                        <button type="button" class="btn btn-warning px-4" data-bs-dismiss="modal">確定</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 置頂上限提示 Modal -->
        <div class="modal fade" id="pinnedErrorModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header border-0 pb-0">
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center py-4">
                        <i class="bi bi-pin-angle-fill text-warning fs-1 d-block mb-3"></i>
                        <p class="fs-5 mb-0" id="pinnedErrorMessage"></p>
                    </div>
                    <div class="modal-footer border-0 justify-content-center pt-0">
                        <button type="button" class="btn btn-warning px-4" data-bs-dismiss="modal">確定</button>
                    </div>
                </div>
            </div>
        </div>


    </form>
</div>


@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

    <script>

        $(document).ready(function () {
            $.validator.setDefaults({ ignore: [] });

            // 初始化 Quill
            var quill = new Quill('#editor', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ 'size': ['small', false, 'large', 'huge'] }],
                        ['bold', 'italic', 'underline'],
                        [{ 'color': [] }, { 'background': [] }],
                        ['link'],
                        ['clean']
                    ]
                }
            });


            function syncQuill() {
                var content = quill.root.innerHTML;
                if (content === '<p><br></p>' || content === '<p></p>') content = '';
                $('#hiddenDescription').val(content);
            }


            function handleFormSubmit(statusValue) {

                // 日期驗證（下架日期選填，但若有填則不能早於上架日期）
                var publishDate = $('input[name="PublishDate"]').val();
                var expiryDate = $('input[name="ExpiryDate"]').val();

                if (publishDate && expiryDate && expiryDate < publishDate) {
                    new bootstrap.Modal(document.getElementById('dateErrorModal')).show();
                    return; // 阻止送出
                }

                $('#Status').val(statusValue);
                syncQuill();

                // 統一驗證：沒填完就不准送出
                if ($('#articleForm').valid()) {
                    $('#articleForm').submit();}              
            }

            $('#btnPublish').on('click', function () {
                handleFormSubmit(1);
            });

            $('#btnSaveDraft').on('click', function () {
                handleFormSubmit(0);
            });


            // 新增：圖片預覽函式
            function previewImage(input) {
                const preview = $('#imagePreview');
                const placeholder = $('#previewPlaceholder');

                if (input.files && input.files[0]) {
                    var reader = new FileReader();

                    reader.onload = function (e) {
                        preview.attr('src', e.target.result).show(); // 載入圖片並顯示
                        placeholder.hide(); // 隱藏佔位區塊
                    };

                    reader.readAsDataURL(input.files[0]); // 讀取檔案
                } else {
                    // 如果取消選取，恢復原狀
                    preview.attr('src', '#').hide();
                    placeholder.show();
                }
            }

            // 監聽圖片上傳變更
            $('input[name="CoverImageFile"]').on('change', function() {
                previewImage(this);
            });


            // 置頂數量偵測
            $('input[name="IsPinned"]').on('change', async function () {
            if (!this.checked) return;

            const res = await fetch('@Url.Action("GetPinnedCount", "Articles")');
            const data = await res.json();

            if (!data.available) {
                this.checked = false;
                document.getElementById('pinnedErrorMessage').textContent =
                    `目前已有 ${data.count} 篇文章置頂（上限 3 篇），請先取消其他文章的置頂。`;
                new bootstrap.Modal(document.getElementById('pinnedErrorModal')).show();
                    }
            });



            // 展示資料按鈕
            var $demoBtn = $('<button type="button" class="btn btn-outline-secondary btn-sm ms-auto">📋 填入示範資料</button>');
            $('.card-footer').append($demoBtn);

            $demoBtn.on('click', function () {
                // 選第一個類別選項（跳過空白）
                $('#CategoryId option:not([value=""])').first().prop('selected', true);

                // 標題
                $('input[name="Title"]').val('2026夏季義式饗宴活動開跑！');

                // 內文（用 Quill API 寫入）
                quill.setText('「義起吃」義式餐廳夏季限定活動正式登場！夏日炎炎，最適合與家人、朋友一同走進義起吃，感受道地義大利料理帶來的南歐風情。本次活動期間，我們特別推出期間限定菜色，包含主廚精選海鮮燉飯、香濃松露奶油義大利麵、現烤薄脆拿坡里披薩，以及夏日限定提拉米蘇甜點組合，每一道都由餐廳主廚親自調配，使用新鮮食材每日現製，絕不妥協。活動期間凡單筆消費滿額，即可享有專屬折扣優惠或精選贈品，讓您吃得盡興又划算。無論是商務聚餐、家庭聚會還是浪漫約會，義起吃都能為您打造難忘的用餐體驗。名額有限，歡迎提早預約，把握這個夏天最美味的相遇，我們在義起吃等您！');

                // 日期
                $('input[name="PublishDate"]').val('2026-05-13');
                $('input[name="ExpiryDate"]').val('2026-05-15');
            });

        })

    </script>
}