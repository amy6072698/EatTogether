@model EatTogether.Models.ViewModels.DishViewModel
@{
    ViewData["Title"] = "編輯餐點資料";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">編輯餐點資料</h1>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom py-3">
            <span class="fw-bold fs-5"><i class="fas fa-edit me-2 text-primary"></i>餐點詳情編輯</span>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>返回列表
            </a>
        </div>
        <div class="card-body p-4">
            <form method="post" enctype="multipart/form-data" asp-action="Edit" asp-route-id="@Model.Id" id="editForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />
                <input type="hidden" id="croppedImageData" name="CroppedImageData" />

                <div class="row">
                    <div class="col-lg-7">
                        <div class="row g-4">
                            <div class="col-md-12">
                                <label class="form-label fw-bold">餐點名稱 <span class="text-danger">*</span></label>
                                <input asp-for="DishName" class="form-control form-control-lg shadow-sm" />
                                <span asp-validation-for="DishName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">餐點類別 <span class="text-danger">*</span></label>
                                <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select shadow-sm">
                                    <option value="">請選擇類別</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">價格 <span class="text-danger">*</span></label>
                                <div class="input-group shadow-sm">
                                    <span class="input-group-text bg-light">$</span>
                                    <input asp-for="Price" class="form-control" min="0" />
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold">餐點介紹</label>
                                <textarea asp-for="Description" class="form-control shadow-sm" rows="5"></textarea>
                            </div>

                            <div class="col-md-12">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="row align-items-center">
                                        <div class="col-md-6">
                                            <div class="form-check form-switch">
                                                <input asp-for="IsLimited" class="form-check-input" type="checkbox" role="switch" onchange="toggleDateRange()">
                                                <label class="form-check-label fw-bold" asp-for="IsLimited">限定供應</label>
                                            </div>
                                            <div id="dateRange" class="mt-3 @(Model.IsLimited ? "" : "d-none")">
                                                <div class="input-group input-group-sm">
                                                    <input asp-for="StartDate" type="date" class="form-control" />
                                                    <span class="input-group-text">~</span>
                                                    <input asp-for="EndDate" type="date" class="form-control" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <input asp-for="IsTakeOut" class="form-check-input" id="takeout-check" />
                                                <label class="form-check-label fw-bold" for="takeout-check" style="cursor: pointer;">可外帶</label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <input asp-for="IsActive" class="form-check-input" id="active-check" />
                                                <label class="form-check-label fw-bold" for="active-check" style="cursor: pointer;">上架中</label>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 特色標籤挑選 -->
                                    <div class="row mt-3 border-top pt-3">
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <input asp-for="IsRecommended" class="form-check-input" id="recommend-check" />
                                                <label class="form-check-label fw-bold text-primary" for="recommend-check" style="cursor: pointer;">
                                                    <i class="fas fa-thumbs-up me-1"></i>主廚推薦
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <input asp-for="IsPopular" class="form-check-input" id="popular-check" />
                                                <label class="form-check-label fw-bold text-warning" for="popular-check" style="cursor: pointer;">
                                                    <i class="fas fa-crown me-1"></i>人氣商品
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-check">
                                                <input asp-for="IsVegetarian" class="form-check-input" id="veg-check" />
                                                <label class="form-check-label fw-bold text-success" for="veg-check" style="cursor: pointer;">
                                                    <i class="fas fa-leaf me-1"></i>素食可
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold">辣度等級</label>
                                            <select asp-for="SpicyLevel" class="form-select form-select-sm">
                                                <option value="0">不辣</option>
                                                <option value="1">小辣</option>
                                                <option value="2">中辣</option>
                                                <option value="3">大辣</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5 ps-lg-5 mt-4 mt-lg-0">
                        <label class="form-label fw-bold d-block mb-3">商品圖片展示</label>

                        <div id="imageFrame" class="position-relative border rounded-4 bg-white shadow-sm overflow-hidden"
                             style="aspect-ratio: 4/3; border: 2px dashed #cbd5e0 !important;">

                            <div id="displayArea" class="w-100 h-100 @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")" style="cursor: pointer;" onclick="editOrUploadImage()">
                                <img id="currentImg" src="@(Model.ImageUrl ?? "")"
                                     class="w-100 h-100"
                                     style="object-fit: cover; display: block;"
                                     onerror="this.src='/images/no-image.png'; this.onerror=null;" />
                                <div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-50 text-white text-center py-2">
                                    <i class="fas fa-camera me-1"></i> 點擊更換或重新裁切 (支援拖曳)
                                </div>
                            </div>

                            <div id="emptyArea" class="w-100 h-100 d-flex flex-column align-items-center justify-content-center"
                                 style="cursor: pointer; @(string.IsNullOrEmpty(Model.ImageUrl) ? "" : "display:none!important;")"
                                 onclick="editOrUploadImage()">
                                <i class="fas fa-cloud-upload-alt fa-3x text-primary mb-3"></i>
                                <span class="text-muted fw-bold">拖曳圖片至此裁切</span>
                            </div>

                            <div id="cropperArea" class="w-100 h-100 d-none" style="background-color: #eee;">
                                <img id="cropperImg" src="" style="display: block; max-width: 100%;">
                            </div>
                        </div>

                        <div class="mt-2 text-end">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('realInput').click()">
                                <i class="fas fa-upload me-1"></i> 更換圖片
                            </button>
                        </div>

                        <div id="cropControls" class="mt-3 d-none">
                            <div class="row g-2">
                                <div class="col-6">
                                    <button type="button" class="btn btn-primary w-100 fw-bold shadow-sm" onclick="saveCrop()">
                                        <i class="fas fa-check-circle me-1"></i> 確定位置
                                    </button>
                                </div>
                                <div class="col-6">
                                    <button type="button" class="btn btn-outline-danger w-100 fw-bold shadow-sm" onclick="cancelCrop()">
                                        取消
                                    </button>
                                </div>
                            </div>
                            <div class="text-center mt-2">
                                <small class="text-primary fw-bold"><i class="fas fa-arrows-alt me-1"></i> 請拖曳圖片對準框架</small>
                                <small class="text-muted d-block" style="font-size: 0.7rem;">(可用滑鼠滾輪縮放圖片大小)</small>
                            </div>
                        </div>

                        <input type="file" id="realInput" class="d-none" accept="image/*" onchange="onFileChange(this)" />

                        <div class="mt-5 pt-3 border-top x-small text-secondary">
                            <p class="mb-1">建立日期：@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</p>
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <p class="mb-0">上次更新：@Model.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")</p>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-4 border-top d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow fw-bold">
                        <i class="fas fa-save me-2"></i>更新餐點資訊
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
    <style>
        #imageFrame.drag-over {
            border-color: #0d6efd !important;
            background: #f8fbff;
        }

        .x-small {
            font-size: 0.8rem;
        }
        /* 隱藏裁切框的四個角控制點，讓它看起來不能縮放 */
        .cropper-line, .cropper-point {
            display: none !important;
        }

        .cropper-view-box {
            outline: 2px solid #0d6efd;
            outline-opacity: 0.7;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>

    <script>
        let myCropper = null;
        const realInput = document.getElementById("realInput");
        const displayArea = document.getElementById("displayArea");
        const emptyArea = document.getElementById("emptyArea");
        const cropperArea = document.getElementById("cropperArea");
        const cropperImg = document.getElementById("cropperImg");
        const currentImg = document.getElementById("currentImg");
        const cropControls = document.getElementById("cropControls");
        const frame = document.getElementById("imageFrame");

        function toggleDateRange() {
            const isChecked = document.getElementById("IsLimited").checked;
            document.getElementById("dateRange").classList.toggle("d-none", !isChecked);
        }

        // --- Main Image Handling Logic ---

        function editOrUploadImage() {
            const hasExistingImage = currentImg.src && !currentImg.src.includes('no-image.png') && !displayArea.classList.contains('d-none');
            if (hasExistingImage) {
                // If an image exists, load it into the cropper for re-cropping
                openCropperWithUrl(currentImg.src);
            } else {
                // Otherwise, open the file dialog for a new upload
                realInput.click();
            }
        }

        function openCropperWithUrl(url) {
            displayArea.classList.add("d-none");
            emptyArea.classList.add("d-none");
            cropperArea.classList.remove("d-none");
            cropControls.classList.remove("d-none");

            cropperImg.src = url;

            cropperImg.onload = function() {
                if (myCropper) myCropper.destroy();
                myCropper = new Cropper(cropperImg, {
                    aspectRatio: 4 / 3,
                    viewMode: 1,
                    dragMode: 'move',
                    autoCropArea: 1,
                    background: false,
                    responsive: true,
                    restore: false,
                    guides: false,
                    center: false,
                    highlight: false,
                    cropBoxMovable: false,
                    cropBoxResizable: false,
                    toggleDragModeOnDblclick: false,
                });
                cropperImg.onload = null;
            };
            if (cropperImg.complete) cropperImg.onload();
        }

        function processFile(file) {
            if (!file || !file.type.startsWith("image/")) return;
            const reader = new FileReader();
            reader.onload = (e) => openCropperWithUrl(e.target.result);
            reader.readAsDataURL(file);
        }

        function onFileChange(input) {
            if (input.files && input.files[0]) {
                processFile(input.files[0]);
            }
        }

        function saveCrop() {
            if (!myCropper) return;
            const canvas = myCropper.getCroppedCanvas({ width: 800, height: 600, imageSmoothingQuality: 'high' });
            const dataUrl = canvas.toDataURL("image/jpeg", 0.9);
            document.getElementById("croppedImageData").value = dataUrl;
            currentImg.src = dataUrl;
            currentImg.onerror = () => { this.src='/images/no-image.png'; this.onerror=null; };
            exitCropper();
        }

        function cancelCrop() {
            exitCropper();
        }

        function exitCropper() {
            if (myCropper) {
                myCropper.destroy();
                myCropper = null;
            }
            cropperArea.classList.add("d-none");
            cropControls.classList.add("d-none");

            const hasImage = currentImg.src
                && !currentImg.src.endsWith("/")
                && !currentImg.src.includes("no-image.png")
                && currentImg.src !== window.location.href;
            if (hasImage) {
                displayArea.classList.remove("d-none");
                emptyArea.style.display = "none";
            } else {
                emptyArea.style.display = "";
                displayArea.classList.add("d-none");
            }
        }

        // --- Drag and Drop ---
        frame.addEventListener("dragover", e => { e.preventDefault(); frame.classList.add("drag-over"); });
        frame.addEventListener("dragleave", () => { frame.classList.remove("drag-over"); });
        frame.addEventListener("drop", e => {
            e.preventDefault();
            frame.classList.remove("drag-over");
            if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                processFile(e.dataTransfer.files[0]);
            }
        });
    </script>
}
