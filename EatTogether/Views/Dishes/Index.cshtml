@model IEnumerable<EatTogether.Models.ViewModels.DishViewModel>
@{
    ViewData["Title"] = "餐點管理";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">餐點管理</h1>

    <!-- 統計卡片 -->
    <div class="row mb-4">
        <div class="col-xl-4 col-md-4">
            <div class="card bg-primary text-white mb-4 shadow-sm border-0 stat-card" onclick="filterByStatus('')" title="點擊顯示所有餐點">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="small text-white-50 fw-bold">總餐點數</div>
                        <div class="h3 mb-0 fw-bold">@Model.Count()</div>
                    </div>
                    <i class="fas fa-utensils fa-2x text-white-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-4">
            <div class="card bg-success text-white mb-4 shadow-sm border-0 stat-card" onclick="filterByStatus('上架中')" title="點擊篩選上架中餐點">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="small text-white-50 fw-bold">上架中</div>
                        <div class="h3 mb-0 fw-bold">@Model.Count(d => d.IsActive)</div>
                    </div>
                    <i class="fas fa-check-circle fa-2x text-white-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-4">
            <div class="card bg-secondary text-white mb-4 shadow-sm border-0 stat-card" onclick="filterByStatus('已下架')" title="點擊篩選已下架餐點">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="small text-white-50 fw-bold">已下架</div>
                        <div class="h3 mb-0 fw-bold">@Model.Count(d => !d.IsActive)</div>
                    </div>
                    <i class="fas fa-ban fa-2x text-white-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div id="alertBox"></div>

    <!-- 搜尋與篩選區 -->
    <div class="card mb-3 shadow-sm border-0">
        <div class="card-body bg-light rounded">
            <div class="row g-3 align-items-center">
                <div class="col-xl-3 col-lg-2 col-md-4">
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="searchInput" class="form-control border-start-0"
                               placeholder="搜尋餐點名稱..." oninput="filterCards(true)" />
                    </div>
                </div>
                <div class="col-xl-2 col-lg-2 col-md-4">
                    <select id="categoryFilter" class="form-select shadow-sm" onchange="filterCards(true)">
                        <option value="">所有類別</option>
                        @foreach (var cat in Model.Select(d => d.CategoryName).Distinct().OrderBy(c => c))
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-xl-2 col-lg-2 col-md-4">
                    <select id="statusFilter" class="form-select shadow-sm" onchange="filterCards(true)">
                        <option value="">所有狀態</option>
                        <option value="上架中">上架中</option>
                        <option value="已下架">已下架</option>
                    </select>
                </div>
                <div class="col-xl-2 col-lg-2 col-md-6">
                    <button id="toggleSortBtn" class="btn btn-outline-secondary w-100 shadow-sm" onclick="toggleSortMode()">
                        <i class="fas fa-arrows-alt me-1"></i>調整排序
                    </button>
                </div>
                <div class="col-xl-3 col-lg-4 col-md-6 text-end d-flex justify-content-end align-items-center gap-2">
                    <nav id="topPaginationWrapper" class="d-none d-lg-block">
                        <ul class="pagination pagination-sm mb-0 shadow-sm" id="topPagination"></ul>
                    </nav>
                    <a asp-action="Create" class="btn btn-primary shadow-sm px-4 rounded-pill text-nowrap">
                        <i class="fas fa-plus me-1"></i>新增餐點
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 【新功能】批次操作列 -->
    <div id="batchBar" class="alert alert-info border-0 shadow-sm d-none mb-3 d-flex align-items-center gap-3 flex-wrap" role="alert">
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="selectAllCheck" onchange="toggleSelectAll(this.checked)">
            <label class="form-check-label fw-bold" for="selectAllCheck">全選</label>
        </div>
        <span class="text-muted">已選 <strong id="selectedCount">0</strong> 筆</span>
        <div class="ms-auto d-flex gap-2 flex-wrap">
            <button class="btn btn-sm btn-outline-success rounded-pill px-3" onclick="batchEnable()">
                <i class="fas fa-check-circle me-1"></i>批次上架
            </button>
            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="batchDisable()">
                <i class="fas fa-power-off me-1"></i>批次下架
            </button>
            <button class="btn btn-sm btn-danger rounded-pill px-3" onclick="batchDelete()">
                <i class="fas fa-trash me-1"></i>批次刪除
            </button>
            <button class="btn btn-sm btn-outline-secondary rounded-pill" onclick="exitBatchMode()">
                取消
            </button>
        </div>
    </div>

    <!-- 排序模式提示列 -->
    <div id="sortModeBar" class="alert alert-warning border-0 shadow-sm d-none mb-3 d-flex align-items-center gap-3" role="alert">
        <i class="fas fa-info-circle fa-lg"></i>
        <div>
            <strong>排序模式已開啟</strong>：請拖曳卡片調整順序，完成後點擊右側儲存按鈕。
        </div>
        <div class="ms-auto d-flex gap-2">
            <button class="btn btn-sm btn-primary rounded-pill px-4 shadow-sm" onclick="saveOrder()">
                <i class="fas fa-save me-1"></i>儲存排序
            </button>
            <button class="btn btn-sm btn-outline-secondary rounded-pill" onclick="toggleSortMode()">
                取消
            </button>
        </div>
    </div>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body p-4 bg-light bg-opacity-10">

            <!-- 操作模式切換按鈕 -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <small class="text-muted">
                    <i class="fas fa-info-circle me-1"></i>
                    <span>點擊「批次操作」可多選進行大量狀態變更</span>
                </small>
                <button id="batchModeBtn" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="enterBatchMode()">
                    <i class="fas fa-tasks me-1"></i>批次操作
                </button>
            </div>

            <!-- 餐點展示區域 -->
            <div class="row g-4" id="dishCardContainer">
                @foreach (var item in Model)
                {
                    <div class="col-6 col-md-4 col-lg-3 dish-card"
                         data-id="@item.Id"
                         data-category="@item.CategoryName"
                         data-name="@item.DishName.ToLower()"
                         data-order="@item.DisplayOrder">
                        <div class="card h-100 border-0 shadow-sm dish-card-inner position-relative">

                            <!-- 拖曳把手 -->
                            <div class="drag-handle position-absolute top-0 end-0 p-2 d-none" style="z-index:20; cursor:move;">
                                <i class="fas fa-grip-vertical fa-lg text-secondary opacity-50"></i>
                            </div>

                            <!-- 批次勾選框 -->
                            <div class="batch-check position-absolute top-0 start-0 p-2 d-none" style="z-index:20;">
                                <div class="form-check">
                                    <input class="form-check-input card-checkbox shadow" type="checkbox"
                                           data-id="@item.Id" onchange="updateSelectedCount()">
                                </div>
                            </div>

                            <div class="position-relative overflow-hidden" style="padding-top:75%; background:#fff;">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl"
                                         style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; object-position: center center;"
                                         alt="@item.DishName"
                                         onerror="this.src='/images/no-image.png'; this.onerror=null;" />
                                }
                                else
                                {
                                    <div style="position:absolute; top:0; left:0; width:100%; height:100%; display:flex; align-items:center; justify-content:center;" class="bg-light text-muted">
                                        <i class="fas fa-image fa-3x opacity-25"></i>
                                    </div>
                                }
                            </div>
                            <div class="card-body p-3 text-center position-relative">
                                <!-- 左上角：特色標籤顯示區 (純顯示) -->
                                <div class="position-absolute top-0 start-0 p-2 d-flex gap-1" style="z-index: 10; margin-top: -45px;">
                                    @if (item.IsRecommended)
                                    {
                                        <div class="bg-white rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                                             style="width:34px; height:34px; border: 2px solid #0d6efd;">
                                            <i class="fas fa-thumbs-up text-primary"></i>
                                        </div>
                                    }
                                    @if (item.IsPopular)
                                    {
                                        <div class="bg-white rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                                             style="width:34px; height:34px; border: 2px solid #ffc107;">
                                            <i class="fas fa-crown text-warning"></i>
                                        </div>
                                    }
                                </div>

                                <h6 class="card-title mb-1 fw-bold text-truncate" title="@item.DishName">@item.DishName</h6>
                                <div class="text-muted small mb-2 d-flex justify-content-center align-items-center gap-2">
                                    <span><i class="fas fa-tag me-1 small"></i>@item.CategoryName</span>
                                    @if (item.IsVegetarian)
                                    {
                                        <span class="text-success"><i class="fas fa-leaf me-1"></i>素食</span>
                                    }
                                    @if (item.SpicyLevel > 0)
                                    {
                                        <span class="text-danger">
                                            @for (int i = 0; i < item.SpicyLevel; i++)
                                            {
                                                <i class="fas fa-pepper-hot"></i>
                                            }
                                        </span>
                                    }
                                </div>
                                <div class="mb-3">
                                    <span class="fw-bold text-danger fs-5">$@item.Price</span>
                                </div>
                                <div class="d-flex justify-content-center flex-wrap gap-1 mb-3">
                                    <span class="badge rounded-pill @(item.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") px-2 border @(item.IsActive ? "border-success" : "border-secondary")"
                                          style="cursor:pointer;" onclick="toggleFeature(@item.Id, 'Active')" id="active-badge-@item.Id">
                                        @(item.IsActive ? "上架中" : "已下架")
                                    </span>
                                    @if (item.IsTakeOut)
                                    {
                                        <span class="badge rounded-pill bg-info-subtle text-info px-2 border border-info">外帶</span>
                                    }
                                    @if (item.IsLimited)
                                    {
                                        <span class="badge rounded-pill bg-warning-subtle text-warning px-2 border border-warning">限定</span>
                                    }
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm flex-fill fw-bold shadow-sm">
                                        <i class="fas fa-edit me-1"></i>編輯
                                    </a>
                                    <button class="btn btn-outline-danger btn-sm px-2" onclick="disableDish(@item.Id)">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="fas fa-utensils fa-3x mb-3 opacity-25"></i>
                    <p>目前尚無餐點資料</p>
                </div>
            }

            <!-- 底部控制項 -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-5 pt-3 border-top gap-3">
                <div class="text-muted small fw-bold" id="pageInfo"></div>
                <nav>
                    <ul class="pagination pagination-sm mb-0 shadow-sm" id="pagination"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .stat-card {
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
            }

        .dish-card-inner {
            transition: all 0.2s ease-in-out;
            border: 1px solid transparent !important;
        }

            .dish-card-inner:hover {
                transform: translateY(-8px);
                box-shadow: 0 1rem 2rem rgba(0,0,0,0.12) !important;
                border-color: #0d6efd !important;
            }

        .page-link {
            cursor: pointer;
            color: #495057;
            border-radius: 4px !important;
            margin: 0 2px;
        }

        .pagination .page-item.active .page-link {
            background-color: #0d6efd;
            border-color: #0d6efd;
            color: #fff;
        }

        .badge {
            font-weight: 600;
            font-size: 0.7rem;
        }

        /* 批次模式 */
        #dishCardContainer.batch-mode .batch-check {
            display: block !important;
        }

        #dishCardContainer.batch-mode .dish-card-inner {
            cursor: pointer;
        }

        #dishCardContainer.batch-mode .dish-card.selected .dish-card-inner {
            border: 2px solid #0d6efd !important;
            box-shadow: 0 0 0 3px rgba(13,110,253,.18) !important;
        }

        .card-checkbox {
            width: 1.2em;
            height: 1.2em;
            cursor: pointer;
        }

        /* 排序模式 */
        #dishCardContainer.sort-mode .drag-handle {
            display: block !important;
        }

        #dishCardContainer.sort-mode .dish-card-inner {
            border: 1px dashed #ffc107 !important;
        }

        .sortable-ghost {
            opacity: 0.4;
            background: #fff3cd !important;
            border: 2px dashed #ffc107 !important;
        }

        .sortable-chosen {
            box-shadow: 0 1rem 3rem rgba(0,0,0,0.175) !important;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script>
        const PAGE_SIZE = 12;
        let currentPage = 1;
        let filteredCards = [];
        let isBatchMode = false;
        let isSortMode = false;
        let sortableInstance = null;

        document.addEventListener("DOMContentLoaded", () => {
            const savedPage = sessionStorage.getItem("dish_currentPage");
            const savedCategory = sessionStorage.getItem("dish_category");
            const savedSearch = sessionStorage.getItem("dish_search");
            const savedStatus = sessionStorage.getItem("dish_status");
            const savedScrollPosition = sessionStorage.getItem("dish_scrollPosition");

            if (savedCategory) document.getElementById("categoryFilter").value = savedCategory;
            if (savedSearch) document.getElementById("searchInput").value = savedSearch;
            if (savedStatus) document.getElementById("statusFilter").value = savedStatus;
                    const isNewDish = new URLSearchParams(window.location.search).get("newDish");
                        if (isNewDish) {
                            sessionStorage.removeItem("dish_currentPage");
                            currentPage = 1;
                        } else {
                            if (savedPage) currentPage = parseInt(savedPage);
                        }

            filterCards(false);

            if (savedScrollPosition) {
                window.scrollTo(0, parseInt(savedScrollPosition));
                sessionStorage.removeItem("dish_scrollPosition"); // Clean up
            }

            // Bug 2 Fix: Moved and updated this listener
            document.querySelectorAll('a[href*="/Dishes/Edit"], a[href*="/Dishes/Create"]').forEach(link => {
                link.addEventListener('click', () => {
                    sessionStorage.setItem('dish_scrollPosition', window.scrollY);
                });
            });
        });


        function filterCards(resetPage = true) {
            const category = document.getElementById("categoryFilter").value;
            const search = document.getElementById("searchInput").value.toLowerCase();
            const status = document.getElementById("statusFilter").value;

            sessionStorage.setItem("dish_category", category);
            sessionStorage.setItem("dish_search", search);
            sessionStorage.setItem("dish_status", status);

            filteredCards = Array.from(document.querySelectorAll(".dish-card")).filter(card => {
                const matchCategory = !category || card.dataset.category === category;
                const matchSearch = !search || card.dataset.name.includes(search);

                let matchStatus = true;
                if (status) {
                    const statusText = card.querySelector("#active-badge-" + card.dataset.id).textContent.trim();
                    matchStatus = (statusText === status);
                }

                return matchCategory && matchSearch && matchStatus;
            });
            
            // 確保最新新增的餐點（ID 較大）顯示在最前面
            filteredCards.sort((a, b) => parseInt(b.dataset.id) - parseInt(a.dataset.id));

            if (resetPage) currentPage = 1;
            renderPage();
        }

        function renderPage() {
            const allCards = Array.from(document.querySelectorAll(".dish-card"));
            allCards.forEach(c => c.style.display = "none");

            const total = filteredCards.length;
            const totalPages = Math.ceil(total / PAGE_SIZE) || 1;

            if (currentPage > totalPages) currentPage = totalPages;
            sessionStorage.setItem("dish_currentPage", currentPage);

            const start = (currentPage - 1) * PAGE_SIZE;
            const end = start + PAGE_SIZE;
            filteredCards.slice(start, end).forEach(c => c.style.display = "");

            document.getElementById("pageInfo").textContent =
                `目前顯示：${total} 筆餐點中的第 ${Math.min(start + 1, total)} ~ ${Math.min(end, total)} 筆`;

            renderPaginationButtons("pagination", totalPages);
            renderPaginationButtons("topPagination", totalPages);

            // 如果只有一頁，隱藏上方分頁
            const topPaginationWrapper = document.getElementById("topPaginationWrapper");
            if (topPaginationWrapper) {
                topPaginationWrapper.classList.toggle("d-none", totalPages <= 1);
            }
        }

        function renderPaginationButtons(elementId, totalPages) {
            const container = document.getElementById(elementId);
            container.innerHTML = "";

            const prevLi = document.createElement("li");
            prevLi.className = `page-item ${currentPage === 1 ? "disabled" : ""}`;
            prevLi.innerHTML = `<a class="page-link shadow-none" onclick="goToPage(${currentPage - 1})"><i class="fas fa-chevron-left"></i></a>`;
            container.appendChild(prevLi);

            for (let i = 1; i <= totalPages; i++) {
                const li = document.createElement("li");
                li.className = `page-item ${i === currentPage ? "active" : ""}`;
                li.innerHTML = `<a class="page-link shadow-none" onclick="goToPage(${i})">${i}</a>`;
                container.appendChild(li);
            }

            const nextLi = document.createElement("li");
            nextLi.className = `page-item ${currentPage === totalPages ? "disabled" : ""}`;
            nextLi.innerHTML = `<a class="page-link shadow-none" onclick="goToPage(${currentPage + 1})"><i class="fas fa-chevron-right"></i></a>`;
            container.appendChild(nextLi);
        }

        function goToPage(page) {
            const totalPages = Math.ceil(filteredCards.length / PAGE_SIZE) || 1;
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            renderPage();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function filterByStatus(status) {
            document.getElementById("statusFilter").value = status;
            filterCards(true);
            document.getElementById("dishCardContainer").scrollIntoView({ behavior: 'smooth', block: 'start' });
            const statusLabel = status === "" ? "所有" : status;
            showAlert("info", `已篩選：${statusLabel} 餐點`);
        }

        function showAlert(type, message) {
            const box = document.getElementById("alertBox");
            box.innerHTML = `
                <div class="alert alert-${type} alert-dismissible border-0 shadow-sm fade show" role="alert">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`;
            setTimeout(() => {
                const el = box.querySelector(".alert");
                if (el) { el.classList.remove("show"); setTimeout(() => box.innerHTML = "", 400); }
            }, 3000);
        }

        /* 批次操作 JS */
        function enterBatchMode() {
            isBatchMode = true;
            document.getElementById("dishCardContainer").classList.add("batch-mode");
            document.getElementById("batchBar").classList.remove("d-none");
            document.getElementById("batchModeBtn").classList.add("d-none");
            document.querySelectorAll(".dish-card").forEach(card => card.addEventListener("click", onCardClick));
        }

        function exitBatchMode() {
            isBatchMode = false;
            document.getElementById("dishCardContainer").classList.remove("batch-mode");
            document.getElementById("batchBar").classList.add("d-none");
            document.getElementById("batchModeBtn").classList.remove("d-none");
            document.getElementById("selectAllCheck").checked = false;
            document.querySelectorAll(".card-checkbox").forEach(cb => cb.checked = false);
            document.querySelectorAll(".dish-card.selected").forEach(c => c.classList.remove("selected"));
            document.getElementById("selectedCount").textContent = "0";
            document.querySelectorAll(".dish-card").forEach(card => card.removeEventListener("click", onCardClick));
        }

        function onCardClick(e) {
            if (e.target.closest("a, button")) return;
            const cb = this.querySelector(".card-checkbox");
            cb.checked = !cb.checked;
            this.classList.toggle("selected", cb.checked);
            updateSelectedCount();
        }

        function toggleSelectAll(checked) {
            document.querySelectorAll(".dish-card").forEach(card => {
                if (card.style.display === "none") return;
                const cb = card.querySelector(".card-checkbox");
                cb.checked = checked;
                card.classList.toggle("selected", checked);
            });
            updateSelectedCount();
        }

        function updateSelectedCount() {
            const count = document.querySelectorAll(".card-checkbox:checked").length;
            document.getElementById("selectedCount").textContent = count;
            const visibleCbs = Array.from(document.querySelectorAll(".dish-card:not([style*='display: none']) .card-checkbox"));
            document.getElementById("selectAllCheck").checked = visibleCbs.length > 0 && visibleCbs.every(cb => cb.checked);
        }

        function getSelectedIds() {
            return Array.from(document.querySelectorAll(".card-checkbox:checked")).map(cb => parseInt(cb.dataset.id));
        }

        /* 排序模式 JS */
        function toggleSortMode() {
            if (isBatchMode) exitBatchMode();

            isSortMode = !isSortMode;
            const container = document.getElementById("dishCardContainer");
            const bar       = document.getElementById("sortModeBar");
            const btn       = document.getElementById("toggleSortBtn");

            if (isSortMode) {
                container.classList.add("sort-mode");
                bar.classList.remove("d-none");
                btn.classList.replace("btn-outline-secondary", "btn-warning");
                btn.innerHTML = '<i class="fas fa-times me-1"></i>取消排序';

                // 初始化 SortableJS
                sortableInstance = Sortable.create(container, {
                    animation: 180,
                    ghostClass: "sortable-ghost",
                    chosenClass: "sortable-chosen",
                    handle: ".drag-handle",
                    draggable: ".dish-card",
                    onEnd: updateOrderBadges
                });
            } else {
                container.classList.remove("sort-mode");
                bar.classList.add("d-none");
                btn.classList.replace("btn-warning", "btn-outline-secondary");
                btn.innerHTML = '<i class="fas fa-arrows-alt me-1"></i>調整排序';

                if (sortableInstance) { sortableInstance.destroy(); sortableInstance = null; }
            }
        }

        function updateOrderBadges() {
            // 拖曳後更新各卡片的 data-order（視覺用）
            document.querySelectorAll(".dish-card").forEach((card, idx) => {
                card.dataset.order = idx + 1;
            });
        }

        async function saveOrder() {
            const ids = Array.from(document.querySelectorAll(".dish-card")).map(c => parseInt(c.dataset.id));

            try {
                const res = await fetch("/Dishes/UpdateOrder", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ orderedIds: ids })
                });

                if (res.ok) {
                    showAlert("success", "排序已儲存 ✓");
                    toggleSortMode();
                } else {
                    showAlert("danger", "儲存失敗，請稍後再試");
                }
            } catch {
                showAlert("danger", "發生錯誤，請稍後再試");
            }
        }

        async function batchDisable() {
            const ids = getSelectedIds();
            if (ids.length === 0) { showAlert("warning", "請先勾選項目"); return; }
            if (!confirm(`確定要下架這 ${ids.length} 個餐點嗎？`)) return;
            const res = await fetch("/Dishes/BatchDisable", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ ids })
            });
            if (res.ok) { showAlert("success", "操作成功"); setTimeout(() => location.reload(), 1000); }
        }

        async function batchEnable() {
            const ids = getSelectedIds();
            if (ids.length === 0) { showAlert("warning", "請先勾選項目"); return; }
            if (!confirm(`確定要上架這 ${ids.length} 個餐點嗎？`)) return;
            const res = await fetch("/Dishes/BatchEnable", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ ids })
            });
            if (res.ok) { showAlert("success", "操作成功"); setTimeout(() => location.reload(), 1000); }
        }

        async function batchDelete() {
            const ids = getSelectedIds();
            if (ids.length === 0) { showAlert("warning", "請先勾選項目"); return; }
            if (!confirm("⚠️ 確定要永久刪除嗎？此操作無法還原！")) return;
            const res = await fetch("/Dishes/BatchDelete", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ ids })
            });
            if (res.ok) { showAlert("success", "操作成功"); setTimeout(() => location.reload(), 1000); }
        }

        async function disableDish(id) {
            if (!confirm("確定要將此餐點下架嗎？")) return;
            const res = await fetch(`/Dishes/Disable/${id}`, { method: "POST" });
            if (res.ok) { showAlert("success", "操作成功"); setTimeout(() => location.reload(), 1000); }
        }

        async function toggleFeature(id, type) {
            const res = await fetch(`/Dishes/Toggle${type}/${id}`, { method: "POST" });
            if (res.ok) {
                const data = await res.json();
                if (type === 'Active') {
                    const badge = document.getElementById(`active-badge-${id}`);
                    if (data.isActive) {
                        badge.className = "badge rounded-pill bg-success-subtle text-success px-2 border border-success";
                        badge.textContent = "上架中";
                    } else {
                        badge.className = "badge rounded-pill bg-secondary-subtle text-secondary px-2 border border-secondary";
                        badge.textContent = "已下架";
                    }
                }
                showAlert("success", "狀態已更新");
            }
        }
    </script>
}
