@model EatTogether.Models.ViewModels.CreatePreOrderViewModel

@{
    ViewData["Title"] = "Create";
}

<style>
    .order-wrap {
        max-width: 100%;
        margin: 40px auto;
        padding: 0 40px 60px;
    }

    .page-header {
        display: flex;
        align-items: flex-end;
        gap: 16px;
        margin-bottom: 32px;
        padding-bottom: 20px;
        border-bottom: 2px solid #e8e0d8;
    }

    .page-title {
        font-size: 2.2rem;
        font-weight: 700;
        color: #1a1a1a;
        letter-spacing: -0.02em;
    }

    .page-sub {
        color: #999;
        font-size: 0.9rem;
        padding-bottom: 4px;
    }

    /* ── 內用/外帶 ── */
    .section-title {
        font-weight: 700;
        font-size: 1rem;
        color: #333;
        margin-bottom: 12px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .toggle-wrap {
        display: flex;
        gap: 12px;
        margin-bottom: 24px;
    }

    .toggle-btn {
        flex: 1;
        padding: 14px;
        border: 2px solid #ddd;
        border-radius: 12px;
        background: #fff;
        cursor: pointer;
        font-size: 1rem;
        font-family: inherit;
        font-weight: 500;
        color: #555;
        transition: all 0.2s;
        text-align: center;
    }

        .toggle-btn.active {
            border-color: #c0392b;
            background: #fff5f5;
            color: #c0392b;
            font-weight: 700;
        }

    /* ── 桌號 ── */
    .table-input {
        display: none;
        margin-bottom: 24px;
    }

        .table-input.show {
            display: block;
        }

    .form-select, .form-control {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid #ddd;
        border-radius: 10px;
        font-size: 0.95rem;
        font-family: inherit;
        background: #fff;
        color: #333;
        outline: none;
        transition: border-color 0.2s;
    }

        .form-select:focus, .form-control:focus {
            border-color: #c0392b;
        }

    /* ── 分類區塊 ── */
    .category-section {
        margin-bottom: 36px;
    }

    .category-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
    }

    .category-icon {
        font-size: 1.4rem;
        line-height: 1;
    }

    .category-name {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--cat-color);
        letter-spacing: 0.06em;
        white-space: nowrap;
    }

    .category-line {
        flex: 1;
        height: 2px;
        background: linear-gradient(to right, var(--cat-color), transparent);
        opacity: 0.3;
        border-radius: 2px;
    }

    /* ── 菜單卡片升級 ── */
    .menu-card {
        background: #fff;
        border-radius: 14px;
        padding: 18px;
        border: 2px solid #eee;
        transition: all 0.2s;
        position: relative;
        overflow: hidden;
    }

        .menu-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--card-accent, #ccc);
            opacity: 0;
            transition: opacity 0.2s;
        }

        .menu-card:hover {
            border-color: var(--card-accent, #c0392b);
            box-shadow: 0 4px 16px rgba(0,0,0,0.08);
            transform: translateY(-2px);
        }

            .menu-card:hover::before {
                opacity: 1;
            }

        .menu-card.selected {
            border-color: var(--card-accent, #c0392b);
            background: #fffaf8;
        }

            .menu-card.selected::before {
                opacity: 1;
            }

        /* ── 套餐標記升級 ── */
        .menu-card.is-setmeal .menu-name::after {
            content: '套餐';
            font-size: 0.68rem;
            background: #e67e22;
            color: #fff;
            padding: 1px 7px;
            border-radius: 20px;
            margin-left: 6px;
            font-weight: 700;
            vertical-align: middle;
            letter-spacing: 0.02em;
        }

    /* ── 菜單 ── */
    .menu-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 14px;
        margin-bottom: 0;
    }

    .menu-name {
        font-weight: 700;
        font-size: 0.95rem;
        color: #1a1a1a;
        margin-bottom: 4px;
        line-height: 1.4;
    }

    .menu-price {
        color: var(--card-accent, #c0392b);
        font-weight: 700;
        font-size: 0.92rem;
        margin-bottom: 14px;
    }

    .qty-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .qty-btn {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 2px solid #ddd;
        background: #fff;
        font-size: 1.1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
        transition: all 0.15s;
        line-height: 1;
    }

        .qty-btn:hover {
            border-color: #c0392b;
            color: #c0392b;
        }

    .qty-input {
        width: 44px;
        text-align: center;
        border: 2px solid #ddd;
        border-radius: 8px;
        padding: 4px;
        font-size: 0.95rem;
        font-family: inherit;
        outline: none;
    }

        .qty-input:focus {
            border-color: #c0392b;
        }

    /* ── 備註 ── */
    .note-wrap {
        margin-bottom: 32px;
    }

    textarea.form-control {
        resize: vertical;
        min-height: 80px;
    }

    /* ── 送出 ── */
    .btn-next {
        display: block;
        width: 100%;
        padding: 16px;
        background: #c0392b;
        color: #fff;
        border: none;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        transition: background 0.2s;
        letter-spacing: 0.05em;
    }

        .btn-next:hover {
            background: #a93226;
        }

    .alert-danger {
        background: #fff5f5;
        border: 1px solid #f5c6cb;
        color: #721c24;
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 0.9rem;
    }

    /* ── 套餐標記 ── */
    .menu-card.is-setmeal .menu-name::after {
        content: '套餐';
        font-size: 0.7rem;
        background: #e67e22;
        color: #fff;
        padding: 1px 6px;
        border-radius: 6px;
        margin-left: 6px;
        font-weight: 600;
        vertical-align: middle;
    }

    /* ── 套餐 Modal ── */
    .setmeal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

        .setmeal-overlay.show {
            display: flex;
        }

    .setmeal-box {
        background: #fff;
        border-radius: 20px;
        padding: 28px;
        width: 480px;
        max-width: 92vw;
        max-height: 80vh;
        overflow-y: auto;
        box-shadow: 0 16px 48px rgba(0,0,0,0.2);
        font-family: 'Noto Sans TC', sans-serif;
        animation: smIn 0.2s cubic-bezier(0.34,1.56,0.64,1);
        position: relative;
    }

    @@keyframes smIn {
        from {
            transform: scale(0.88);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .setmeal-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 4px;
    }

    .setmeal-price {
        font-size: 0.88rem;
        color: #c0392b;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .setmeal-group {
        margin-bottom: 18px;
    }

    .setmeal-group-title {
        font-size: 0.8rem;
        font-weight: 700;
        color: #888;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 10px;
        padding-bottom: 6px;
        border-bottom: 1px solid #f0f0f0;
    }

    .setmeal-option {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 12px;
        border-radius: 10px;
        border: 2px solid #eee;
        margin-bottom: 7px;
        cursor: pointer;
        transition: all 0.15s;
        font-size: 0.92rem;
    }

        .setmeal-option:hover {
            border-color: #e67e22;
            background: #fef9f0;
        }

        .setmeal-option.selected {
            border-color: #e67e22;
            background: #fef9f0;
        }

        .setmeal-option.dimmed {
            opacity: 0.35;
            pointer-events: none;
        }

        .setmeal-option input[type=checkbox],
        .setmeal-option input[type=radio] {
            accent-color: #e67e22;
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }

    .sm-hint {
        font-size: 0.8rem;
        margin-bottom: 8px;
        font-weight: 600;
    }

        .sm-hint.neutral {
            color: #888;
        }

        .sm-hint.progress {
            color: #e67e22;
        }

        .sm-hint.done {
            color: #27ae60;
        }

    .setmeal-fixed-item {
        padding: 7px 12px;
        border-radius: 8px;
        background: #f8f8f8;
        font-size: 0.88rem;
        color: #555;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .setmeal-actions {
        display: flex;
        gap: 10px;
        margin-top: 22px;
    }

    .setmeal-btn-cancel {
        flex: 1;
        padding: 11px;
        border: 2px solid #ddd;
        border-radius: 10px;
        background: #fff;
        color: #555;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.92rem;
        cursor: pointer;
    }

    .setmeal-btn-confirm {
        flex: 1;
        padding: 11px;
        border: none;
        border-radius: 10px;
        background: #e67e22;
        color: #fff;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.92rem;
        cursor: pointer;
        transition: background 0.2s;
    }

        .setmeal-btn-confirm:hover {
            background: #d35400;
        }

    .setmeal-error {
        color: #c0392b;
        font-size: 0.82rem;
        margin-top: 4px;
        display: none;
    }

    .sm-qty-btn {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 2px solid #ddd;
        background: #fff;
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
        transition: all 0.15s;
        line-height: 1;
        flex-shrink: 0;
    }

        .sm-qty-btn:hover {
            border-color: #e67e22;
            color: #e67e22;
        }

    .sm-qty-val {
        min-width: 20px;
        text-align: center;
        font-weight: 700;
        font-size: 0.95rem;
        color: #1a1a1a;
    }
</style>

<div class="order-wrap">
    <div class="page-header">
        <div class="page-title">🍽️ 點餐</div>
        <div class="page-sub">請選擇用餐方式並挑選餐點</div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Confirm" method="post" id="orderForm">
        @Html.AntiForgeryToken()

        <!-- 內用 / 外帶 -->
        <div class="section-title">用餐方式</div>
        <div class="toggle-wrap">
            <button type="button" class="toggle-btn active" id="btn-dine-in"
                    onclick="setInOrOut(true)">
                🪑 內用
            </button>
            <button type="button" class="toggle-btn" id="btn-take-out"
                    onclick="setInOrOut(false)">
                🥡 外帶
            </button>
        </div>
        <input type="hidden" name="InOrOut" id="inOrOutInput" value="true" />

        <!-- 桌號（內用才顯示） -->
        <div class="table-input show" id="tableInput">
            <div class="section-title">選擇桌號</div>
            <select name="TableId" id="tableSelect" class="form-select">
                <option value="">-- 請選擇桌號 --</option>
                @foreach (var t in Model.TableOptions)
                {
                    <option value="@t.Value">@t.Text</option>
                }
            </select>
            <div id="tableError" style="display:none; color:#c0392b; font-size:0.88rem; margin-top:6px;">⚠️ 桌號為必填，請選擇桌號</div>
        </div>

        <!-- 菜單 -->
        <div class="section-title">選擇餐點</div>

        @{
            var categoryOrder = new List<string> { "套餐", "主餐", "飲料", "甜點", "湯品", "附餐" };
            var categoryIcons = new Dictionary<string, string>
            {
                ["套餐"] = "🍱",
                ["主餐"] = "🍝",
                ["飲料"] = "🥤",
                ["甜點"] = "🍮",
                ["湯品"] = "🍲",
                ["附餐"] = "🥗"
            };
            var categoryColors = new Dictionary<string, string>
            {
                ["套餐"] = "#e67e22",
                ["主餐"] = "#c0392b",
                ["飲料"] = "#2980b9",
                ["甜點"] = "#8e44ad",
                ["湯品"] = "#16a085",
                ["附餐"] = "#27ae60"
            };

            var indexedItems = Model.Items
            .Select((item, idx) => new { item, idx })
            .ToList();

            var grouped = indexedItems
            .GroupBy(x => x.item.IsSetMeal ? "套餐" : (x.item.CategoryName ?? "其他"))
            .ToList();

            var orderedGroups = grouped
            .OrderBy(g =>
            {
                int pos = categoryOrder.IndexOf(g.Key);
                return pos < 0 ? 99 : pos;
            })
            .ToList();
        }

        @foreach (var group in orderedGroups)
        {
            var catName = group.Key;
            var icon = categoryIcons.ContainsKey(catName) ? categoryIcons[catName] : "🍽️";
            var color = categoryColors.ContainsKey(catName) ? categoryColors[catName] : "#555";

            <div class="category-section">
                <div class="category-header" style="--cat-color: @color">
                    <span class="category-icon">@icon</span>
                    <span class="category-name">@catName</span>
                    <div class="category-line"></div>
                </div>
                <div class="menu-grid">
                    @foreach (var x in group)
                    {
                        var i = x.idx;
                        var item = x.item;
                        bool isSetMeal = item.IsSetMeal;
                        <div class="menu-card @(isSetMeal ? "is-setmeal" : "")" id="card-@i"
                             style="--card-accent: @color">
                            <input type="hidden" name="Items[@i].ProductId" value="@item.ProductId" />
                            <input type="hidden" name="Items[@i].ProductName" value="@item.ProductName" />
                            <input type="hidden" name="Items[@i].UnitPrice" value="@item.UnitPrice" />
                            <input type="hidden" name="Items[@i].IsSetMeal" value="@isSetMeal.ToString().ToLower()" />
                            <input type="hidden" name="Items[@i].CategoryName" value="@(item.CategoryName ?? "")" />
                            <input type="hidden" name="Items[@i].ParentIndex" value="" />

                            <div class="menu-name">@item.ProductName</div>
                            <div class="menu-price">NT$ @item.UnitPrice</div>
                            <div class="qty-wrap">
                                <button type="button" class="qty-btn" onclick="@(isSetMeal ? $"changeSetMealQty({i}, -1)" : $"changeQty({i}, -1)")">−</button>
                                <input type="number" class="qty-input" id="qty-@i"
                                       name="Items[@i].Qty" value="0" min="0" readonly
                                       onchange="updateCard(@i)" />
                                <button type="button" class="qty-btn" onclick="@(isSetMeal ? $"openSetMealModal({i}, {item.ProductId}, '{item.ProductName}', {item.UnitPrice})" : $"changeQty({i}, 1)")">＋</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- 備註 -->
        <div class="note-wrap">
            <div class="section-title">備註</div>
            <textarea class="form-control" name="Note" placeholder="有什麼特殊需求嗎？（可不填）"></textarea>
        </div>

        <button type="submit" class="btn-next">下一步 →</button>

        <!-- 套餐子項目動態 hidden inputs 放這裡 -->
        <div id="extraItemsContainer"></div>
    </form>
</div>

<!-- 套餐選項 Modal -->
<div class="setmeal-overlay" id="setmealModal">
    <div class="setmeal-box">
        <button onclick="closeSetMealModal()"
                style="position:absolute;top:16px;right:16px;width:32px;height:32px;
                       border:none;background:#f0f0f0;border-radius:50%;cursor:pointer;
                       font-size:1.1rem;color:#555;display:flex;align-items:center;
                       justify-content:center;transition:all 0.15s;line-height:1;"
                onmouseover="this.style.background='#e0e0e0'"
                onmouseout="this.style.background='#f0f0f0'">
            ✕
        </button>
        <div class="setmeal-title" id="smTitle">套餐名稱</div>
        <div class="setmeal-price" id="smPrice">NT$ 0</div>
        <div id="smGroups"></div>
        <div class="setmeal-error" id="smError">⚠️ 請完成所有必選項目</div>
        <div class="setmeal-actions">
            <button class="setmeal-btn-cancel" onclick="closeSetMealModal()">取消</button>
            <button class="setmeal-btn-confirm" onclick="confirmSetMeal()">加入訂單</button>
        </div>
    </div>
</div>

<script>
    let smCurrentIdx = -1;
    let smProductId  = 0;
    let smGroups     = [];
    let totalItems   = @Model.Items.Count; // 目前 Items 總數（包含動態加入

    // 記錄每個 radio 組目前選中的 oi（-1 = 未選）
    const radioSelected = {};

    async function openSetMealModal(idx, productId, name, price) {
        smCurrentIdx = idx;
        smProductId  = productId;
        document.getElementById('smTitle').textContent = name;
        document.getElementById('smPrice').textContent = `NT$ ${price}`;
        document.getElementById('smError').style.display = 'none';
        document.body.style.overflow = 'hidden';

        const res = await fetch(`/PreOrders/GetSetMealItems?setMealId=${productId}`);
        smGroups  = await res.json();

        // 重置 radio 記錄
        smGroups.forEach((_, gi) => radioSelected[gi] = -1);

        const container = document.getElementById('smGroups');
        container.innerHTML = '';

        smGroups.forEach((group, gi) => {
            const div = document.createElement('div');
            div.className = 'setmeal-group';

            if (!group.isOptional) {
                div.innerHTML = `<div class="setmeal-group-title">固定附餐</div>` +
                    group.options.map(o => `
                        <div class="setmeal-fixed-item">
                            <span>✓</span><span>${o.dishName} × ${o.qty}</span>
                        </div>`).join('');
            } else {
                const isRadio = group.pickLimit === 1;
                if (isRadio) {
                    // 單選：radio 樣式
                    div.innerHTML = `
                        <div class="setmeal-group-title">請選擇 ${group.pickLimit} 項</div>
                        <div class="sm-hint neutral" id="smhint-${gi}">尚未選擇</div>` +
                        group.options.map((o, oi) => `
                            <label class="setmeal-option" id="smopt-${gi}-${oi}"
                                   onclick="onRadioClick(event, ${gi}, ${oi}, ${group.pickLimit})">
                                <input type="radio" name="smg-${gi}" value="${o.dishName}"
                                       style="pointer-events:none;">
                                <span>${o.dishName}</span>
                            </label>`).join('');
                } else {
                    // 多選：+- 數量控制
                    div.innerHTML = `
                        <div class="setmeal-group-title">請選擇 ${group.pickLimit} 項</div>
                        <div class="sm-hint neutral" id="smhint-${gi}">尚未選擇（共需選 ${group.pickLimit} 項）</div>` +
                        group.options.map((o, oi) => `
                            <div class="setmeal-option" id="smopt-${gi}-${oi}">
                                <span style="flex:1;">${o.dishName}</span>
                                <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
                                    <button type="button" class="sm-qty-btn"
                                            onclick="smQtyChange(${gi}, ${oi}, -1, ${group.pickLimit})">−</button>
                                    <span class="sm-qty-val" id="smqty-${gi}-${oi}">0</span>
                                    <button type="button" class="sm-qty-btn"
                                            onclick="smQtyChange(${gi}, ${oi}, 1, ${group.pickLimit})">＋</button>
                                </div>
                            </div>`).join('');
                }
            }
            container.appendChild(div);
        });

        document.getElementById('setmealModal').classList.add('show');
    }

    // Radio 單選：點已選 → 取消；點其他 → 切換
    function onRadioClick(event, gi, oi, pickLimit) {
        event.preventDefault();
        const allLabels = [...document.querySelectorAll(`[id^="smopt-${gi}-"]`)];
        const allInputs = allLabels.map(l => l.querySelector('input'));

        if (radioSelected[gi] === oi) {
            allInputs[oi].checked = false;
            radioSelected[gi] = -1;
        } else {
            allInputs.forEach(i => i.checked = false);
            allInputs[oi].checked = true;
            radioSelected[gi] = oi;
        }
        updateGroupUI(gi, pickLimit);
    }

    // 多選 +- 數量控制
    function smQtyChange(gi, oi, delta, pickLimit) {
        const curVal  = parseInt(document.getElementById(`smqty-${gi}-${oi}`).textContent || 0);
        const allQtys = [...document.querySelectorAll(`[id^="smqty-${gi}-"]`)]
                            .map(el => parseInt(el.textContent || 0));
        const total   = allQtys.reduce((a, b) => a + b, 0);

        let newVal = curVal + delta;
        if (newVal < 0) return;
        if (delta > 0 && total >= pickLimit) return; // 已達上限

        document.getElementById(`smqty-${gi}-${oi}`).textContent = newVal;
        updateGroupUI(gi, pickLimit);
    }

    function updateGroupUI(gi, pickLimit) {
        const hint = document.getElementById(`smhint-${gi}`);
        let total = 0;

        // 判斷是 radio 還是 qty 模式
        const firstQty = document.getElementById(`smqty-${gi}-0`);
        const isQtyMode = !!firstQty;

        if (isQtyMode) {
            // 多選 qty 模式
            const allQtys = [...document.querySelectorAll(`[id^="smqty-${gi}-"]`)]
                                .map(el => parseInt(el.textContent || 0));
            total = allQtys.reduce((a, b) => a + b, 0);

            allQtys.forEach((qty, i) => {
                const label = document.getElementById(`smopt-${gi}-${i}`);
                if (label) {
                    label.classList.toggle('selected', qty > 0);
                    // 已達上限時暗掉數量為 0 的選項的 + 按鈕（靠 CSS pointer-events 控制）
                    const plusBtn = label.querySelectorAll('.sm-qty-btn')[1];
                    if (plusBtn) plusBtn.style.opacity = (total >= pickLimit && qty === 0) ? '0.3' : '1';
                }
            });
        } else {
            // 單選 radio 模式
            const allLabels = [...document.querySelectorAll(`[id^="smopt-${gi}-"]`)];
            const allInputs = allLabels.map(l => l.querySelector('input'));
            total = allInputs.filter(i => i.checked).length;

            allLabels.forEach((label, i) => {
                label.classList.toggle('selected', allInputs[i].checked);
                label.classList.toggle('dimmed', total >= pickLimit && !allInputs[i].checked);
            });
        }

        if (hint) {
            if (total === 0) {
                hint.className = 'sm-hint neutral';
                hint.textContent = isQtyMode ? `尚未選擇（共需選 ${pickLimit} 項）` : '尚未選擇';
            } else if (total < pickLimit) {
                hint.className = 'sm-hint progress';
                hint.textContent = `還需選擇 ${pickLimit - total} 項`;
            } else {
                hint.className = 'sm-hint done';
                hint.textContent = `✓ 已選擇 ${total} 項`;
            }
        }
    }

    function closeSetMealModal() {
        document.getElementById('setmealModal').classList.remove('show');
        document.body.style.overflow = ''; // ← 解除鎖定
        smCurrentIdx = -1;
    }

    function confirmSetMeal() {
        let valid = true;
        smGroups.forEach((group, gi) => {
            if (!group.isOptional) return;
            const firstQty = document.getElementById(`smqty-${gi}-0`);
            const isQtyMode = !!firstQty;

            if (isQtyMode) {
                const total = [...document.querySelectorAll(`[id^="smqty-${gi}-"]`)]
                    .reduce((sum, el) => sum + parseInt(el.textContent || 0), 0);
                if (total < group.pickLimit) valid = false;
            } else {
                const checked = document.querySelectorAll(`input[name="smg-${gi}"]:checked`).length;
                if (checked < group.pickLimit) valid = false;
            }
        });

        if (!valid) {
            document.getElementById('smError').style.display = 'block';
            return;
        }

        const qtyInput = document.getElementById(`qty-${smCurrentIdx}`);
        qtyInput.value = parseInt(qtyInput.value || 0) + 1;
        updateCard(smCurrentIdx);

        const container = document.getElementById('extraItemsContainer');
        const parentIndex = smCurrentIdx;

        smGroups.forEach((group, gi) => {
            if (!group.isOptional) {
                group.options.forEach(o => addSubItem(container, o.dishName, o.qty, 0, parentIndex));
            } else {
                const firstQty = document.getElementById(`smqty-${gi}-0`);
                const isQtyMode = !!firstQty;

                if (isQtyMode) {
                    // 多選 qty 模式：收集數量 > 0 的選項
                    group.options.forEach((o, oi) => {
                        const qty = parseInt(document.getElementById(`smqty-${gi}-${oi}`).textContent || 0);
                        if (qty > 0) addSubItem(container, o.dishName, qty, 0, parentIndex);
                    });
                } else {
                    // 單選 radio 模式
                    document.querySelectorAll(`input[name="smg-${gi}"]:checked`).forEach(inp => {
                        addSubItem(container, inp.value, 1, 0, parentIndex);
                    });
                }
            }
        });

        closeSetMealModal();
    }

    function addSubItem(container, name, qty, price, parentIndex) {
        const idx = totalItems++;
        const wrap = document.createElement('div');
        wrap.innerHTML = `
            <input type="hidden" name="Items[${idx}].ProductId" value="0">
            <input type="hidden" name="Items[${idx}].ProductName" value="${name}">
            <input type="hidden" name="Items[${idx}].UnitPrice" value="${price}">
            <input type="hidden" name="Items[${idx}].Qty" value="${qty}">
            <input type="hidden" name="Items[${idx}].IsSetMeal" value="false">
            <input type="hidden" name="Items[${idx}].ParentIndex" value="${parentIndex}">
        `;
        container.appendChild(wrap);
    }

    // 套餐減少數量（移除最後一組子項目）
    function changeSetMealQty(idx, delta) {
        if (delta > 0) {
            // 加一份要開 Modal 選
            return;
        }
        const input = document.getElementById(`qty-${idx}`);
        const cur   = parseInt(input.value || 0);
        if (cur <= 0) return;
        input.value = cur - 1;
        updateCard(idx);

        // 移除最後一組對應子項目
        const container = document.getElementById('extraItemsContainer');
        const children  = container.querySelectorAll(`input[name$="].ParentIndex"][value="${idx}"]`);
        if (children.length === 0) return;
        // 找最後一組（同一 idx 的最後幾個）
        const lastParentInput = children[children.length - 1];
        const lastIdx = lastParentInput.name.match(/Items\[(\d+)\]/)[1];
        // 找同組的所有 inputs（同 Items[N] 開頭）
        container.querySelectorAll(`input[name^="Items[${lastIdx}]"]`).forEach(el => el.parentElement.remove());
        totalItems--;
    }

    document.getElementById('orderForm').addEventListener('submit', function (e) {
        const isIn = document.getElementById('inOrOutInput').value === 'true';
        const tableVal = document.getElementById('tableSelect').value;
        const errorDiv = document.getElementById('tableError');
        const tableSelect = document.getElementById('tableSelect');

        if (isIn && !tableVal) {
            e.preventDefault();
            errorDiv.style.display = 'block';
            tableSelect.style.borderColor = '#c0392b';
            document.getElementById('tableInput').scrollIntoView({ behavior: 'smooth', block: 'center' });
            tableSelect.focus();
        } else {
            errorDiv.style.display = 'none';
            tableSelect.style.borderColor = '';
        }
    });

    document.getElementById('tableSelect').addEventListener('change', function () {
        if (this.value) {
            document.getElementById('tableError').style.display = 'none';
            this.style.borderColor = '';
        }
    });

    function setInOrOut(isIn) {
        document.getElementById('inOrOutInput').value = isIn ? "true" : "false";
        document.getElementById('tableInput').classList.toggle('show', isIn);
        document.getElementById('btn-dine-in').classList.toggle('active', isIn);
        document.getElementById('btn-take-out').classList.toggle('active', !isIn);
        if (!isIn) {
            document.getElementById('tableError').style.display = 'none';
            document.getElementById('tableSelect').style.borderColor = '';
        }
    }

    function changeQty(idx, delta) {
        const input = document.getElementById('qty-' + idx);
        const newVal = Math.max(0, parseInt(input.value || 0) + delta);
        input.value = newVal;
        updateCard(idx);
    }

    function updateCard(idx) {
        const qty = parseInt(document.getElementById('qty-' + idx).value || 0);
        document.getElementById('card-' + idx).classList.toggle('selected', qty > 0);
    }

    document.addEventListener('DOMContentLoaded', () => {
        @for (int i = 0; i < Model.Items.Count; i++)
        {
                    if (Model.Items[i].Qty > 0)
                    {
                                @:document.getElementById('card-@i').classList.add('selected');
                    }
        }
    });
</script>

