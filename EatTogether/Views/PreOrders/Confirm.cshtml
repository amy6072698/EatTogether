@model EatTogether.Models.ViewModels.ConfirmPreOrderViewModel

@{
    ViewData["Title"] = "確認訂單";
    // 之後做登入後改成 User.Identity.IsAuthenticated
    bool isMember = false;
    var bestEvent = Model.ApplicableEvents.FirstOrDefault();
}

<style>
    .confirm-wrap {
        max-width: 600px;
        margin: 40px auto;
        padding: 0 16px 60px;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 8px;
    }

    .page-sub {
        color: #888;
        margin-bottom: 32px;
        font-size: 0.95rem;
    }

    .card {
        background: #fff;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 16px;
        border: 1px solid #eee;
    }

    .section-title {
        font-weight: 700;
        font-size: 0.85rem;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 14px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        font-size: 0.95rem;
        color: #555;
        border-bottom: 1px solid #f5f5f5;
    }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-row strong {
            color: #1a1a1a;
        }

    .item-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f5f5f5;
        font-size: 0.95rem;
        transition: opacity 0.2s;
    }

        .item-row:last-child {
            border-bottom: none;
        }

        .item-row.removed {
            opacity: 0.3;
        }

    .item-name {
        color: #1a1a1a;
        font-weight: 500;
    }

    .item-unit {
        color: #aaa;
        font-size: 0.82rem;
        margin-top: 2px;
    }

    .item-price {
        color: #c0392b;
        font-weight: 700;
        min-width: 80px;
        text-align: right;
    }

    .qty-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .qty-btn {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 2px solid #ddd;
        background: #fff;
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
        transition: all 0.15s;
        line-height: 1;
    }

        .qty-btn:hover {
            border-color: #c0392b;
            color: #c0392b;
        }

        .qty-btn.minus:hover {
            border-color: #e74c3c;
            background: #fff5f5;
        }

    .qty-display {
        width: 32px;
        text-align: center;
        font-weight: 700;
        font-size: 1rem;
        color: #1a1a1a;
    }

    .coupon-row {
        display: flex;
        gap: 10px;
    }

    .form-control {
        flex: 1;
        padding: 11px 14px;
        border: 2px solid #ddd;
        border-radius: 10px;
        font-size: 0.95rem;
        font-family: inherit;
        outline: none;
        transition: border-color 0.2s;
    }

        .form-control:focus {
            border-color: #c0392b;
        }

    .btn-coupon {
        padding: 11px 20px;
        background: #1a1a1a;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: inherit;
        font-weight: 700;
        cursor: pointer;
        font-size: 0.9rem;
        transition: background 0.2s;
    }

        .btn-coupon:hover {
            background: #333;
        }

    .coupon-msg {
        font-size: 0.85rem;
        margin-top: 8px;
        display: none;
    }

        .coupon-msg.ok {
            color: #27ae60;
        }

        .coupon-msg.err {
            color: #c0392b;
        }

    .member-only-hint {
        font-size: 0.88rem;
        color: #aaa;
        text-align: center;
        padding: 8px 0;
    }

        .member-only-hint a {
            color: #c0392b;
            text-decoration: underline;
        }

    .amount-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        font-size: 0.95rem;
        color: #555;
    }

        .amount-row.discount {
            color: #27ae60;
            font-size: 0.88rem;
        }

        .amount-row.total {
            font-size: 1.2rem;
            font-weight: 700;
            color: #1a1a1a;
            border-top: 2px solid #eee;
            margin-top: 8px;
            padding-top: 14px;
        }

            .amount-row.total span:last-child {
                color: #c0392b;
            }

    .btn-wrap {
        display: flex;
        gap: 12px;
        margin-top: 8px;
    }

    .btn-back {
        flex: 1;
        padding: 15px;
        background: #fff;
        color: #555;
        border: 2px solid #ddd;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-back:hover {
            border-color: #aaa;
            color: #333;
        }

    .btn-submit {
        flex: 2;
        padding: 15px;
        background: #c0392b;
        color: #fff;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-submit:hover {
            background: #a93226;
        }

        .btn-submit:disabled {
            background: #ddd;
            cursor: not-allowed;
        }

    .empty-warning {
        display: none;
        color: #c0392b;
        font-size: 0.88rem;
        margin-top: 8px;
        text-align: center;
    }

    .pay-wrap {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .pay-btn {
        padding: 16px 8px;
        border: 2px solid #ddd;
        border-radius: 12px;
        background: #fff;
        cursor: pointer;
        font-size: 0.9rem;
        font-family: inherit;
        font-weight: 500;
        color: #555;
        transition: all 0.2s;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

        .pay-btn .icon {
            font-size: 1.6rem;
        }

        .pay-btn:hover {
            border-color: #c0392b;
            color: #c0392b;
        }

        .pay-btn.active {
            border-color: #c0392b;
            background: #fff5f5;
            color: #c0392b;
            font-weight: 700;
        }
</style>

<div class="confirm-wrap">
    <div class="page-title">🛒 確認訂單</div>
    <div class="page-sub">確認餐點內容後送出</div>

    <form asp-action="Submit" method="post" id="confirmForm">
        @Html.AntiForgeryToken()

        <input type="hidden" name="TableId" value="@Model.TableId" />
        <input type="hidden" name="InOrOut" value="@Model.InOrOut.ToString().ToLower()" />
        <input type="hidden" name="Note" value="@Model.Note" />
        <input type="hidden" name="PeopleNum" value="@Model.PeopleNum" />
        <input type="hidden" name="IsAddOrder" value="@Model.IsAddOrder.ToString().ToLower()" />
        <input type="hidden" name="DiscountAmount" id="discountAmount" value="@(bestEvent?.CalculatedDiscount ?? 0)" />
        <input type="hidden" name="EventId" id="eventIdInput" value="@bestEvent?.Id" />

        <!-- 訂單資訊 -->
        <div class="card">
            <div class="section-title">訂單資訊</div>
            <div class="info-row">
                <span>用餐方式</span>
                <strong>@(Model.InOrOut ? "🪑 內用" : "🥡 外帶")</strong>
            </div>
            @if (Model.InOrOut && Model.TableId > 0)
            {
                <div class="info-row">
                    <span>桌號</span>
                    <strong>桌 @Model.TableId</strong>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <div class="info-row">
                    <span>備註</span>
                    <strong>@Model.Note</strong>
                </div>
            }
        </div>

        <!-- 餐點清單 -->
        <div class="card">
            <div class="section-title">餐點明細</div>
            @{
                // 只顯示主項目（非子項目），子項目緊跟在父項目後面顯示
                var parentItems = Model.Items
                .Select((item, idx) => new { item, idx })
                .Where(x => !x.item.ParentIndex.HasValue)
                .ToList();
            }
            @foreach (var p in parentItems)
            {
                var i = p.idx;
                var item = p.item;
                bool isSetMeal = item.IsSetMeal;

                // 找屬於這個父項目的子項目
                var children = Model.Items
                .Select((c, ci) => new { c, ci })
                .Where(x => x.c.ParentIndex.HasValue && x.c.ParentIndex.Value == i)
                .ToList();

                <div class="item-row" id="row-@i">
                    <input type="hidden" name="Items[@i].ProductId" value="@item.ProductId" />
                    <input type="hidden" name="Items[@i].ProductName" value="@item.ProductName" />
                    <input type="hidden" name="Items[@i].UnitPrice" value="@item.UnitPrice" />
                    <input type="hidden" id="qty-hidden-@i" name="Items[@i].Qty" value="@item.Qty" />
                    <input type="hidden" name="Items[@i].IsSetMeal" value="@isSetMeal.ToString().ToLower()" />
                    <input type="hidden" name="Items[@i].ParentIndex" value="" />
                    <input type="hidden" name="Items[@i].CategoryName" value="@(item.CategoryName ?? "")" />

                    <div>
                        <div class="item-name">
                            @item.ProductName
                            @if (isSetMeal)
                            {
                                <span style="font-size:0.72rem;background:#e67e22;color:#fff;padding:1px 6px;border-radius:6px;margin-left:4px;">套餐</span>
                            }
                        </div>
                        <div class="item-unit">NT$ @item.UnitPrice / 份</div>
                    </div>

                    <div style="display:flex;align-items:center;gap:16px">
                        <div class="qty-wrap">
                            <button type="button" class="qty-btn minus" onclick="changeQty(@i, -1)">−</button>
                            <div class="qty-display" id="qty-display-@i">@item.Qty</div>
                            <button type="button" class="qty-btn" onclick="changeQty(@i, 1)">＋</button>
                        </div>
                        <div class="item-price" id="subtotal-@i">
                            NT$ @(item.Qty* item.UnitPrice)
                        </div>
                    </div>
                </div>

                @* 子項目緊接在父項目下方 *@
                @foreach (var ch in children)
                {
                    var ci = ch.ci;
                    var child = ch.c;
                    <div class="item-row" id="row-@ci"
                         style="padding-left:24px;background:#fafafa;border-left:3px solid #e67e22;margin-left:8px;border-radius:0 8px 8px 0;margin-bottom:4px;">
                        <input type="hidden" name="Items[@ci].ProductId" value="@child.ProductId" />
                        <input type="hidden" name="Items[@ci].ProductName" value="@child.ProductName" />
                        <input type="hidden" name="Items[@ci].UnitPrice" value="@child.UnitPrice" />
                        <input type="hidden" name="Items[@ci].Qty" value="@child.Qty" />
                        <input type="hidden" name="Items[@ci].IsSetMeal" value="false" />
                        <input type="hidden" name="Items[@ci].ParentIndex" value="@i" />
                        <input type="hidden" name="Items[@ci].CategoryName" value="" />

                        <div class="item-name" style="font-size:0.88rem;color:#666;">
                            @child.ProductName
                        </div>
                        <div style="font-size:0.82rem;color:#aaa;">× @child.Qty</div>
                    </div>
                }
            }

            @* 活動贈品預覽（NT$0，不可增減） *@
            @foreach (var giftEv in Model.ApplicableEvents.Where(e => e.DiscountType == "Gift" && !string.IsNullOrEmpty(e.RewardDishName)))
            {
                <div class="item-row gift-preview-row" data-gift-name="@giftEv.RewardDishName">
                    <div>
                        <div class="item-name">
                            🎁 @giftEv.RewardDishName
                            <span style="font-size:0.72rem;background:#27ae60;color:#fff;padding:1px 6px;border-radius:6px;margin-left:4px;">活動贈品</span>
                        </div>
                        <div class="item-unit" style="color:#27ae60;">@giftEv.Title・@giftEv.Summary</div>
                    </div>
                    <div class="item-price" style="color:#27ae60;font-weight:700;">NT$ 0</div>
                </div>
            }
            <div id="dynamicGiftRows"></div>
        </div>

        @if (!Model.IsAddOrder)
        {
        <!-- 優惠券 -->
        <div class="card">
            <div class="section-title">優惠折扣碼</div>
            <div class="coupon-row">
                <input type="text" class="form-control" id="couponInput"
                       name="CouponCode" placeholder="請輸入折扣碼" />
                <button type="button" class="btn-coupon" onclick="applyCoupon()">套用</button>
            </div>
            <p id="couponMsg" class="coupon-msg"></p>
        </div>

        <!-- 活動優惠（動態渲染） -->
        <div id="eventCard" class="card" style="display:none;border-color:#27ae60;background:#f0fff4;">
            <div class="section-title" style="color:#27ae60;">🎉 活動優惠</div>
            <div id="eventsList"></div>
        </div>
        }
        else
        {
            <div style="background:#fff8e1;border:1.5px solid #f0c040;border-radius:10px;
                        padding:10px 14px;font-size:0.9rem;color:#7d5a00;font-weight:600;">
                ➕ 加點中 — 活動及優惠券不重複套用
            </div>
        }

        <!-- 金額 -->
        <div class="card">
            <div class="section-title">金額明細</div>
            <div class="amount-row">
                <span>餐點金額</span>
                <span>NT$ <span id="originalAmount">@Model.OriginalAmount</span></span>
            </div>
            <div class="amount-row discount" id="eventDiscountRow"
                 style="@(bestEvent != null && bestEvent.CalculatedDiscount > 0 ? "display:flex;" : "display:none;")">
                <span>活動折扣小計</span>
                <span>− NT$ <span id="eventDiscountDisplay">@(bestEvent?.CalculatedDiscount ?? 0)</span></span>
            </div>
            <div class="amount-row discount" id="couponDiscountRow" style="display:none;">
                <span>優惠券折扣</span>
                <span>− NT$ <span id="couponDiscountDisplay">0</span></span>
            </div>
            <div class="amount-row total">
                <span>最後金額</span>
                <span>NT$ <span id="totalAmount">@(Model.OriginalAmount - (bestEvent?.CalculatedDiscount ?? 0))</span></span>
            </div>
        </div>

        <!-- 付款方式 -->
        <div class="card">
            <div class="section-title">付款方式</div>
            <div class="pay-wrap">
                <button type="button" class="pay-btn active" id="pay-Cash"
                        onclick="setPayMethod('Cash')">
                    <span class="icon">💵</span>現金
                </button>
                <button type="button" class="pay-btn" id="pay-Card"
                        onclick="setPayMethod('Card')">
                    <span class="icon">💳</span>刷卡
                </button>
                <button type="button" class="pay-btn" id="pay-Other"
                        onclick="setPayMethod('Other')">
                    <span class="icon">📱</span>行動支付
                </button>
            </div>
            <input type="hidden" name="PayMethod" id="payMethodInput" value="Cash" />
        </div>

        <div class="empty-warning" id="emptyWarning">⚠️ 請至少保留一項餐點</div>

        <div class="btn-wrap">
            <button type="button" class="btn-back" onclick="history.back()">← 繼續點餐</button>
            <button type="submit" class="btn-submit" id="submitBtn">送出訂單 ✓</button>
        </div>
        <input type="hidden" name="CouponId" id="couponIdInput" value="" />
    </form>
</div>

<!-- 贈品重複詢問 Modal -->
<div id="giftModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.45);align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;padding:28px 28px 20px;max-width:360px;width:90%;box-shadow:0 8px 32px rgba(0,0,0,0.18);">
        <div style="font-weight:700;font-size:1.05rem;margin-bottom:10px;color:#1a1a1a;">🎁 活動贈品通知</div>
        <div id="giftModalMsg" style="font-size:0.92rem;color:#444;line-height:1.6;margin-bottom:20px;"></div>
        <div style="display:flex;gap:10px;justify-content:flex-end;">
            <button id="giftModalCancel" style="padding:8px 20px;border-radius:8px;border:1px solid #ddd;background:#f5f5f5;color:#555;font-size:0.9rem;cursor:pointer;">只要贈品</button>
            <button id="giftModalConfirm" style="padding:8px 20px;border-radius:8px;border:none;background:#27ae60;color:#fff;font-weight:700;font-size:0.9rem;cursor:pointer;">兩份都要</button>
        </div>
    </div>
</div>

<!-- 贈品將消失警告 Modal -->
<div id="giftLossModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.45);align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;padding:28px 28px 20px;max-width:380px;width:90%;box-shadow:0 8px 32px rgba(0,0,0,0.18);">
        <div style="font-weight:700;font-size:1.05rem;margin-bottom:10px;color:#c0392b;">⚠️ 贈品將一起取消</div>
        <div id="giftLossModalMsg" style="font-size:0.92rem;color:#444;line-height:1.6;margin-bottom:20px;"></div>
        <div style="display:flex;gap:10px;justify-content:flex-end;">
            <button id="giftLossCancel" style="padding:8px 20px;border-radius:8px;border:1px solid #ddd;background:#f5f5f5;color:#555;font-size:0.9rem;cursor:pointer;">保留餐點</button>
            <button id="giftLossConfirm" style="padding:8px 20px;border-radius:8px;border:none;background:#c0392b;color:#fff;font-weight:700;font-size:0.9rem;cursor:pointer;">確定移除</button>
        </div>
    </div>
</div>

<script>
    const unitPrices = [@Html.Raw(string.Join(",", Model.Items.Select(i => i.UnitPrice)))];
    const qtys       = [@Html.Raw(string.Join(",", Model.Items.Select(i => i.Qty)))];
    let totalItems   = @Model.Items.Count; // 追蹤 Items 陣列長度（供贈品項目插入）

    // 伺服器端預載活動資料
    const serverEvents = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.ApplicableEvents,
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
        ));

    // 活動相關狀態（初始值由伺服器端提供）
    let currentEventId        = @(bestEvent != null ? bestEvent.Id.ToString() : "null");
    let eventCouponDiscount   = 0;
    let eventActivityDiscount = @(bestEvent?.CalculatedDiscount ?? 0);

    // 記錄目前顯示中的贈品活動（供 changeQty 偵測消失用）
    let activeGiftEvents = [];

    function changeQty(idx, delta) {
        // 只有減少時才需要檢查贈品
        if (delta < 0) {
            _changeQtyWithGiftCheck(idx, delta);
        } else {
            _applyQtyChange(idx, delta);
        }
    }

    async function _changeQtyWithGiftCheck(idx, delta) {
        // 計算變更後金額
        const newQty      = Math.max(0, qtys[idx] + delta);
        const newOriginal = qtys.reduce((sum, q, i) => sum + (i === idx ? newQty : q) * unitPrices[i], 0);

        // 找目前有哪些贈品會因為金額不足而消失
        const losingGifts = activeGiftEvents.filter(ev => ev.minSpend > newOriginal);

        if (losingGifts.length > 0) {
            // 彈出警告
            const giftNames = losingGifts.map(ev => ev.rewardDishName).join('、');
            const minSpend  = Math.max(...losingGifts.map(ev => ev.minSpend));
            const confirmed = await showGiftLossModal(giftNames, minSpend);

            if (!confirmed) {
                // 保留餐點：不做任何變更
                return;
            }
            // 確定移除：繼續套用變更（贈品會在 recalculate 自動消失）
        }

        _applyQtyChange(idx, delta);
    }

    function _applyQtyChange(idx, delta) {
        qtys[idx] = Math.max(0, qtys[idx] + delta);

        document.getElementById('qty-display-' + idx).textContent = qtys[idx];
        document.getElementById('qty-hidden-'  + idx).value       = qtys[idx];

        // 數量 0 → 淡化該列（視為刪除）
        document.getElementById('row-' + idx).classList.toggle('removed', qtys[idx] === 0);

        // 更新小計
        document.getElementById('subtotal-' + idx).textContent =
            'NT$ ' + (qtys[idx] * unitPrices[idx]);

        recalculate();
    }

    async function recalculate() {
        let original = 0;
        qtys.forEach((q, i) => { original += q * unitPrices[i]; });

        document.getElementById('originalAmount').textContent = original;

        // 重新驗證優惠券（金額改變可能影響 MinSpend）
        const couponId = document.getElementById('couponIdInput').value;
        if (couponId) {
            await applyCoupon();  // 內部已呼叫 checkEvents + updateTotals
        } else {
            await checkEvents(original);
            updateTotals();
        }

        // 全部為 0 → 鎖住送出
        const hasItem = qtys.some(q => q > 0);
        document.getElementById('submitBtn').disabled           = !hasItem;
        document.getElementById('emptyWarning').style.display  = hasItem ? 'none' : 'block';
    }

    /** 更新折扣顯示與合計 */
    function updateTotals() {
        const original = parseInt(document.getElementById('originalAmount').textContent);
        const totalDiscount = eventCouponDiscount + eventActivityDiscount;

        // 活動折扣小計列（有折扣才顯示）
        document.getElementById('eventDiscountRow').style.display = eventActivityDiscount > 0 ? 'flex' : 'none';
        document.getElementById('eventDiscountDisplay').textContent = eventActivityDiscount;

        // 優惠券折扣列（有優惠券才顯示）
        document.getElementById('couponDiscountRow').style.display = eventCouponDiscount > 0 ? 'flex' : 'none';
        document.getElementById('couponDiscountDisplay').textContent = eventCouponDiscount;

        document.getElementById('discountAmount').value    = totalDiscount;
        document.getElementById('totalAmount').textContent = Math.max(0, original - totalDiscount);
    }

    async function applyCoupon() {
        const code     = document.getElementById('couponInput').value.trim();
        const msg      = document.getElementById('couponMsg');
        const original = parseInt(document.getElementById('originalAmount').textContent);

        if (!code) {
            eventCouponDiscount = 0;
            document.getElementById('couponIdInput').value = '';
            msg.style.display = 'none';
            await checkEvents(original);
            updateTotals();
            return;
        }

        msg.className   = 'coupon-msg';
        msg.textContent = '驗證中...';
        msg.style.display = 'block';

        try {
            const res  = await fetch(`/PreOrders/ValidateCoupon?code=${encodeURIComponent(code)}&originalAmount=${original}`);
            const data = await res.json();

            if (data.isValid) {
                eventCouponDiscount = data.discount;
                document.getElementById('couponIdInput').value = data.couponId;
                msg.className   = 'coupon-msg ok';
                msg.textContent = data.message;
            } else {
                eventCouponDiscount = 0;
                document.getElementById('couponIdInput').value = '';
                msg.className   = 'coupon-msg err';
                msg.textContent = '❌ ' + data.message;
            }
        } catch {
            eventCouponDiscount = 0;
            msg.className   = 'coupon-msg err';
            msg.textContent = '❌ 驗證失敗，請稍後再試';
        }

        msg.style.display = 'block';
        await checkEvents(original);
        updateTotals();
    }

    /** 查詢符合條件的活動（初次載入用 server 資料，之後改量時用 AJAX） */
    async function checkEvents(originalAmount, useServerData) {
        if (originalAmount <= 0) {
            clearEvent();
            return;
        }

        let events;
        if (useServerData) {
            events = serverEvents;
        } else {
            try {
                const res = await fetch(`/Events/GetApplicableEvents?amount=${originalAmount}`);
                if (!res.ok) { clearEvent(); return; }
                events = await res.json();
            } catch {
                clearEvent();
                return;
            }
        }

        // 過濾出金額達標的活動
        const matched = (events || []).filter(e => e.minSpend <= originalAmount);
        renderEvents(matched);
    }

    function renderEvents(matched) {
        const card  = document.getElementById('eventCard');
        const list  = document.getElementById('eventsList');

        if (!matched || matched.length === 0) {
            card.style.display    = 'none';
            list.innerHTML        = '';
            currentEventId        = null;
            eventActivityDiscount = 0;
            document.getElementById('eventIdInput').value = '';
            updateGiftRows([]);
            return;
        }

        // 折扣類活動取門檻最高的，贈品全部套用
        const discountEvents = matched.filter(e => e.discountType !== 'Gift');
        const giftEvents     = matched.filter(e => e.discountType === 'Gift');
        const bestDiscount   = discountEvents.length
            ? discountEvents.reduce((b, e) => e.minSpend > b.minSpend ? e : b, discountEvents[0])
            : null;

        const activeEvents = bestDiscount ? [bestDiscount, ...giftEvents] : giftEvents;

        // 更新 EventId（折扣活動 or 第一個贈品活動）
        const primaryEv = bestDiscount ?? giftEvents[0];
        currentEventId  = primaryEv.id;
        document.getElementById('eventIdInput').value = primaryEv.id;
        eventActivityDiscount = bestDiscount?.calculatedDiscount ?? 0;

        // 活動優惠 card 只顯示折扣類（非贈品）活動
        const cardEvents = activeEvents.filter(e => e.discountType !== 'Gift');
        if (cardEvents.length > 0) {
            list.innerHTML = cardEvents.map((ev, i) => `
                <div style="display:flex;align-items:center;gap:12px;${i > 0 ? 'margin-top:10px;padding-top:10px;border-top:1px solid #d4edda;' : ''}">
                    <div style="flex:1;">
                        <div style="font-weight:700;color:#1a1a1a;font-size:0.95rem;">${ev.title}</div>
                        <div style="font-size:0.82rem;color:#555;">${ev.summary}</div>
                    </div>
                    <div style="background:#27ae60;color:#fff;border-radius:8px;padding:4px 10px;font-weight:700;font-size:0.88rem;white-space:nowrap;">${ev.discountDescription}</div>
                </div>`).join('');
            card.style.display = 'block';
        } else {
            card.style.display = 'none';
            list.innerHTML = '';
        }

        // 更新贈品預覽列
        updateGiftRows(giftEvents);
    }

    function updateGiftRows(giftEvents) {
        // 同步記錄目前活躍的贈品活動
        activeGiftEvents = giftEvents || [];

        // 1. 隱藏所有靜態贈品列（Razor 預渲染的）
        document.querySelectorAll('.gift-preview-row').forEach(row => {
            row.style.display = 'none';
        });

        const container = document.getElementById('dynamicGiftRows');
        container.innerHTML = '';

        // 2. 為每個符合條件的贈品活動建立或顯示贈品列
        giftEvents.forEach(ev => {
            if (!ev.rewardDishName) return;

            // 優先找靜態列（Razor 已渲染的）
            const staticRow = [...document.querySelectorAll('.gift-preview-row')]
                .find(r => r.dataset.giftName?.trim() === ev.rewardDishName.trim());

            if (staticRow) {
                staticRow.style.display = '';
            } else {
                // 動態建立
                const div = document.createElement('div');
                div.className = 'item-row gift-preview-row';
                div.dataset.giftName = ev.rewardDishName;
                div.innerHTML = `
                    <div>
                        <div class="item-name">
                            🎁 ${ev.rewardDishName}
                            <span style="font-size:0.72rem;background:#27ae60;color:#fff;padding:1px 6px;border-radius:6px;margin-left:4px;">活動贈品</span>
                        </div>
                        <div class="item-unit" style="color:#27ae60;">${ev.title}・${ev.summary}</div>
                    </div>
                    <div class="item-price" style="color:#27ae60;font-weight:700;">NT$ 0</div>`;
                container.appendChild(div);
            }
        });
    }

    function clearEvent() {
        renderEvents([]);
    }

    // 相容舊版呼叫（僅優惠券折扣）
    function setDiscount(amount) {
        eventCouponDiscount = amount;
        updateTotals();
    }

    function setPayMethod(method) {
        document.getElementById('payMethodInput').value = method;
        ['Cash', 'Card', 'Other'].forEach(m => {
            document.getElementById('pay-' + m).classList.toggle('active', m === method);
        });
    }

    // 自訂 Modal（取代 confirm()）
    function showGiftModal(giftName) {
        return new Promise(resolve => {
            const modal   = document.getElementById('giftModal');
            const msg     = document.getElementById('giftModalMsg');
            const btnOk   = document.getElementById('giftModalConfirm');
            const btnCancel = document.getElementById('giftModalCancel');

            msg.textContent = `活動將免費贈送「${giftName}」，您已加入了這道餐點，是否還需要保留原本點的那份（需付費）？`;
            modal.style.display = 'flex';

            const cleanup = (result) => {
                modal.style.display = 'none';
                btnOk.removeEventListener('click', onOk);
                btnCancel.removeEventListener('click', onCancel);
                resolve(result);
            };
            const onOk     = () => cleanup(true);
            const onCancel = () => cleanup(false);
            btnOk.addEventListener('click', onOk);
            btnCancel.addEventListener('click', onCancel);
        });
    }

    // 贈品消失警告 Modal
    function showGiftLossModal(giftName, minSpend) {
        return new Promise(resolve => {
            const modal      = document.getElementById('giftLossModal');
            const msg        = document.getElementById('giftLossModalMsg');
            const btnConfirm = document.getElementById('giftLossConfirm');
            const btnCancel  = document.getElementById('giftLossCancel');

            msg.innerHTML = `移除後金額將低於 NT$ ${minSpend}，贈品「${giftName}」將一起取消。<br><br>要移除餐點並取消贈品，還是保留餐點？`;
            modal.style.display = 'flex';

            const cleanup = (result) => {
                modal.style.display = 'none';
                btnConfirm.removeEventListener('click', onConfirm);
                btnCancel.removeEventListener('click', onCancel);
                resolve(result);
            };
            const onConfirm = () => cleanup(true);   // 確定移除（移除餐點+贈品）
            const onCancel  = () => cleanup(false);  // 保留餐點（還原數量）
            btnConfirm.addEventListener('click', onConfirm);
            btnCancel.addEventListener('click', onCancel);
        });
    }

    // 頁面載入：渲染活動優惠卡（使用伺服器端資料）
    (function initEvents() {
        const originalAmount = @Model.OriginalAmount;
        if (serverEvents && serverEvents.length > 0) {
            const matched = serverEvents.filter(e => e.minSpend <= originalAmount);
            renderEvents(matched);
        }
    })();

    // 頁面載入：檢查贈品是否與已點餐點重複，詢問是否保留付費那份
    (async function checkGiftDuplicates() {
        const giftRows = document.querySelectorAll('.gift-preview-row');
        if (!giftRows.length) return;

        const paidRows = [...document.querySelectorAll('.item-row:not(.gift-preview-row)')]
            .filter(row => row.id && row.id.startsWith('row-'));

        for (const giftRow of giftRows) {
            const giftName = giftRow.dataset.giftName?.trim().toLowerCase();
            if (!giftName) continue;

            for (const row of paidRows) {
                const idx    = parseInt(row.id.replace('row-', ''));
                const nameEl = row.querySelector('.item-name');
                const paidName = nameEl?.firstChild?.textContent?.trim().toLowerCase() ?? '';
                if (!document.getElementById(`qty-hidden-${idx}`)) continue;

                if (paidName.includes(giftName) || giftName.includes(paidName)) {
                    const keep = await showGiftModal(giftRow.dataset.giftName);
                    if (!keep) changeQty(idx, -1);
                }
            }
        }
    })();
</script>
