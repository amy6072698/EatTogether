@model List<EatTogether.Models.ViewModels.PreOrderListItemViewModel>

@{
    ViewData["Title"] = "待處理訂單";
    var expanded = Model.Take(3).ToList();
    var listed = Model.Skip(3).ToList();
    // TODO: 登入系統完成後，改成從 Session 或 ClaimsPrincipal 讀取
    // 有「訂單管理（含結帳）FunctionId=4」權限：店長、副店長、收銀員
    // 內場廚師、工讀生、外場服務生不可整單取消
    bool canCancelOrder = true; // 暫時以店長身份模擬
}

<style>
    html,
    /* ════════════════════════════════
                           整體佈局：全螢幕，不留白
                        ════════════════════════════════ */
    .board {
        display: flex;
        flex-direction: column;
        height: 88vh;
        overflow: hidden;
    }

    /* ── 頂部 Header ── */
    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 24px;
        background: #fff;
        border-bottom: 1px solid #e8e8e8;
        flex-shrink: 0;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1a1a;
    }

    .badge-count {
        background: #c0392b;
        color: #fff;
        font-size: 0.85rem;
        font-weight: 700;
        padding: 4px 14px;
        border-radius: 20px;
    }

    /* ── 主體區域 ── */
    .main-area {
        display: flex;
        flex: 1;
        overflow: hidden;
        flex-direction: row-reverse; /* 右到左：expanded 在右，list 在左 */
    }

    /* ════════════════════════════════
                           右側：前3筆展開卡片
                        ════════════════════════════════ */
    .expanded-area {
        display: flex;
        flex-direction: row-reverse; /* 第1筆最右，第3筆最左 */
        gap: 0;
        flex-shrink: 0;
        overflow: hidden;
        border-left: 1px solid #e8e8e8;
    }

    .exp-card {
        width: 400px;
        display: flex;
        flex-direction: column;
        background: #fff;
        border-left: 1px solid #e8e8e8;
        overflow: hidden;
        max-height: calc(100vh - 60px);
    }

        .exp-card:last-child {
            border-left: none;
        }

    /* ── 卡片標頭 ── */
    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 16px;
        border-bottom: 2px solid #f0f0f0;
        background: #fafafa;
        flex-shrink: 0;
        gap: 8px;
    }

    .card-header-left {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1;
        min-width: 0;
    }

    .card-order-number {
        font-weight: 700;
        font-size: 0.88rem;
        color: #1a1a1a;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-meta {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .table-badge {
        font-size: 0.78rem;
        color: #fff;
        background: #2c3e50;
        padding: 1px 8px;
        border-radius: 20px;
        font-weight: 500;
        white-space: nowrap;
    }

        .table-badge.takeout {
            background: #7f8c8d;
        }

    .order-time {
        font-size: 0.78rem;
        color: #aaa;
    }

    .pending-badge {
        font-size: 0.75rem;
        font-weight: 700;
        color: #e67e22;
        background: #fef9f0;
        border: 1px solid #f5cba7;
        padding: 2px 8px;
        border-radius: 20px;
        white-space: nowrap;
        flex-shrink: 0;
    }

        .pending-badge.done {
            color: #27ae60;
            background: #f0fff4;
            border-color: #a9dfbf;
        }

    /* ── 卡片內容（可捲動）── */
    .card-
    .card-body::-webkit-scrollbar {
        width: 4px;
    }

    .card-body::-webkit-scrollbar-thumb {
        background: #ddd;
        border-radius: 4px;
    }

    .note-box {
        margin-bottom: 10px;
        padding: 8px 12px;
        background: #fff8e1;
        border-left: 3px solid #f39c12;
        border-radius: 0 8px 8px 0;
        font-size: 0.82rem;
        color: #7d6608;
        font-weight: 500;
    }

    .detail-item {
        display: flex;
        align-items: center;
        padding: 9px 10px;
        border-radius: 10px;
        margin-top: 8px;
        background: #fafafa;
        border: 1px solid #f0f0f0;
        transition: all 0.3s;
        cursor: pointer;
    }

        .detail-item:hover {
            border-color: #ddd;
            background: #f5f5f5;
        }

        .detail-item.status-done {
            opacity: 0.45;
            background: #f0fff4;
            border-color: #a9dfbf;
            cursor: default;
        }

        .detail-item.status-cancel {
            opacity: 0.45;
            background: #fdf2f2;
            border-color: #f5c6cb;
            text-decoration: line-through;
            cursor: default;
        }

    .detail-icon {
        font-size: 0.9rem;
        margin-right: 8px;
        flex-shrink: 0;
    }

    .detail-name {
        font-weight: 500;
        color: #1a1a1a;
        font-size: 0.88rem;
    }

    .detail-qty {
        color: #888;
        font-size: 0.8rem;
    }

    /* ── 套餐子項目 ── */
    .detail-item.is-setmeal {
        border-color: #e67e22;
        background: #fef9f0;
    }

    .setmeal-badge {
        font-size: 0.68rem;
        background: #e67e22;
        color: #fff;
        padding: 1px 6px;
        border-radius: 10px;
        margin-left: 6px;
        font-weight: 700;
        vertical-align: middle;
    }

    .child-item {
        margin-left: 12px;
        padding: 10px 14px;
        border-left: 4px solid #e67e22;
        border-radius: 0 10px 10px 0;
        background: #fef9f0;
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
        font-weight: 500;
        color: #555;
        cursor: pointer;
        transition: background 0.2s;
        min-height: 48px;
    }

        .child-item:hover {
            background: #fdebd0;
        }

        .child-item.status-done {
            opacity: 0.4;
            background: #f0fff4;
            border-color: #a9dfbf;
            text-decoration: line-through;
            cursor: default;
        }

        .child-item.status-cancel {
            opacity: 0.4;
            background: #fdf2f2;
            border-color: #f5c6cb;
            text-decoration: line-through;
            cursor: default;
        }

    .child-actions {
        display: none;
        gap: 10px;
        padding: 4px 4px 6px 20px;
        justify-content: flex-end;
        margin-top: 2px;
    }

        .child-actions.show {
            display: flex;
        }

    .btn-done-sm {
        padding: 9px 20px;
        background: #27ae60;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
        min-height: 44px;
    }

        .btn-done-sm:hover {
            background: #219a52;
        }

    .action-btns {
        display: none;
        gap: 8px;
        margin-top: 6px;
        padding: 0 4px 4px;
        justify-content: flex-end;
    }

        .action-btns.show {
            display: flex;
        }

    .btn-done {
        padding: 5px 12px;
        background: #27ae60;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-done:hover {
            background: #219a52;
        }

    .card-cancel-bar {
        display: none;
        padding: 8px 12px;
        border-top: 1px solid #fde8e8;
        background: #fff5f5;
    }

    .exp-card.card-selected .card-cancel-bar {
        display: block;
    }

    .btn-cancel-order {
        width: 100%;
        padding: 8px;
        background: #fff;
        color: #c0392b;
        border: 1.5px solid #c0392b;
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.15s;
    }

        .btn-cancel-order:hover {
            background: #c0392b;
            color: #fff;
        }

    .confirm-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .confirm-box {
        background: #fff;
        border-radius: 16px;
        padding: 32px 40px;
        text-align: center;
        box-shadow: 0 8px 32px rgba(0,0,0,0.2);
        min-width: 280px;
    }

        .confirm-box .confirm-icon {
            font-size: 2.5rem;
            margin-bottom: 12px;
        }

        .confirm-box .confirm-msg {
            font-size: 1rem;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 20px;
        }

        .confirm-box .confirm-btns {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .confirm-box .btn-confirm-yes {
            padding: 10px 28px;
            background: #c0392b;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
        }

            .confirm-box .btn-confirm-yes:hover {
                background: #a93226;
            }

        .confirm-box .btn-confirm-no {
            padding: 10px 28px;
            background: #fff;
            color: #555;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
        }

            .confirm-box .btn-confirm-no:hover {
                border-color: #aaa;
            }

    .btn-cancel {
        padding: 5px 12px;
        background: #fff;
        color: #e74c3c;
        border: 2px solid #e74c3c;
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-cancel:hover {
            background: #fdf2f2;
        }

    /* ════════════════════════════════
                           左側：其餘訂單 List（可捲動）
                        ════════════════════════════════ */
    .list-area {
        flex: 1;
        overflow-y: auto;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-width: 0;
    }

        .list-area::-webkit-scrollbar {
            width: 5px;
        }

        .list-area::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 4px;
        }

    .list-section-title {
        font-size: 0.78rem;
        font-weight: 700;
        color: #aaa;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 2px;
        flex-shrink: 0;
    }

    /* list 中每筆訂單 */
    .list-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e8e8e8;
        overflow: hidden;
        flex-shrink: 0;
        transition: box-shadow 0.2s;
    }

        .list-card:hover {
            box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        }

        .list-card.all-done {
            animation: fadeOut 0.6s forwards;
        }

    @@keyframes fadeOut {
        0% {
            opacity: 1;
            transform: scale(1);
        }

        100% {
            opacity: 0;
            transform: scale(0.95);
        }
    }

    .list-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        cursor: pointer;
        user-select: none;
    }

        .list-header:hover {
            background: #fafafa;
        }

    .list-header-left {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        flex: 1;
        min-width: 0;
    }

    .list-order-number {
        font-weight: 700;
        font-size: 0.9rem;
        color: #1a1a1a;
        white-space: nowrap;
    }

    .list-header-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .chevron {
        color: #bbb;
        font-size: 0.85rem;
        transition: transform 0.2s;
    }

    .list-card.list-expanded .chevron {
        transform: rotate(180deg);
    }

    .list-detail-area {
        display: none;
        padding: 0 14px 12px;
        border-top: 1px solid #f5f5f5;
    }

    .list-card.list-expanded .list-detail-area {
        display: block;
    }

    /* 空白狀態 */
    .empty-list {
        text-align: center;
        padding: 40px 20px;
        color: #aaa;
        font-size: 0.9rem;
    }

    .refresh-hint {
        font-size: 0.78rem;
        color: #ccc;
        text-align: center;
        flex-shrink: 0;
        padding-top: 4px;
    }
</style>

<div class="board">

    <!-- Header -->
    <div class="top-bar">
        <div class="page-title">🍽️ 待處理訂單</div>
        <span class="badge-count" id="totalBadge">共 @Model.Count 筆</span>
    </div>

    <!-- 主體 -->
    <div class="main-area">

        <!-- 右側：前3筆展開 -->
        <div class="expanded-area" id="expandedArea">
            @for (int i = 0; i < expanded.Count; i++)
            {
                var order = expanded[i];
                int pendingCount = order.Items.Count(x => x.Status == 0 && !x.ParentDetailId.HasValue);

                <div class="exp-card" id="card-@order.PreOrderId" data-preorder-id="@order.PreOrderId" data-pending="@pendingCount">
                    <div class="card-header" style="cursor:pointer;" onclick="toggleCardSelected(@order.PreOrderId, event)">
                        <div class="card-header-left">
                            <span class="card-order-number">@order.OrderNumber</span>
                            <div class="card-meta">
                                @if (order.InOrOut)
                                {
                                    <span class="table-badge">🪑 桌@(order.TableName)</span>
                                }
                                else
                                {
                                    <span class="table-badge takeout">🥡 外帶</span>
                                }
                                <span class="order-time">@order.OrderAt.ToString("HH:mm")</span>
                            </div>
                        </div>
                        @{
                            var badgeCls = pendingCount == 0 ? "pending-badge done" : "pending-badge";
                        }
                        <span class="@badgeCls" id="badge-@order.PreOrderId">
                            @(pendingCount == 0 ? "✅ 全部完成" : $"⏳ {pendingCount} 份")
                        </span>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(order.Note))
                        {
                            <div class="note-box">⚠️ @order.Note</div>
                        }
                        @{
                            var parentItems2 = order.Items.Where(i => !i.ParentDetailId.HasValue).ToList();
                        }
                        @foreach (var item in parentItems2)
                        {
                            string sc = item.Status == 1 ? "status-done" : item.Status == 2 ? "status-cancel" : "";
                            string icon = item.Status == 1 ? "✅" : item.Status == 2 ? "❌" : "⏳";
                            var childItems2 = order.Items.Where(c => c.ParentDetailId == item.DetailId).ToList();

                            if (item.IsSetMeal)
                            {
                                <div class="setmeal-group" id="smgroup-@item.DetailId">
                                    <div class="detail-item @sc is-setmeal"
                                         id="item-@item.DetailId"
                                         data-detail-id="@item.DetailId"
                                         data-status="@item.Status"
                                         data-preorder-id="@order.PreOrderId"
                                         onclick="selectSetMeal(this)">
                                        <span class="detail-icon" id="icon-@item.DetailId">@icon</span>
                                        <div>
                                            <div class="detail-name">
                                                @item.ProductName
                                                <span class="setmeal-badge">套餐</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="action-btns" id="actions-@item.DetailId">
                                        <button class="btn-cancel" onclick="cancelSetMeal(event, @item.DetailId, @order.PreOrderId)">✕ 取消套餐</button>
                                    </div>
                                    @foreach (var child in childItems2)
                                    {
                                        string csc = child.Status == 1 ? "status-done" : child.Status == 2 ? "status-cancel" : "";
                                        <div class="child-item @csc" id="item-@child.DetailId"
                                             data-detail-id="@child.DetailId"
                                             data-status="@child.Status"
                                             data-preorder-id="@order.PreOrderId"
                                             data-parent-id="@item.DetailId"
                                             onclick="selectChild(this)">
                                            <span id="child-icon-@child.DetailId">@(child.Status == 1 ? "✅" : child.Status == 2 ? "❌" : "•")</span>
                                            <span>@child.ProductName</span>
                                        </div>
                                        <div class="child-actions" id="child-actions-@child.DetailId">
                                            <button class="btn-done-sm" onclick="doneChild(event, @child.DetailId, @item.DetailId, @order.PreOrderId)">✓ 已完成</button>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="detail-item @sc"
                                     id="item-@item.DetailId"
                                     data-detail-id="@item.DetailId"
                                     data-status="@item.Status"
                                     data-preorder-id="@order.PreOrderId"
                                     onclick="selectItem(this)">
                                    <span class="detail-icon" id="icon-@item.DetailId">@icon</span>
                                    <div>
                                        <div class="detail-name">@item.ProductName</div>
                                        <div class="detail-qty">× @item.Qty 份</div>
                                    </div>
                                </div>
                                <div class="action-btns" id="actions-@item.DetailId">
                                    <button class="btn-cancel" onclick="updateStatus(event, @item.DetailId, 2, @order.PreOrderId)">✕ 取消</button>
                                    <button class="btn-done" onclick="updateStatus(event, @item.DetailId, 1, @order.PreOrderId)">✓ 已完成</button>
                                </div>
                            }
                        }
                    </div>
                    <div class="card-cancel-bar">
                        @if (canCancelOrder)
                        {
                            <button class="btn-cancel-order" onclick="cancelOrder(event, @order.PreOrderId)">✕ 整單取消</button>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- 左側：其餘訂單 List -->
        <div class="list-area" id="listArea">
            @if (!listed.Any())
            {
                <div class="empty-list">沒有其他訂單</div>
            }
            else
            {
                <div class="list-section-title">其他訂單（@listed.Count 筆）</div>

                @for (int i = 0; i < listed.Count; i++)
                {
                    var order = listed[i];
                    int pendingCount = order.Items.Count(x => x.Status == 0 && !x.ParentDetailId.HasValue);

                    <div class="list-card" id="lcard-@order.PreOrderId" data-preorder-id="@order.PreOrderId" data-pending="@pendingCount">
                        <div class="list-header" onclick="toggleListCard(@order.PreOrderId)">
                            <div class="list-header-left">
                                <span class="list-order-number">@order.OrderNumber</span>
                                @if (order.InOrOut)
                                {
                                    <span class="table-badge">🪑 桌@(order.TableName)</span>
                                }
                                else
                                {
                                    <span class="table-badge takeout">🥡 外帶</span>
                                }
                                <span class="order-time">@order.OrderAt.ToString("HH:mm")</span>
                            </div>
                            <div class="list-header-right">
                                @{
                                    var badgeCls2 = pendingCount == 0 ? "pending-badge done" : "pending-badge";
                                }
                                <span class="@badgeCls2" id="badge-@order.PreOrderId">
                                    @(pendingCount == 0 ? "✅ 全部完成" : $"⏳ {pendingCount} 份")
                                </span>
                                <span class="chevron">▼</span>
                            </div>
                        </div>
                        <div class="list-detail-area" id="list-details-@order.PreOrderId">
                            @if (!string.IsNullOrEmpty(order.Note))
                            {
                                <div class="note-box" style="margin-top:10px;">⚠️ @order.Note</div>
                            }
                            @{
                                var listParents = order.Items.Where(i => !i.ParentDetailId.HasValue).ToList();
                            }
                            @foreach (var item in listParents)
                            {
                                string sc = item.Status == 1 ? "status-done" : item.Status == 2 ? "status-cancel" : "";
                                string icon = item.Status == 1 ? "✅" : item.Status == 2 ? "❌" : "⏳";
                                var listChildren = order.Items.Where(c => c.ParentDetailId == item.DetailId).ToList();

                                if (item.IsSetMeal)
                                {
                                    <div class="setmeal-group" id="smgroup-@item.DetailId">
                                        <div class="detail-item @sc is-setmeal"
                                             id="item-@item.DetailId"
                                             data-detail-id="@item.DetailId"
                                             data-status="@item.Status"
                                             data-preorder-id="@order.PreOrderId"
                                             onclick="selectSetMeal(this)">
                                            <span class="detail-icon" id="icon-@item.DetailId">@icon</span>
                                            <div>
                                                <div class="detail-name">
                                                    @item.ProductName
                                                    <span class="setmeal-badge">套餐</span>
                                                </div>
                                                </div>
                                        </div>
                                        <div class="action-btns" id="actions-@item.DetailId">
                                            <button class="btn-cancel" onclick="cancelSetMeal(event, @item.DetailId, @order.PreOrderId)">✕ 取消套餐</button>
                                        </div>
                                        @foreach (var child in listChildren)
                                        {
                                            string csc = child.Status == 1 ? "status-done" : child.Status == 2 ? "status-cancel" : "";
                                            <div class="child-item @csc" id="item-@child.DetailId"
                                                 data-detail-id="@child.DetailId"
                                                 data-status="@child.Status"
                                                 data-preorder-id="@order.PreOrderId"
                                                 data-parent-id="@item.DetailId"
                                                 onclick="selectChild(this)">
                                                <span id="child-icon-@child.DetailId">@(child.Status == 1 ? "✅" : child.Status == 2 ? "❌" : "•")</span>
                                                <span>@child.ProductName</span>
                                            </div>
                                            <div class="child-actions" id="child-actions-@child.DetailId">
                                                <button class="btn-done-sm" onclick="doneChild(event, @child.DetailId, @item.DetailId, @order.PreOrderId)">✓ 已完成</button>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="detail-item @sc"
                                         id="item-@item.DetailId"
                                         data-detail-id="@item.DetailId"
                                         data-status="@item.Status"
                                         data-preorder-id="@order.PreOrderId"
                                         onclick="selectItem(this)">
                                        <span class="detail-icon" id="icon-@item.DetailId">@icon</span>
                                        <div>
                                            <div class="detail-name">@item.ProductName</div>
                                        </div>
                                    </div>
                                    <div class="action-btns" id="actions-@item.DetailId">
                                        <button class="btn-cancel" onclick="updateStatus(event, @item.DetailId, 2, @order.PreOrderId)">✕ 取消</button>
                                        <button class="btn-done" onclick="updateStatus(event, @item.DetailId, 1, @order.PreOrderId)">✓ 已完成</button>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            }
            <div class="refresh-hint">頁面每 10 秒自動重新整理</div>
        </div>

    </div>
</div>

<!-- 確認框 -->
<div class="confirm-overlay" id="confirmOverlay" style="display:none;">
    <div class="confirm-box">
        <div class="confirm-icon">⚠️</div>
        <div class="confirm-msg">確定要取消整筆訂單嗎？<br>所有餐點（包含已完成）都會取消。</div>
        <div class="confirm-btns">
            <button class="btn-confirm-yes" id="confirmYes">確認取消</button>
            <button class="btn-confirm-no" onclick="closeConfirm()">返回</button>
        </div>
    </div>
</div>
@Html.AntiForgeryToken()

<script>
    let selectedDetailId = null;  // 目前選取的一般餐點
    let selectedChildId = null;   // 目前選取的套餐子項目
    let selectedSetMealId = null; // 目前選取的套餐標題

    function toggleListCard(preOrderId) {
        const card = document.getElementById('lcard-' + preOrderId);
        card.classList.toggle('list-expanded');
    }

    // ── 一般餐點（取消 + 完成）──
    function selectItem(el) {
        const detailId = el.dataset.detailId;
        const status = parseInt(el.dataset.status);
        if (status === 1 || status === 2) return;

        if (selectedChildId) { hideChildActions(selectedChildId); selectedChildId = null; }
        if (selectedSetMealId) { hideActions(selectedSetMealId); selectedSetMealId = null; }

        if (selectedDetailId === detailId) {
            hideActions(detailId);
            selectedDetailId = null;
            return;
        }
        if (selectedDetailId) hideActions(selectedDetailId);
        selectedDetailId = detailId;

        const actions = document.getElementById('actions-' + detailId);
        actions.classList.add('show');
        setTimeout(() => actions.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 100);
    }

    // ── 套餐標題（只取消）──
    function selectSetMeal(el) {
        const detailId = el.dataset.detailId;
        const status = parseInt(el.dataset.status);
        if (status === 1 || status === 2) return;

        if (selectedDetailId) { hideActions(selectedDetailId); selectedDetailId = null; }
        if (selectedChildId) { hideChildActions(selectedChildId); selectedChildId = null; }

        if (selectedSetMealId === detailId) {
            hideActions(detailId);
            selectedSetMealId = null;
            return;
        }
        if (selectedSetMealId) hideActions(selectedSetMealId);
        selectedSetMealId = detailId;

        const actions = document.getElementById('actions-' + detailId);
        actions.classList.add('show');
        setTimeout(() => actions.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 100);
    }

    // ── 套餐子項目（只完成）──
    function selectChild(el) {
        const detailId = el.dataset.detailId;
        const status = parseInt(el.dataset.status);
        if (status === 1 || status === 2) return;

        if (selectedDetailId) { hideActions(selectedDetailId); selectedDetailId = null; }
        if (selectedSetMealId) { hideActions(selectedSetMealId); selectedSetMealId = null; }

        if (selectedChildId === detailId) {
            hideChildActions(detailId);
            selectedChildId = null;
            return;
        }
        if (selectedChildId) hideChildActions(selectedChildId);
        selectedChildId = detailId;

        const actions = document.getElementById('child-actions-' + detailId);
        actions.classList.add('show');
        setTimeout(() => actions.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 100);
    }

    function hideActions(detailId) {
        const el = document.getElementById('actions-' + detailId);
        if (el) el.classList.remove('show');
    }

    function hideChildActions(detailId) {
        const el = document.getElementById('child-actions-' + detailId);
        if (el) el.classList.remove('show');
    }

    // ── 一般餐點更新狀態 ──
    async function updateStatus(event, detailId, status, preOrderId) {
        event.stopPropagation();
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const res = await fetch('/PreOrders/UpdateDetailStatus', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token ?? '' },
            body: `detailId=${detailId}&status=${status}`
        });
        const data = await res.json();
        if (!data.success) return;

        const item = document.getElementById('item-' + detailId);
        item.dataset.status = status;

        if (status === 1) {
            item.classList.remove('status-cancel');
            item.classList.add('status-done');
            document.getElementById('icon-' + detailId).textContent = '✅';
        } else {
            item.classList.remove('status-done');
            item.classList.add('status-cancel');
            document.getElementById('icon-' + detailId).textContent = '❌';
        }

        const detailArea = item.closest('.card-body, .list-detail-area');
        const actionDiv = document.getElementById('actions-' + detailId);
        detailArea.appendChild(item);
        detailArea.appendChild(actionDiv);

        hideActions(detailId);
        selectedDetailId = null;
        updatePendingCount(preOrderId);
    }

    // ── 取消整個套餐（標題 + 所有子項目）──
    async function cancelSetMeal(event, setMealDetailId, preOrderId) {
        event.stopPropagation();
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const area = document.getElementById('item-' + setMealDetailId).closest('.card-body, .list-detail-area');
        const children = area.querySelectorAll('.child-item[data-parent-id="' + setMealDetailId + '"]');

        for (const child of children) {
            const childId = child.dataset.detailId;
            await fetch('/PreOrders/UpdateDetailStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token ?? '' },
                body: `detailId=${childId}&status=2`
            });
            child.dataset.status = 2;
            child.classList.remove('status-done');
            child.classList.add('status-cancel');
            const icon = document.getElementById('child-icon-' + childId);
            if (icon) icon.textContent = '❌';
        }

        await fetch('/PreOrders/UpdateDetailStatus', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token ?? '' },
            body: `detailId=${setMealDetailId}&status=2`
        });
        const headerEl = document.getElementById('item-' + setMealDetailId);
        headerEl.dataset.status = 2;
        headerEl.classList.remove('status-done');
        headerEl.classList.add('status-cancel');
        document.getElementById('icon-' + setMealDetailId).textContent = '❌';

        hideActions(setMealDetailId);
        selectedSetMealId = null;

        const group = document.getElementById('smgroup-' + setMealDetailId);
        if (group) area.appendChild(group);

        updatePendingCount(preOrderId);
    }

    // ── 套餐子項目完成 ──
    async function doneChild(event, childDetailId, setMealDetailId, preOrderId) {
        event.stopPropagation();
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const res = await fetch('/PreOrders/UpdateDetailStatus', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token ?? '' },
            body: `detailId=${childDetailId}&status=1`
        });
        const data = await res.json();
        if (!data.success) return;

        const child = document.getElementById('item-' + childDetailId);
        child.dataset.status = 1;
        child.classList.remove('status-cancel');
        child.classList.add('status-done');
        const icon = document.getElementById('child-icon-' + childDetailId);
        if (icon) icon.textContent = '✅';

        hideChildActions(childDetailId);
        selectedChildId = null;

        // 檢查此套餐的所有子項目是否都完成
        const area = child.closest('.card-body, .list-detail-area');
        const allChildren = area.querySelectorAll('.child-item[data-parent-id="' + setMealDetailId + '"]');
        const allDone = [...allChildren].every(c => parseInt(c.dataset.status) === 1);

        if (allDone) {
            await fetch('/PreOrders/UpdateDetailStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token ?? '' },
                body: `detailId=${setMealDetailId}&status=1`
            });
            const headerEl = document.getElementById('item-' + setMealDetailId);
            headerEl.dataset.status = 1;
            headerEl.classList.remove('status-cancel');
            headerEl.classList.add('status-done');
            document.getElementById('icon-' + setMealDetailId).textContent = '✅';

            // 整組移到最下面
            const group = document.getElementById('smgroup-' + setMealDetailId);
            if (group) area.appendChild(group);
        }

        updatePendingCount(preOrderId);
    }

    function updatePendingCount(preOrderId) {
        const card = document.getElementById('card-' + preOrderId)
                  || document.getElementById('lcard-' + preOrderId);
        // 計算所有頂層餐點（一般餐點 + 套餐標題）的待處理數量
        const items = card.querySelectorAll('.detail-item');
        let pending = 0;
        items.forEach(item => { if (parseInt(item.dataset.status) === 0) pending++; });

        const badge = document.getElementById('badge-' + preOrderId);
        card.dataset.pending = pending;

        if (pending === 0) {
            badge.textContent = '✅ 全部完成';
            badge.classList.add('done');
            setTimeout(() => {
                card.classList.add('all-done');
                setTimeout(() => {
                    card.remove();
                    updateTotalBadge();
                    const expCards = document.querySelectorAll('.exp-card');
                    if (expCards.length < 3 && document.querySelector('.list-card')) {
                        location.reload();
                    }
                }, 300);
            }, 400);
        } else {
            badge.textContent = `⏳ ${pending} 份`;
            badge.classList.remove('done');
        }
    }

    function updateTotalBadge() {
        const remaining = document.querySelectorAll('.exp-card, .list-card').length;
        document.getElementById('totalBadge').textContent = `共 ${remaining} 筆`;
    }

    let selectedCardId = null;
    let pendingCancelId = null;

    function toggleCardSelected(preOrderId, event) {
        if (event.target.closest('.detail-item, .action-btns, .btn-cancel-order, .child-item, .child-actions')) return;
        const card = document.getElementById('card-' + preOrderId);
        if (!card) return;
        if (selectedCardId && selectedCardId !== preOrderId)
            document.getElementById('card-' + selectedCardId)?.classList.remove('card-selected');
        card.classList.toggle('card-selected');
        selectedCardId = card.classList.contains('card-selected') ? preOrderId : null;
    }

    function cancelOrder(event, preOrderId) {
        event.stopPropagation();
        pendingCancelId = preOrderId;
        document.getElementById('confirmOverlay').style.display = 'flex';
        document.getElementById('confirmYes').onclick = confirmCancel;
    }

    function closeConfirm() {
        document.getElementById('confirmOverlay').style.display = 'none';
        pendingCancelId = null;
    }

    async function confirmCancel() {
        if (!pendingCancelId) return;
        const preOrderId = pendingCancelId;
        closeConfirm();

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const res = await fetch('/PreOrders/CancelOrder', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token ?? '' },
            body: `preOrderId=${preOrderId}`
        });
        const data = await res.json();
        if (!data.success) return;

        const card = document.getElementById('card-' + preOrderId)
                  || document.getElementById('lcard-' + preOrderId);
        if (!card) return;

        card.querySelectorAll('.detail-item').forEach(item => {
            item.dataset.status = 2;
            item.classList.remove('status-done');
            item.classList.add('status-cancel');
            const icon = document.getElementById('icon-' + item.dataset.detailId);
            if (icon) icon.textContent = '❌';
        });
        card.querySelectorAll('.child-item').forEach(child => {
            child.dataset.status = 2;
            child.classList.remove('status-done');
            child.classList.add('status-cancel');
            const icon = document.getElementById('child-icon-' + child.dataset.detailId);
            if (icon) icon.textContent = '❌';
        });

        card.classList.remove('card-selected');
        setTimeout(() => {
            card.classList.add('all-done');
            setTimeout(() => {
                card.remove();
                updateTotalBadge();
                const expCards = document.querySelectorAll('.exp-card');
                if (expCards.length < 3 && document.querySelector('.list-card')) {
                    location.reload();
                }
            }, 600);
        }, 600);
    }

    function promoteListCard() {
        const expandedArea = document.getElementById('expandedArea');
        const expCards = expandedArea.querySelectorAll('.exp-card');
        if (expCards.length >= 3) return;
        const listArea = document.getElementById('listArea');
        const firstListCard = listArea.querySelector('.list-card');
        if (!firstListCard) return;
        location.reload();
    }

    let lastCount = @Model.Count;

    setInterval(async () => {
        try {
            const res = await fetch('/PreOrders/PendingCount');
            const data = await res.json();
            if (data.count !== lastCount) location.reload();
        } catch {}
    }, 3000);

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.card-body, .list-detail-area').forEach(area => {
            // 一般餐點：已完成/取消移到最下面
            const done = [...area.querySelectorAll('.detail-item:not(.is-setmeal).status-done, .detail-item:not(.is-setmeal).status-cancel')];
            done.forEach(item => {
                const actionDiv = document.getElementById('actions-' + item.dataset.detailId);
                area.appendChild(item);
                if (actionDiv) area.appendChild(actionDiv);
            });
            // 套餐群組：全部完成或取消的移到最下面
            const doneGroups = [...area.querySelectorAll('.setmeal-group')].filter(g => {
                const header = g.querySelector('.detail-item.is-setmeal');
                return header && (header.classList.contains('status-done') || header.classList.contains('status-cancel'));
            });
            doneGroups.forEach(g => area.appendChild(g));
        });
    });
</script>
